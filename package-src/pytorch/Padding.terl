/**
 * Constant and named-mode tensor padding.
 */
module pytorch.Padding.

import pytorch.PaddingNative.{constant_pad_configured, constant_pad_configured_out, pad_with_value, pad_without_value}.

import type pytorch.Tensor.

/**
 * Pads tensor dimensions with an integer scalar value.
 */
pub constant_pad(input: Tensor, padding: List[Int], value: Int = 0): Tensor ->
    constant_pad_configured(input, padding, true, value, 0.0).

/**
 * Pads tensor dimensions with a floating-point scalar value.
 */
pub constant_pad_float(input: Tensor, padding: List[Int], value: Float): Tensor ->
    constant_pad_configured(input, padding, false, 0, value).

/**
 * Writes integer-valued constant padding into retained output storage.
 */
pub constant_pad_out(output: Tensor, input: Tensor, padding: List[Int], value: Int = 0): Unit ->
    constant_pad_configured_out(output, input, padding, true, value, 0.0).

/**
 * Writes floating-valued constant padding into retained output storage.
 */
pub constant_pad_float_out(output: Tensor, input: Tensor, padding: List[Int], value: Float): Unit ->
    constant_pad_configured_out(output, input, padding, false, 0, value).

/**
 * Pads through a named mode while preserving an absent optional value.
 */
pub pad(input: Tensor, padding: List[Int], mode: String = "constant"): Tensor ->
    pad_without_value(input, padding, mode).

/**
 * Pads through a named mode with an explicit floating-point value.
 */
pub pad(input: Tensor, padding: List[Int], mode: String, value: Float): Tensor ->
    pad_with_value(input, padding, mode, value).
