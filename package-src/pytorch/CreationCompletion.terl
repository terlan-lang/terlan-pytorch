/**
 * Exact dense empty, full, ones, and zeros creation families.
 */
module pytorch.CreationCompletion.

import pytorch.CreationCompletionNative.{create_configured, create_out, like_configured, like_out}.

import type pytorch.Tensor.

/**
 * Creates a tensor with exact optional creation arguments and an integer fill scalar.
 */
pub configured(
    operation: Int,
    shape: List[Int],
    fill: Int,
    dtype: Int,
    has_dtype: Bool,
    layout: Int,
    has_layout: Bool,
    device_type: Int,
    device_index: Int,
    has_device: Bool,
    pin_memory: Bool,
    has_pin_memory: Bool,
    memory_format: Int,
    has_memory_format: Bool,
): Tensor ->
    create_configured(
        operation,
        shape,
        true,
        fill,
        0.0,
        dtype,
        has_dtype,
        layout,
        has_layout,
        device_type,
        device_index,
        has_device,
        pin_memory,
        has_pin_memory,
        memory_format,
        has_memory_format,
    ).

/**
 * Creates a tensor with exact optional creation arguments and a floating fill scalar.
 */
pub configured_float(
    operation: Int,
    shape: List[Int],
    fill: Float,
    dtype: Int,
    has_dtype: Bool,
    layout: Int,
    has_layout: Bool,
    device_type: Int,
    device_index: Int,
    has_device: Bool,
    pin_memory: Bool,
    has_pin_memory: Bool,
    memory_format: Int,
    has_memory_format: Bool,
): Tensor ->
    create_configured(
        operation,
        shape,
        false,
        0,
        fill,
        dtype,
        has_dtype,
        layout,
        has_layout,
        device_type,
        device_index,
        has_device,
        pin_memory,
        has_pin_memory,
        memory_format,
        has_memory_format,
    ).

/**
 * Creates an uninitialized tensor using PyTorch defaults.
 */
pub empty(shape: List[Int]): Tensor ->
    configured(0, shape, 0, 0, false, 0, false, 0, -1, false, false, false, 0, false).

/**
 * Creates an uninitialized tensor with exact optional arguments.
 */
pub empty_configured(
    shape: List[Int],
    dtype: Int,
    has_dtype: Bool,
    layout: Int,
    has_layout: Bool,
    device_type: Int,
    device_index: Int,
    has_device: Bool,
    pin_memory: Bool,
    has_pin_memory: Bool,
    memory_format: Int,
    has_memory_format: Bool,
): Tensor ->
    configured(
        0,
        shape,
        0,
        dtype,
        has_dtype,
        layout,
        has_layout,
        device_type,
        device_index,
        has_device,
        pin_memory,
        has_pin_memory,
        memory_format,
        has_memory_format,
    ).

/**
 * Writes an uninitialized tensor into retained storage.
 */
pub empty_out(
    output: Tensor,
    shape: List[Int],
    memory_format: Int = 0,
    has_memory_format: Bool = false,
): Unit ->
    create_out(output, 0, shape, true, 0, 0.0, memory_format, has_memory_format).

/**
 * Creates an integer-filled tensor using PyTorch dtype inference.
 */
pub full(shape: List[Int], fill: Int): Tensor ->
    configured(1, shape, fill, 0, false, 0, false, 0, -1, false, false, false, 0, false).

/**
 * Creates a floating-filled tensor using PyTorch dtype inference.
 */
pub full_float(shape: List[Int], fill: Float): Tensor ->
    configured_float(1, shape, fill, 0, false, 0, false, 0, -1, false, false, false, 0, false).

/**
 * Writes a full tensor into retained storage.
 */
pub full_out(output: Tensor, shape: List[Int], fill: Int): Unit ->
    create_out(output, 1, shape, true, fill, 0.0, 0, false).

/**
 * Writes a floating-full tensor into retained storage.
 */
pub full_float_out(output: Tensor, shape: List[Int], fill: Float): Unit ->
    create_out(output, 1, shape, false, 0, fill, 0, false).

/**
 * Creates a tensor of ones using PyTorch defaults.
 */
pub ones(shape: List[Int]): Tensor ->
    configured(2, shape, 0, 0, false, 0, false, 0, -1, false, false, false, 0, false).

/**
 * Writes a tensor of ones into retained storage.
 */
pub ones_out(output: Tensor, shape: List[Int]): Unit ->
    create_out(output, 2, shape, true, 0, 0.0, 0, false).

/**
 * Creates a tensor of zeros using PyTorch defaults.
 */
pub zeros(shape: List[Int]): Tensor ->
    configured(3, shape, 0, 0, false, 0, false, 0, -1, false, false, false, 0, false).

/**
 * Writes a tensor of zeros into retained storage.
 */
pub zeros_out(output: Tensor, shape: List[Int]): Unit ->
    create_out(output, 3, shape, true, 0, 0.0, 0, false).

/**
 * Creates an uninitialized tensor like the input using inherited options.
 */
pub empty_like(input: Tensor): Tensor ->
    like_configured(
        input,
        0,
        true,
        0,
        0.0,
        0,
        false,
        0,
        false,
        0,
        -1,
        false,
        false,
        false,
        0,
        false,
    ).

/**
 * Creates a tensor like the input with exact optional arguments and an integer fill scalar.
 */
pub like_configured_int(
    input: Tensor,
    operation: Int,
    fill: Int,
    dtype: Int,
    has_dtype: Bool,
    layout: Int,
    has_layout: Bool,
    device_type: Int,
    device_index: Int,
    has_device: Bool,
    pin_memory: Bool,
    has_pin_memory: Bool,
    memory_format: Int,
    has_memory_format: Bool,
): Tensor ->
    like_configured(
        input,
        operation,
        true,
        fill,
        0.0,
        dtype,
        has_dtype,
        layout,
        has_layout,
        device_type,
        device_index,
        has_device,
        pin_memory,
        has_pin_memory,
        memory_format,
        has_memory_format,
    ).

/**
 * Creates a tensor like the input with exact optional arguments and a floating fill scalar.
 */
pub like_configured_float(
    input: Tensor,
    operation: Int,
    fill: Float,
    dtype: Int,
    has_dtype: Bool,
    layout: Int,
    has_layout: Bool,
    device_type: Int,
    device_index: Int,
    has_device: Bool,
    pin_memory: Bool,
    has_pin_memory: Bool,
    memory_format: Int,
    has_memory_format: Bool,
): Tensor ->
    like_configured(
        input,
        operation,
        false,
        0,
        fill,
        dtype,
        has_dtype,
        layout,
        has_layout,
        device_type,
        device_index,
        has_device,
        pin_memory,
        has_pin_memory,
        memory_format,
        has_memory_format,
    ).

/**
 * Writes an uninitialized like-result into retained storage.
 */
pub empty_like_out(
    output: Tensor,
    input: Tensor,
    memory_format: Int = 0,
    has_memory_format: Bool = false,
): Unit ->
    like_out(output, input, 0, true, 0, 0.0, memory_format, has_memory_format).

/**
 * Creates an integer-filled tensor like the input.
 */
pub full_like(input: Tensor, fill: Int): Tensor ->
    like_configured_int(input, 1, fill, 0, false, 0, false, 0, -1, false, false, false, 0, false).

/**
 * Creates a floating-filled tensor like the input.
 */
pub full_like_float(input: Tensor, fill: Float): Tensor ->
    like_configured_float(input, 1, fill, 0, false, 0, false, 0, -1, false, false, false, 0, false).

/**
 * Writes an integer-full like-result into retained storage.
 */
pub full_like_out(
    output: Tensor,
    input: Tensor,
    fill: Int,
    memory_format: Int = 0,
    has_memory_format: Bool = false,
): Unit ->
    like_out(output, input, 1, true, fill, 0.0, memory_format, has_memory_format).

/**
 * Writes a floating-full like-result into retained storage.
 */
pub full_like_float_out(
    output: Tensor,
    input: Tensor,
    fill: Float,
    memory_format: Int = 0,
    has_memory_format: Bool = false,
): Unit ->
    like_out(output, input, 1, false, 0, fill, memory_format, has_memory_format).

/**
 * Creates a tensor of ones like the input.
 */
pub ones_like(input: Tensor): Tensor ->
    like_configured_int(input, 2, 0, 0, false, 0, false, 0, -1, false, false, false, 0, false).

/**
 * Writes a ones-like result into retained storage.
 */
pub ones_like_out(
    output: Tensor,
    input: Tensor,
    memory_format: Int = 0,
    has_memory_format: Bool = false,
): Unit ->
    like_out(output, input, 2, true, 0, 0.0, memory_format, has_memory_format).

/**
 * Creates a tensor of zeros like the input.
 */
pub zeros_like(input: Tensor): Tensor ->
    like_configured_int(input, 3, 0, 0, false, 0, false, 0, -1, false, false, false, 0, false).

/**
 * Writes a zeros-like result into retained storage.
 */
pub zeros_like_out(
    output: Tensor,
    input: Tensor,
    memory_format: Int = 0,
    has_memory_format: Bool = false,
): Unit ->
    like_out(output, input, 3, true, 0, 0.0, memory_format, has_memory_format).
