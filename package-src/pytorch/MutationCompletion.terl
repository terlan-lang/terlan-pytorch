/**
 * Typed in-place compatibility wrappers for scalar mutation schemas.
 */
module pytorch.MutationCompletion.

import pytorch.ActivationCompletion.{threshold_float, threshold_int}.
import pytorch.Linalg.linalg_solve.
import pytorch.Statistics.renorm.
import pytorch.Tensor.{copy_in_place, dispose}.
import pytorch.View.detach.

import type pytorch.Tensor.

/**
 * Applies integer thresholding while retaining the caller's tensor handle.
 */
pub threshold_in_place_int(input: Tensor, threshold: Int, value: Int): Unit ->
    let result = threshold_int(input, threshold, value);
    copy_in_place(input, result, false);
    dispose(result).

/**
 * Applies floating thresholding while retaining the caller's tensor handle.
 */
pub threshold_in_place_float(input: Tensor, threshold: Float, value: Float): Unit ->
    let result = threshold_float(input, threshold, value);
    copy_in_place(input, result, false);
    dispose(result).

/**
 * Applies bounded renormalization while retaining the caller's tensor handle.
 */
pub renorm_in_place(input: Tensor, order: Float, dimension: Int, maximum_norm: Float): Unit ->
    let result = renorm(input, order, dimension, maximum_norm);
    copy_in_place(input, result, false);
    dispose(result).

/**
 * Preserves the deprecated Tensor.solve receiver ordering: self is the
 * right-hand side and the explicit argument is the coefficient matrix.
 */
pub solve_legacy(right: Tensor, coefficient: Tensor): Tensor ->
    linalg_solve(coefficient, right).

/**
 * Preserves Tensor.module_load's assign branch and detached return contract.
 */
pub module_load_legacy(input: Tensor, other: Tensor, assign: Bool = false): Tensor ->
    if {
        assign -> detach(other);
        true -> copy_and_detach(input, other)
    }.

copy_and_detach(input: Tensor, other: Tensor): Tensor ->
    copy_in_place(input, other, false);
    detach(input).
