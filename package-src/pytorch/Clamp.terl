/**
 * Typed scalar and tensor clamp operations with functional, output, and in-place storage contracts.
 */
module pytorch.Clamp.

import pytorch.ClampNative.{clamp_scalar, clamp_scalar_in_place, clamp_scalar_out, clamp_tensor as native_clamp_tensor, clamp_tensor_in_place as native_clamp_tensor_in_place, clamp_tensor_out as native_clamp_tensor_out}.

import type pytorch.Tensor.

/**
 * Top-level `torch.clip` alias using the common floating-point bounds contract.
 */
pub clip(input: Tensor, minimum: Float, maximum: Float): Tensor ->
    clip_float(input, minimum, maximum).

/**
 * Top-level `torch.clip_` alias using the common floating-point bounds contract.
 */
pub clip_in_place(input: Tensor, minimum: Float, maximum: Float): Unit ->
    clip_float_in_place(input, minimum, maximum).

/**
 * Top-level `torch.clamp_` alias using the common floating-point bounds contract.
 */
pub clamp_in_place(input: Tensor, minimum: Float, maximum: Float): Unit ->
    clamp_float_in_place(input, minimum, maximum).

/**
 * Clamps a tensor with integer minimum and maximum bounds.
 */
pub clamp_int(input: Tensor, minimum: Int, maximum: Int): Tensor ->
    clamp_scalar(input, true, true, minimum, 0.0, true, true, maximum, 0.0).

/**
 * Writes a clamp with integer minimum and maximum bounds into retained output storage.
 */
pub clamp_int_out(output: Tensor, input: Tensor, minimum: Int, maximum: Int): Unit ->
    clamp_scalar_out(output, input, true, true, minimum, 0.0, true, true, maximum, 0.0).

/**
 * Clamps tensor storage in place with integer minimum and maximum bounds.
 */
pub clamp_int_in_place(input: Tensor, minimum: Int, maximum: Int): Unit ->
    clamp_scalar_in_place(input, true, true, minimum, 0.0, true, true, maximum, 0.0).

/**
 * Clamps a tensor with floating-point minimum and maximum bounds.
 */
pub clamp_float(input: Tensor, minimum: Float, maximum: Float): Tensor ->
    clamp_scalar(input, true, false, 0, minimum, true, false, 0, maximum).

/**
 * Writes a clamp with floating-point minimum and maximum bounds into retained output storage.
 */
pub clamp_float_out(output: Tensor, input: Tensor, minimum: Float, maximum: Float): Unit ->
    clamp_scalar_out(output, input, true, false, 0, minimum, true, false, 0, maximum).

/**
 * Clamps tensor storage in place with floating-point minimum and maximum bounds.
 */
pub clamp_float_in_place(input: Tensor, minimum: Float, maximum: Float): Unit ->
    clamp_scalar_in_place(input, true, false, 0, minimum, true, false, 0, maximum).

/**
 * Clamps a tensor with integer minimum and floating-point maximum bounds.
 */
pub clamp_int_float(input: Tensor, minimum: Int, maximum: Float): Tensor ->
    clamp_scalar(input, true, true, minimum, 0.0, true, false, 0, maximum).

/**
 * Writes a clamp with integer minimum and floating-point maximum bounds into retained output storage.
 */
pub clamp_int_float_out(output: Tensor, input: Tensor, minimum: Int, maximum: Float): Unit ->
    clamp_scalar_out(output, input, true, true, minimum, 0.0, true, false, 0, maximum).

/**
 * Clamps tensor storage in place with integer minimum and floating-point maximum bounds.
 */
pub clamp_int_float_in_place(input: Tensor, minimum: Int, maximum: Float): Unit ->
    clamp_scalar_in_place(input, true, true, minimum, 0.0, true, false, 0, maximum).

/**
 * Clamps a tensor with floating-point minimum and integer maximum bounds.
 */
pub clamp_float_int(input: Tensor, minimum: Float, maximum: Int): Tensor ->
    clamp_scalar(input, true, false, 0, minimum, true, true, maximum, 0.0).

/**
 * Writes a clamp with floating-point minimum and integer maximum bounds into retained output storage.
 */
pub clamp_float_int_out(output: Tensor, input: Tensor, minimum: Float, maximum: Int): Unit ->
    clamp_scalar_out(output, input, true, false, 0, minimum, true, true, maximum, 0.0).

/**
 * Clamps tensor storage in place with floating-point minimum and integer maximum bounds.
 */
pub clamp_float_int_in_place(input: Tensor, minimum: Float, maximum: Int): Unit ->
    clamp_scalar_in_place(input, true, false, 0, minimum, true, true, maximum, 0.0).

/**
 * Clamps a tensor with an integer minimum bound.
 */
pub clamp_min_int(input: Tensor, minimum: Int): Tensor ->
    clamp_scalar(input, true, true, minimum, 0.0, false, true, 0, 0.0).

/**
 * Writes a clamp with an integer minimum bound into retained output storage.
 */
pub clamp_min_int_out(output: Tensor, input: Tensor, minimum: Int): Unit ->
    clamp_scalar_out(output, input, true, true, minimum, 0.0, false, true, 0, 0.0).

/**
 * Clamps tensor storage in place with an integer minimum bound.
 */
pub clamp_min_int_in_place(input: Tensor, minimum: Int): Unit ->
    clamp_scalar_in_place(input, true, true, minimum, 0.0, false, true, 0, 0.0).

/**
 * Clamps a tensor with a floating-point minimum bound.
 */
pub clamp_min_float(input: Tensor, minimum: Float): Tensor ->
    clamp_scalar(input, true, false, 0, minimum, false, true, 0, 0.0).

/**
 * Writes a clamp with a floating-point minimum bound into retained output storage.
 */
pub clamp_min_float_out(output: Tensor, input: Tensor, minimum: Float): Unit ->
    clamp_scalar_out(output, input, true, false, 0, minimum, false, true, 0, 0.0).

/**
 * Clamps tensor storage in place with a floating-point minimum bound.
 */
pub clamp_min_float_in_place(input: Tensor, minimum: Float): Unit ->
    clamp_scalar_in_place(input, true, false, 0, minimum, false, true, 0, 0.0).

/**
 * Clamps a tensor with an integer maximum bound.
 */
pub clamp_max_int(input: Tensor, maximum: Int): Tensor ->
    clamp_scalar(input, false, true, 0, 0.0, true, true, maximum, 0.0).

/**
 * Writes a clamp with an integer maximum bound into retained output storage.
 */
pub clamp_max_int_out(output: Tensor, input: Tensor, maximum: Int): Unit ->
    clamp_scalar_out(output, input, false, true, 0, 0.0, true, true, maximum, 0.0).

/**
 * Clamps tensor storage in place with an integer maximum bound.
 */
pub clamp_max_int_in_place(input: Tensor, maximum: Int): Unit ->
    clamp_scalar_in_place(input, false, true, 0, 0.0, true, true, maximum, 0.0).

/**
 * Clamps a tensor with a floating-point maximum bound.
 */
pub clamp_max_float(input: Tensor, maximum: Float): Tensor ->
    clamp_scalar(input, false, true, 0, 0.0, true, false, 0, maximum).

/**
 * Writes a clamp with a floating-point maximum bound into retained output storage.
 */
pub clamp_max_float_out(output: Tensor, input: Tensor, maximum: Float): Unit ->
    clamp_scalar_out(output, input, false, true, 0, 0.0, true, false, 0, maximum).

/**
 * Clamps tensor storage in place with a floating-point maximum bound.
 */
pub clamp_max_float_in_place(input: Tensor, maximum: Float): Unit ->
    clamp_scalar_in_place(input, false, true, 0, 0.0, true, false, 0, maximum).

/**
 * Clamps a tensor with minimum and maximum tensors.
 */
pub clamp_tensor(input: Tensor, minimum: Tensor, maximum: Tensor): Tensor ->
    native_clamp_tensor(input, 2, minimum, maximum).

/**
 * Writes a clamp with minimum and maximum tensors into retained output storage.
 */
pub clamp_tensor_out(output: Tensor, input: Tensor, minimum: Tensor, maximum: Tensor): Unit ->
    native_clamp_tensor_out(output, input, 2, minimum, maximum).

/**
 * Clamps tensor storage in place with minimum and maximum tensors.
 */
pub clamp_tensor_in_place(input: Tensor, minimum: Tensor, maximum: Tensor): Unit ->
    native_clamp_tensor_in_place(input, 2, minimum, maximum).

/**
 * Clamps a tensor with a minimum tensor.
 */
pub clamp_tensor_min(input: Tensor, minimum: Tensor): Tensor ->
    native_clamp_tensor(input, 0, minimum, minimum).

/**
 * Writes a clamp with a minimum tensor into retained output storage.
 */
pub clamp_tensor_min_out(output: Tensor, input: Tensor, minimum: Tensor): Unit ->
    native_clamp_tensor_out(output, input, 0, minimum, minimum).

/**
 * Clamps tensor storage in place with a minimum tensor.
 */
pub clamp_tensor_min_in_place(input: Tensor, minimum: Tensor): Unit ->
    native_clamp_tensor_in_place(input, 0, minimum, minimum).

/**
 * Clamps a tensor with a maximum tensor.
 */
pub clamp_tensor_max(input: Tensor, maximum: Tensor): Tensor ->
    native_clamp_tensor(input, 1, maximum, maximum).

/**
 * Writes a clamp with a maximum tensor into retained output storage.
 */
pub clamp_tensor_max_out(output: Tensor, input: Tensor, maximum: Tensor): Unit ->
    native_clamp_tensor_out(output, input, 1, maximum, maximum).

/**
 * Clamps tensor storage in place with a maximum tensor.
 */
pub clamp_tensor_max_in_place(input: Tensor, maximum: Tensor): Unit ->
    native_clamp_tensor_in_place(input, 1, maximum, maximum).

/**
 * Provides the clip alias for clamp_int.
 */
pub clip_int(input: Tensor, minimum: Int, maximum: Int): Tensor ->
    clamp_int(input, minimum, maximum).

/**
 * Provides the output-storage clip alias for clamp_int.
 */
pub clip_int_out(output: Tensor, input: Tensor, minimum: Int, maximum: Int): Unit ->
    clamp_int_out(output, input, minimum, maximum).

/**
 * Provides the in-place clip alias for clamp_int.
 */
pub clip_int_in_place(input: Tensor, minimum: Int, maximum: Int): Unit ->
    clamp_int_in_place(input, minimum, maximum).

/**
 * Provides the clip alias for clamp_float.
 */
pub clip_float(input: Tensor, minimum: Float, maximum: Float): Tensor ->
    clamp_float(input, minimum, maximum).

/**
 * Provides the output-storage clip alias for clamp_float.
 */
pub clip_float_out(output: Tensor, input: Tensor, minimum: Float, maximum: Float): Unit ->
    clamp_float_out(output, input, minimum, maximum).

/**
 * Provides the in-place clip alias for clamp_float.
 */
pub clip_float_in_place(input: Tensor, minimum: Float, maximum: Float): Unit ->
    clamp_float_in_place(input, minimum, maximum).

/**
 * Provides the clip alias for clamp_int_float.
 */
pub clip_int_float(input: Tensor, minimum: Int, maximum: Float): Tensor ->
    clamp_int_float(input, minimum, maximum).

/**
 * Provides the output-storage clip alias for clamp_int_float.
 */
pub clip_int_float_out(output: Tensor, input: Tensor, minimum: Int, maximum: Float): Unit ->
    clamp_int_float_out(output, input, minimum, maximum).

/**
 * Provides the in-place clip alias for clamp_int_float.
 */
pub clip_int_float_in_place(input: Tensor, minimum: Int, maximum: Float): Unit ->
    clamp_int_float_in_place(input, minimum, maximum).

/**
 * Provides the clip alias for clamp_float_int.
 */
pub clip_float_int(input: Tensor, minimum: Float, maximum: Int): Tensor ->
    clamp_float_int(input, minimum, maximum).

/**
 * Provides the output-storage clip alias for clamp_float_int.
 */
pub clip_float_int_out(output: Tensor, input: Tensor, minimum: Float, maximum: Int): Unit ->
    clamp_float_int_out(output, input, minimum, maximum).

/**
 * Provides the in-place clip alias for clamp_float_int.
 */
pub clip_float_int_in_place(input: Tensor, minimum: Float, maximum: Int): Unit ->
    clamp_float_int_in_place(input, minimum, maximum).

/**
 * Provides the clip alias for clamp_min_int.
 */
pub clip_min_int(input: Tensor, minimum: Int): Tensor ->
    clamp_min_int(input, minimum).

/**
 * Provides the output-storage clip alias for clamp_min_int.
 */
pub clip_min_int_out(output: Tensor, input: Tensor, minimum: Int): Unit ->
    clamp_min_int_out(output, input, minimum).

/**
 * Provides the in-place clip alias for clamp_min_int.
 */
pub clip_min_int_in_place(input: Tensor, minimum: Int): Unit ->
    clamp_min_int_in_place(input, minimum).

/**
 * Provides the clip alias for clamp_min_float.
 */
pub clip_min_float(input: Tensor, minimum: Float): Tensor ->
    clamp_min_float(input, minimum).

/**
 * Provides the output-storage clip alias for clamp_min_float.
 */
pub clip_min_float_out(output: Tensor, input: Tensor, minimum: Float): Unit ->
    clamp_min_float_out(output, input, minimum).

/**
 * Provides the in-place clip alias for clamp_min_float.
 */
pub clip_min_float_in_place(input: Tensor, minimum: Float): Unit ->
    clamp_min_float_in_place(input, minimum).

/**
 * Provides the clip alias for clamp_max_int.
 */
pub clip_max_int(input: Tensor, maximum: Int): Tensor ->
    clamp_max_int(input, maximum).

/**
 * Provides the output-storage clip alias for clamp_max_int.
 */
pub clip_max_int_out(output: Tensor, input: Tensor, maximum: Int): Unit ->
    clamp_max_int_out(output, input, maximum).

/**
 * Provides the in-place clip alias for clamp_max_int.
 */
pub clip_max_int_in_place(input: Tensor, maximum: Int): Unit ->
    clamp_max_int_in_place(input, maximum).

/**
 * Provides the clip alias for clamp_max_float.
 */
pub clip_max_float(input: Tensor, maximum: Float): Tensor ->
    clamp_max_float(input, maximum).

/**
 * Provides the output-storage clip alias for clamp_max_float.
 */
pub clip_max_float_out(output: Tensor, input: Tensor, maximum: Float): Unit ->
    clamp_max_float_out(output, input, maximum).

/**
 * Provides the in-place clip alias for clamp_max_float.
 */
pub clip_max_float_in_place(input: Tensor, maximum: Float): Unit ->
    clamp_max_float_in_place(input, maximum).

/**
 * Provides the clip alias for clamp_tensor.
 */
pub clip_tensor(input: Tensor, minimum: Tensor, maximum: Tensor): Tensor ->
    clamp_tensor(input, minimum, maximum).

/**
 * Provides the output-storage clip alias for clamp_tensor.
 */
pub clip_tensor_out(output: Tensor, input: Tensor, minimum: Tensor, maximum: Tensor): Unit ->
    clamp_tensor_out(output, input, minimum, maximum).

/**
 * Provides the in-place clip alias for clamp_tensor.
 */
pub clip_tensor_in_place(input: Tensor, minimum: Tensor, maximum: Tensor): Unit ->
    clamp_tensor_in_place(input, minimum, maximum).

/**
 * Provides the clip alias for clamp_tensor_min.
 */
pub clip_tensor_min(input: Tensor, minimum: Tensor): Tensor ->
    clamp_tensor_min(input, minimum).

/**
 * Provides the output-storage clip alias for clamp_tensor_min.
 */
pub clip_tensor_min_out(output: Tensor, input: Tensor, minimum: Tensor): Unit ->
