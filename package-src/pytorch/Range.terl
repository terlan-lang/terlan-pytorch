/**
 * Lowers retained scalar endpoint spacing to its shared native primitive.
 */
scalar_spacing_out(
    output: Tensor,
    operation: Int,
    start: Scalar,
    end: Scalar,
    steps: Int,
    base: Float,
): Unit ->
    spacing_scalar_out_exact_native(
        output,
        operation,
        start.is_integer,
        start.integer_value,
        start.floating_value,
        end.is_integer,
        end.integer_value,
        end.floating_value,
        steps,
        base,
    ).

/**
 * Lowers one inclusive range call to its shared native primitive.
 */
create_range(
    explicit_step: Bool,
    start: Scalar,
    end: Scalar,
    step: Scalar,
    configured: RangeOptions,
): Tensor ->
    range_exact_native(
        explicit_step,
        start.is_integer,
        start.integer_value,
        start.floating_value,
        end.is_integer,
        end.integer_value,
        end.floating_value,
        step.is_integer,
        step.integer_value,
        step.floating_value,
        dtype_code(configured.dtype),
        configured.has_dtype,
        configured.layout_code,
        configured.has_layout,
        device_kind(configured.device),
        device_index_for(configured.device),
        configured.has_device,
        configured.pin_memory,
        configured.has_pin_memory,
    ).

/**
 * Lowers one retained inclusive range call to its shared native primitive.
 */
write_range(output: Tensor, explicit_step: Bool, start: Scalar, end: Scalar, step: Scalar): Unit ->
    range_out_exact_native(
        output,
        explicit_step,
        start.is_integer,
        start.integer_value,
        start.floating_value,
        end.is_integer,
        end.integer_value,
        end.floating_value,
        step.is_integer,
        step.integer_value,
        step.floating_value,
    ).
