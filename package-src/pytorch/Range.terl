/**
 * Lowers scalar-to-tensor spacing to its shared native primitive.
 */
scalar_tensor_spacing(
    operation: Int,
    start: Scalar,
    end: Tensor,
    steps: Int,
    base: Float,
    configured: RangeOptions,
): Tensor ->
    spacing_scalar_tensor_exact_native(
        operation,
        start.is_integer,
        start.integer_value,
        start.floating_value,
        end,
        steps,
        base,
        dtype_code(configured.dtype),
        configured.has_dtype,
