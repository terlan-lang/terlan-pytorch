/**
 * Writes tensor-to-scalar logarithmic spacing into retained storage.
 */
pub logspace_out(output: Tensor, start: Tensor, end: Scalar, steps: Int, base: Float): Unit ->
    spacing_tensor_scalar_out_exact_native(
        output,
        1,
        start,
        end.is_integer,
        end.integer_value,
        end.floating_value,
