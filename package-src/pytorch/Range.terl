/**
 * Creates an inclusive unit-step legacy range with inferred options.
 */
pub range(start: Scalar, end: Scalar): Tensor ->
    create_range(false, start, end, one(), default_options()).

/**
 * Creates an inclusive legacy range with inferred options.
 */
pub range(start: Scalar, end: Scalar, step: Scalar): Tensor ->
    create_range(true, start, end, step, default_options()).

/**
 * Creates an inclusive legacy range with explicit option presence.
 */
pub range_with(start: Scalar, end: Scalar, step: Scalar, configured: RangeOptions): Tensor ->
    create_range(true, start, end, step, configured).

/**
 * Writes an inclusive unit-step legacy range into retained storage.
 */
pub range_out(output: Tensor, start: Scalar, end: Scalar): Unit ->
    write_range(output, false, start, end, one()).

/**
 * Writes an inclusive legacy range into retained storage.
 */
pub range_out(output: Tensor, start: Scalar, end: Scalar, step: Scalar): Unit ->
    write_range(output, true, start, end, step).

/**
 * Lowers one arange family call to its shared native primitive.
 */
create_arange(
    form: Int,
    start: Scalar,
    end: Scalar,
    step: Scalar,
    configured: RangeOptions,
): Tensor ->
    arange_exact_native(
        form,
        start.is_integer,
        start.integer_value,
        start.floating_value,
        end.is_integer,
        end.integer_value,
        end.floating_value,
        step.is_integer,
        step.integer_value,
        step.floating_value,
        dtype_code(configured.dtype),
        configured.has_dtype,
        configured.layout_code,
        configured.has_layout,
        device_kind(configured.device),
        device_index_for(configured.device),
        configured.has_device,
        configured.pin_memory,
        configured.has_pin_memory,
    ).

/**
 * Lowers one retained arange family call to its shared native primitive.
 */
write_arange(output: Tensor, form: Int, start: Scalar, end: Scalar, step: Scalar): Unit ->
    arange_out_exact_native(
        output,
        form,
        start.is_integer,
        start.integer_value,
        start.floating_value,
        end.is_integer,
        end.integer_value,
        end.floating_value,
        step.is_integer,
        step.integer_value,
        step.floating_value,
    ).

/**
 * Lowers one identity call to its shared native primitive.
 */
create_eye(rows: Int, columns: Int, rectangular: Bool, configured: RangeOptions): Tensor ->
    eye_exact_native(
        rows,
        columns,
        rectangular,
        dtype_code(configured.dtype),
        configured.has_dtype,
        configured.layout_code,
        configured.has_layout,
        device_kind(configured.device),
        device_index_for(configured.device),
        configured.has_device,
        configured.pin_memory,
        configured.has_pin_memory,
    ).

/**
 * Lowers scalar endpoint spacing to its shared native primitive.
 */
scalar_spacing(
    operation: Int,
    start: Scalar,
    end: Scalar,
    steps: Int,
    base: Float,
    configured: RangeOptions,
): Tensor ->
    spacing_scalar_exact_native(
        operation,
        start.is_integer,
        start.integer_value,
        start.floating_value,
        end.is_integer,
        end.integer_value,
        end.floating_value,
        steps,
        base,
        dtype_code(configured.dtype),
        configured.has_dtype,
        configured.layout_code,
        configured.has_layout,
        device_kind(configured.device),
        device_index_for(configured.device),
        configured.has_device,
        configured.pin_memory,
        configured.has_pin_memory,
    ).

/**
 * Lowers tensor endpoint spacing to its shared native primitive.
 */
tensor_tensor_spacing(
    operation: Int,
    start: Tensor,
    end: Tensor,
    steps: Int,
    base: Float,
    configured: RangeOptions,
