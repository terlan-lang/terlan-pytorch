 * Applies per-tensor affine fake quantization.
 */
@compiler.native {pytorch.quantization.fake_quantize_per_tensor_affine}
pub fake_quantize_per_tensor_affine(
    input: Tensor,
    scale: Float,
    zero_point: Int,
    quant_min: Int,
    quant_max: Int,
): Tensor ->
    native.

