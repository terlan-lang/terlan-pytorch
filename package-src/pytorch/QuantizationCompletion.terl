/**
 * Converts a quantized tensor to a floating tensor.
 */
@compiler.native {pytorch.quantization.dequantize}
pub dequantize(input: Tensor): Tensor ->
    native.

/**
 * Dequantizes each tensor in a tensor list.
 */
@compiler.native {pytorch.quantization.dequantize_tensors}
pub dequantize_tensors(tensors: List[Tensor]): List[Tensor] ->
    native.

/**
 * Dequantizes into caller-owned tensor-list outputs, preserving the ATen
 * tensors_out contract through element-wise retained-storage copies.
 */
pub dequantize_tensors_out(tensors: List[Tensor], outputs: List[Tensor]): Unit ->
    let values = dequantize_tensors(tensors);
    copy_tensor_list(values, outputs).

copy_tensor_list(values: List[Tensor], outputs: List[Tensor]): Unit ->
    case values {
        [] -> Unit;
        [value | rest_values] -> copy_tensor_item(value, rest_values, outputs)
    }.

copy_tensor_item(value: Tensor, rest_values: List[Tensor], outputs: List[Tensor]): Unit ->
    case outputs {
        [] -> dispose(value);
        [target | rest_out] -> copy_tensor_value(target, value, rest_values, rest_out)
    }.

copy_tensor_value(
    target: Tensor,
    value: Tensor,
    rest_values: List[Tensor],
    rest_out: List[Tensor],
): Unit ->
    copy_in_place(target, value);
    dispose(value);
    copy_tensor_list(rest_values, rest_out).

/**
 * Writes a dequantized floating tensor into retained output storage.
 */
@compiler.native {pytorch.quantization.dequantize_out}
pub dequantize_out(output: Tensor, input: Tensor): Unit ->
    native.

