 * Applies subtract with a Int operand and Int alpha.
 */
pub subtract_right_int_alpha_int(left: Tensor, right: Int, alpha: Int): Tensor ->
    scaled_scalar_int(left, 1, right, true, alpha, 0.0).

/**
