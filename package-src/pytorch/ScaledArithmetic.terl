/**
 * Applies tensor sub with Int alpha.
 */
pub sub_tensor_alpha_int(left: Tensor, right: Tensor, alpha: Int): Tensor ->
    scaled_tensor(left, 1, right, true, alpha, 0.0).

/**
 * Writes tensor sub with Int alpha.
 */
pub sub_tensor_alpha_int_out(output: Tensor, left: Tensor, right: Tensor, alpha: Int): Unit ->
    scaled_tensor_out(output, left, 1, right, true, alpha, 0.0).

/**
