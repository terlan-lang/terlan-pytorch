module pytorch_consumer.Main.

import pytorch.Tensor.{from_float, load_torchscript, torchscript_forward_tensor_list}.
import std.io.Console.{println}.

pub main(): Unit ->
    let tensor_model = load_torchscript("$model");
    let input = from_float(3.0);
    let output = torchscript_forward_tensor_list(tensor_model, input);
    println("PYTORCH_TORCHSCRIPT_NON_TENSOR_LIST_UNEXPECTED_SUCCESS").
