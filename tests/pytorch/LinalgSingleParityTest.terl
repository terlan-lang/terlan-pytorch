module pytorch.LinalgSingleParityTest.

import pytorch.Linalg.{cholesky_solve, geqrf, linalg_cholesky, linalg_cholesky_out, linalg_cond_default, linalg_cond_float, linalg_cond_int, linalg_cond_string, linalg_cross, linalg_cross_out, linalg_det, linalg_det_out, linalg_diagonal, linalg_eigvals_out, linalg_eigvalsh, linalg_eigvalsh_out, linalg_householder_product_out, linalg_inv, linalg_inv_out, linalg_ldl_factor, linalg_ldl_solve, linalg_ldl_solve_out, linalg_lu_factor, linalg_lu_solve, linalg_lu_solve_out, linalg_matmul_out, linalg_matrix_exp_out, linalg_matrix_norm_float, linalg_matrix_norm_float_configured, linalg_matrix_norm_int, linalg_matrix_norm_int_configured, linalg_matrix_norm_string, linalg_matrix_norm_string_dtype, linalg_matrix_power_out, linalg_matrix_rank_default, linalg_matrix_rank_tensor_absolute, linalg_matrix_rank_tensor_default, linalg_matrix_rank_tensor_relative, linalg_matrix_rank_tensor_tolerances, linalg_matrix_rank_tolerance, linalg_matrix_rank_tolerances, linalg_multi_dot, linalg_multi_dot_out, linalg_norm_default, linalg_norm_float, linalg_norm_float_configured, linalg_norm_int, linalg_norm_int_configured, linalg_norm_string, linalg_norm_string_dimensions, linalg_pinv_default, linalg_pinv_rcond, linalg_pinv_tensor_absolute, linalg_pinv_tensor_default, linalg_pinv_tensor_relative, linalg_pinv_tensor_tolerances, linalg_pinv_tolerances, linalg_powsum_float, linalg_powsum_float_configured, linalg_powsum_int, linalg_powsum_int_configured, linalg_solve, linalg_solve_out, linalg_solve_triangular, linalg_solve_triangular_out, linalg_svdvals, linalg_svdvals_out, linalg_tensorinv_out, linalg_tensorsolve, linalg_tensorsolve_dimensions, linalg_tensorsolve_out, linalg_vander, linalg_vander_columns, linalg_vecdot, linalg_vecdot_out, linalg_vector_norm_float, linalg_vector_norm_float_configured, linalg_vector_norm_int, linalg_vector_norm_int_configured, lu_solve, ormqr}.
import pytorch.Special.{linalg_eigvals}.
import pytorch.Tensor.{dispose, dtype, from_float, from_floats, item, item_bool, item_float, shape, sum, zeros}.
