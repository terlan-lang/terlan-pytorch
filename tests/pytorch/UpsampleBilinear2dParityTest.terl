/**
 * CPU shape and dtype evidence for aten::upsample_bilinear2d.
 */
module pytorch.UpsampleBilinear2dParityTest.

import pytorch.Tensor.{dispose, dtype, from_floats, shape}.
import pytorch.UpsampleBilinear2dCompletion.{upsample_bilinear2d, upsample_bilinear2d_out}.

@test
pub upsample_bilinear2d_forms_match(): Bool ->
    let input = from_floats([0.0, 1.0, 2.0, 3.0], [1, 1, 2, 2]);
    let actual = upsample_bilinear2d(input, [4, 4], false);
    let output = from_floats([], [0]);
    upsample_bilinear2d_out(output, input, [4, 4], false);
    let valid =
        shape(actual) == [1, 1, 4, 4]
            and shape(output) == [1, 1, 4, 4]
            and dtype(actual) == dtype(input)
            and dtype(output) == dtype(input);
    (dispose(output); dispose(actual); dispose(input); valid).
