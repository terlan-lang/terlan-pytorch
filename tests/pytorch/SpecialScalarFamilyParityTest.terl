            and shape(right) == [2];
    (dispose(left_float_output); dispose(left_int_output); dispose(right_float_output); dispose(right_int_output); dispose(left_float); dispose(left_int); dispose(right_float); dispose(right_int); dispose(left_float_expected); dispose(left_int_expected); dispose(right_float_expected); dispose(right_int_expected); dispose(left_float_tensor); dispose(left_int_tensor); dispose(right_float_tensor); dispose(right_int_tensor); dispose(right); dispose(left); valid).

