, special_shifted_chebyshev_polynomial_w_right_float_out, special_shifted_chebyshev_polynomial_w_right_int, special_shifted_chebyshev_polynomial_w_right_int_out, special_xlog1py_left_float, special_xlog1py_left_float_out, special_xlog1py_left_int, special_xlog1py_left_int_out, special_xlog1py_right_float, special_xlog1py_right_float_out, special_xlog1py_right_int, special_xlog1py_right_int_out, special_xlogy_left_float, special_xlogy_left_float_out, special_xlogy_left_int, special_xlogy_left_int_out, special_xlogy_right_float, special_xlogy_right_float_out, special_xlogy_right_int, special_xlogy_right_int_out, special_zeta_left_float, special_zeta_left_float_out, special_zeta_left_int, special_zeta_left_int_out, special_zeta_right_float, special_zeta_right_float_out, special_zeta_right_int, special_zeta_right_int_out}.
import pytorch.Tensor.{dispose, from_floats, item_float, mse_loss, shape, zeros}.

import type pytorch.Tensor.{DType, Tensor}.

/**
 * Compares a Scalar-overload result with an independently dispatched tensor reference.
 */
matches(actual: Tensor, expected: Tensor): Bool ->
    let error = mse_loss(actual, expected, 1);
    let value = item_float(error);
    dispose(error);
    value == 0.0.

/**
 * Proves every Scalar overload for special_chebyshev_polynomial_u.
 */
@test
pub chebyshev_u_scalar_overloads_match_libtorch(): Bool ->
    let input = from_floats([0.25, 0.5], [2]);
    let orders = from_floats([2.0, 2.0], [2]);
    let zero_inputs = from_floats([0.0, 0.0], [2]);
    let half_inputs = from_floats([0.5, 0.5], [2]);
    let right_expected = special_chebyshev_polynomial_u_tensor(input, orders);
    let left_int_expected = special_chebyshev_polynomial_u_tensor(zero_inputs, orders);
    let left_float_expected = special_chebyshev_polynomial_u_tensor(half_inputs, orders);
    let right_int = special_chebyshev_polynomial_u_right_int(input, 2);
    let right_float = special_chebyshev_polynomial_u_right_float(input, 2.0);
    let left_int = special_chebyshev_polynomial_u_left_int(0, orders);
    let left_float = special_chebyshev_polynomial_u_left_float(0.5, orders);
    let right_int_output = zeros([0], DType.FLOAT64);
    let right_float_output = zeros([0], DType.FLOAT64);
    let left_int_output = zeros([0], DType.FLOAT64);
    let left_float_output = zeros([0], DType.FLOAT64);
    special_chebyshev_polynomial_u_right_int_out(right_int_output, input, 2);
    special_chebyshev_polynomial_u_right_float_out(right_float_output, input, 2.0);
    special_chebyshev_polynomial_u_left_int_out(left_int_output, 0, orders);
    special_chebyshev_polynomial_u_left_float_out(left_float_output, 0.5, orders);
    let valid =
        matches(right_int, right_expected)
            and matches(right_float, right_expected)
            and matches(left_int, left_int_expected)
            and matches(left_float, left_float_expected)
            and matches(right_int_output, right_expected)
            and matches(right_float_output, right_expected)
            and matches(left_int_output, left_int_expected)
            and matches(left_float_output, left_float_expected)
            and shape(input) == [2]
            and shape(orders) == [2];
    (dispose(left_float_output); dispose(left_int_output); dispose(right_float_output); dispose(right_int_output); dispose(left_float); dispose(left_int); dispose(right_float); dispose(right_int); dispose(left_float_expected); dispose(left_int_expected); dispose(right_expected); dispose(half_inputs); dispose(zero_inputs); dispose(orders); dispose(input); valid).

