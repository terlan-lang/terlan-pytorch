module pytorch.IndexFillParityTest.

import pytorch.IndexFill.{index_fill_float, index_fill_float_in_place, index_fill_float_out, index_fill_int, index_fill_int_in_place, index_fill_int_out, index_fill_tensor, index_fill_tensor_in_place, index_fill_tensor_out}.
import pytorch.Tensor.{dispose, from_float, from_floats, from_ints, item_float, sum}.

/**
 * Proves integer and floating scalar functional, output, and in-place schemas.
 */
@test
pub scalar_forms_match_libtorch(): Bool ->
    let input = from_floats([1.0, 2.0, 3.0, 4.0], [2, 2]);
    let index = from_ints([1], [1]);
    let integer = index_fill_int(input, 1, index, 9);
    let floating = index_fill_float(input, 0, index, 0.5);
    let integer_output = from_float(-1.0);
    let floating_output = from_float(-1.0);
    let integer_mutation = from_floats([1.0, 2.0, 3.0, 4.0], [2, 2]);
    let floating_mutation = from_floats([1.0, 2.0, 3.0, 4.0], [2, 2]);
    index_fill_int_out(integer_output, input, 1, index, 7);
    index_fill_float_out(floating_output, input, 1, index, 2.5);
    index_fill_int_in_place(integer_mutation, 1, index, 7);
    index_fill_float_in_place(floating_mutation, 0, index, 0.5);
    let integer_total = sum(integer);
    let floating_total = sum(floating);
    let integer_output_total = sum(integer_output);
    let floating_output_total = sum(floating_output);
    let integer_mutation_total = sum(integer_mutation);
    let floating_mutation_total = sum(floating_mutation);
    let input_total = sum(input);
    let valid =
        item_float(integer_total) == 22.0
            and item_float(floating_total) == 4.0
            and item_float(integer_output_total) == 18.0
            and item_float(floating_output_total) == 9.0
            and item_float(integer_mutation_total) == 18.0
            and item_float(floating_mutation_total) == 4.0
            and item_float(input_total) == 10.0;
    (dispose(input_total); dispose(floating_mutation_total); dispose(integer_mutation_total); dispose(floating_output_total); dispose(integer_output_total); dispose(floating_total); dispose(integer_total); dispose(floating_mutation); dispose(integer_mutation); dispose(floating_output); dispose(integer_output); dispose(floating); dispose(integer); dispose(index); dispose(input); valid).

/**
 * Proves tensor-valued functional, output, and in-place schemas retain every source.
 */
@test
pub tensor_forms_match_libtorch(): Bool ->
    let input = from_floats([1.0, 2.0, 3.0, 4.0], [2, 2]);
    let index = from_ints([0], [1]);
    let value = from_float(5.0);
    let functional = index_fill_tensor(input, 1, index, value);
    let output = from_float(-1.0);
    let mutation = from_floats([1.0, 2.0, 3.0, 4.0], [2, 2]);
    index_fill_tensor_out(output, input, 1, index, value);
    index_fill_tensor_in_place(mutation, 1, index, value);
    let functional_total = sum(functional);
    let output_total = sum(output);
    let mutation_total = sum(mutation);
    let input_total = sum(input);
    let valid =
        item_float(functional_total) == 16.0
            and item_float(output_total) == 16.0
            and item_float(mutation_total) == 16.0
            and item_float(input_total) == 10.0
            and item_float(value) == 5.0;
    (dispose(input_total); dispose(mutation_total); dispose(output_total); dispose(functional_total); dispose(mutation); dispose(output); dispose(functional); dispose(value); dispose(index); dispose(input); valid).
