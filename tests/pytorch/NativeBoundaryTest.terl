module pytorch.NativeBoundaryTest.

import pytorch.Tensor.{abi_version, clone, dim, dispose, dtype, flatten, from_floats, is_contiguous, item_float, numel, relu, shape, strides}.
import std.collections.List.

@test
pub generated_c_abi_native_boundary_executes(): Bool ->
    let boundary = from_floats([40.0], [1]);
    let returned_clone = clone(boundary);
    let returned_relu = relu(boundary);
    let returned_flatten = flatten(boundary, 0, 0);
    let observed_item = item_float(boundary);
    let observed_dim = dim(boundary);
    let observed_numel = numel(boundary);
    let observed_shape = shape(boundary);
    let observed_strides = strides(boundary);
    let observed_dtype = dtype(boundary);
    let observed_is_contiguous = is_contiguous(boundary);
    let observed_abi_version = abi_version();
    let observed_clone_item = item_float(returned_clone);
    let observed_relu_item = item_float(returned_relu);
    let observed_flatten_item = item_float(returned_flatten);
    dispose(returned_clone);
    dispose(returned_relu);
    dispose(returned_flatten);
    dispose(boundary);
    observed_item == 40.0
        and observed_clone_item == observed_item
        and observed_relu_item == observed_item
        and observed_flatten_item == observed_item
        and observed_shape.length() == observed_dim
        and observed_strides.length() == observed_dim
        and observed_numel == 1
        and observed_dtype == 7
        and observed_is_contiguous
        and observed_abi_version > 0.
