module pytorch.SpecialOutParityTest.

import pytorch.Special.{special_airy_ai, special_airy_ai_out, special_bessel_j0, special_bessel_j0_out, special_bessel_j1, special_bessel_j1_out, special_bessel_y0, special_bessel_y0_out, special_bessel_y1, special_bessel_y1_out, special_digamma, special_digamma_out, special_entr, special_entr_out, special_erf, special_erf_out, special_erfc, special_erfc_out, special_erfcx, special_erfcx_out, special_erfinv, special_erfinv_out, special_exp2, special_exp2_out, special_expit, special_expit_out, special_expm1, special_expm1_out, special_gammaln, special_gammaln_out, special_i0, special_i0_out, special_i0e, special_i0e_out, special_i1, special_i1_out, special_i1e, special_i1e_out, special_log1p, special_log1p_out, special_log_ndtr, special_log_ndtr_out, special_modified_bessel_i0, special_modified_bessel_i0_out, special_modified_bessel_i1, special_modified_bessel_i1_out, special_modified_bessel_k0, special_modified_bessel_k0_out, special_modified_bessel_k1, special_modified_bessel_k1_out, special_ndtr, special_ndtr_out, special_ndtri, special_ndtri_out, special_psi, special_psi_out, special_scaled_modified_bessel_k0, special_scaled_modified_bessel_k0_out, special_scaled_modified_bessel_k1, special_scaled_modified_bessel_k1_out, special_sinc, special_sinc_out, special_spherical_bessel_j0, special_spherical_bessel_j0_out}.
import pytorch.Tensor.{dispose, from_floats, item_float, mse_loss, shape, zeros}.

import type pytorch.Tensor.{DType, Tensor}.

/**
 * Compares an output tensor with an independently dispatched reference.
 */
matches(actual: Tensor, expected: Tensor): Bool ->
    let error = mse_loss(actual, expected, 1);
    let value = item_float(error);
    dispose(error);
    value == 0.0.

/**
 * Proves Airy, Bessel, digamma, entropy, and error-function output mutation.
 */
@test
pub airy_bessel_and_entropy_outputs_match_libtorch(): Bool ->
    let input = from_floats([0.5, 1.0], [2]);
    let airy_expected = special_airy_ai(input);
    let j0_expected = special_bessel_j0(input);
    let j1_expected = special_bessel_j1(input);
    let y0_expected = special_bessel_y0(input);
    let y1_expected = special_bessel_y1(input);
    let digamma_expected = special_digamma(input);
    let entr_expected = special_entr(input);
    let erf_expected = special_erf(input);
    let airy_output = zeros([0], DType.FLOAT64);
    let j0_output = zeros([0], DType.FLOAT64);
    let j1_output = zeros([0], DType.FLOAT64);
    let y0_output = zeros([0], DType.FLOAT64);
    let y1_output = zeros([0], DType.FLOAT64);
    let digamma_output = zeros([0], DType.FLOAT64);
    let entr_output = zeros([0], DType.FLOAT64);
    let erf_output = zeros([0], DType.FLOAT64);
    special_airy_ai_out(airy_output, input);
    special_bessel_j0_out(j0_output, input);
    special_bessel_j1_out(j1_output, input);
    special_bessel_y0_out(y0_output, input);
    special_bessel_y1_out(y1_output, input);
    special_digamma_out(digamma_output, input);
    special_entr_out(entr_output, input);
    special_erf_out(erf_output, input);
    let valid =
        matches(airy_output, airy_expected)
            and matches(j0_output, j0_expected)
            and matches(j1_output, j1_expected)
            and matches(y0_output, y0_expected)
            and matches(y1_output, y1_expected)
            and matches(digamma_output, digamma_expected)
            and matches(entr_output, entr_expected)
            and matches(erf_output, erf_expected)
            and shape(input) == [2];
    (dispose(erf_output); dispose(entr_output); dispose(digamma_output); dispose(y1_output); dispose(y0_output); dispose(j1_output); dispose(j0_output); dispose(airy_output); dispose(erf_expected); dispose(entr_expected); dispose(digamma_expected); dispose(y1_expected); dispose(y0_expected); dispose(j1_expected); dispose(j0_expected); dispose(airy_expected); dispose(input); valid).

/**
 * Proves error, exponential, gamma, and Bessel I0 output mutation.
 */
@test
pub error_exponential_and_gamma_outputs_match_libtorch(): Bool ->
    let input = from_floats([0.25, 0.5], [2]);
    let erfc_expected = special_erfc(input);
    let erfcx_expected = special_erfcx(input);
    let erfinv_expected = special_erfinv(input);
    let exp2_expected = special_exp2(input);
    let expit_expected = special_expit(input);
    let expm1_expected = special_expm1(input);
    let gammaln_expected = special_gammaln(input);
    let i0_expected = special_i0(input);
    let erfc_output = zeros([0], DType.FLOAT64);
    let erfcx_output = zeros([0], DType.FLOAT64);
    let erfinv_output = zeros([0], DType.FLOAT64);
    let exp2_output = zeros([0], DType.FLOAT64);
    let expit_output = zeros([0], DType.FLOAT64);
    let expm1_output = zeros([0], DType.FLOAT64);
    let gammaln_output = zeros([0], DType.FLOAT64);
    let i0_output = zeros([0], DType.FLOAT64);
    special_erfc_out(erfc_output, input);
    special_erfcx_out(erfcx_output, input);
    special_erfinv_out(erfinv_output, input);
    special_exp2_out(exp2_output, input);
    special_expit_out(expit_output, input);
    special_expm1_out(expm1_output, input);
    special_gammaln_out(gammaln_output, input);
    special_i0_out(i0_output, input);
    let valid =
        matches(erfc_output, erfc_expected)
            and matches(erfcx_output, erfcx_expected)
            and matches(erfinv_output, erfinv_expected)
            and matches(exp2_output, exp2_expected)
            and matches(expit_output, expit_expected)
            and matches(expm1_output, expm1_expected)
            and matches(gammaln_output, gammaln_expected)
            and matches(i0_output, i0_expected)
            and shape(input) == [2];
    (dispose(i0_output); dispose(gammaln_output); dispose(expm1_output); dispose(expit_output); dispose(exp2_output); dispose(erfinv_output); dispose(erfcx_output); dispose(erfc_output); dispose(i0_expected); dispose(gammaln_expected); dispose(expm1_expected); dispose(expit_expected); dispose(exp2_expected); dispose(erfinv_expected); dispose(erfcx_expected); dispose(erfc_expected); dispose(input); valid).

/**
 * Proves scaled Bessel, logarithm, normal, and modified-Bessel output mutation.
 */
@test
pub scaled_bessel_and_logarithm_outputs_match_libtorch(): Bool ->
    let input = from_floats([0.5, 1.0], [2]);
    let i0e_expected = special_i0e(input);
    let i1_expected = special_i1(input);
    let i1e_expected = special_i1e(input);
    let log1p_expected = special_log1p(input);
    let log_ndtr_expected = special_log_ndtr(input);
    let modified_i0_expected = special_modified_bessel_i0(input);
    let modified_i1_expected = special_modified_bessel_i1(input);
    let modified_k0_expected = special_modified_bessel_k0(input);
    let i0e_output = zeros([0], DType.FLOAT64);
    let i1_output = zeros([0], DType.FLOAT64);
    let i1e_output = zeros([0], DType.FLOAT64);
    let log1p_output = zeros([0], DType.FLOAT64);
    let log_ndtr_output = zeros([0], DType.FLOAT64);
    let modified_i0_output = zeros([0], DType.FLOAT64);
    let modified_i1_output = zeros([0], DType.FLOAT64);
    let modified_k0_output = zeros([0], DType.FLOAT64);
    special_i0e_out(i0e_output, input);
    special_i1_out(i1_output, input);
    special_i1e_out(i1e_output, input);
    special_log1p_out(log1p_output, input);
    special_log_ndtr_out(log_ndtr_output, input);
    special_modified_bessel_i0_out(modified_i0_output, input);
    special_modified_bessel_i1_out(modified_i1_output, input);
    special_modified_bessel_k0_out(modified_k0_output, input);
    let valid =
        matches(i0e_output, i0e_expected)
            and matches(i1_output, i1_expected)
            and matches(i1e_output, i1e_expected)
            and matches(log1p_output, log1p_expected)
            and matches(log_ndtr_output, log_ndtr_expected)
            and matches(modified_i0_output, modified_i0_expected)
            and matches(modified_i1_output, modified_i1_expected)
            and matches(modified_k0_output, modified_k0_expected)
            and shape(input) == [2];
    (dispose(modified_k0_output); dispose(modified_i1_output); dispose(modified_i0_output); dispose(log_ndtr_output); dispose(log1p_output); dispose(i1e_output); dispose(i1_output); dispose(i0e_output); dispose(modified_k0_expected); dispose(modified_i1_expected); dispose(modified_i0_expected); dispose(log_ndtr_expected); dispose(log1p_expected); dispose(i1e_expected); dispose(i1_expected); dispose(i0e_expected); dispose(input); valid).

/**
 * Proves normal, psi, scaled Bessel, sinc, and spherical-Bessel output mutation.
 */
@test
pub normal_psi_and_sinc_outputs_match_libtorch(): Bool ->
    let input = from_floats([0.25, 0.5], [2]);
    let modified_k1_expected = special_modified_bessel_k1(input);
    let ndtr_expected = special_ndtr(input);
    let ndtri_expected = special_ndtri(input);
    let psi_expected = special_psi(input);
    let scaled_k0_expected = special_scaled_modified_bessel_k0(input);
    let scaled_k1_expected = special_scaled_modified_bessel_k1(input);
    let sinc_expected = special_sinc(input);
    let spherical_j0_expected = special_spherical_bessel_j0(input);
    let modified_k1_output = zeros([0], DType.FLOAT64);
    let ndtr_output = zeros([0], DType.FLOAT64);
    let ndtri_output = zeros([0], DType.FLOAT64);
    let psi_output = zeros([0], DType.FLOAT64);
    let scaled_k0_output = zeros([0], DType.FLOAT64);
    let scaled_k1_output = zeros([0], DType.FLOAT64);
    let sinc_output = zeros([0], DType.FLOAT64);
    let spherical_j0_output = zeros([0], DType.FLOAT64);
    special_modified_bessel_k1_out(modified_k1_output, input);
    special_ndtr_out(ndtr_output, input);
    special_ndtri_out(ndtri_output, input);
    special_psi_out(psi_output, input);
    special_scaled_modified_bessel_k0_out(scaled_k0_output, input);
    special_scaled_modified_bessel_k1_out(scaled_k1_output, input);
    special_sinc_out(sinc_output, input);
    special_spherical_bessel_j0_out(spherical_j0_output, input);
    let valid =
        matches(modified_k1_output, modified_k1_expected)
            and matches(ndtr_output, ndtr_expected)
            and matches(ndtri_output, ndtri_expected)
            and matches(psi_output, psi_expected)
            and matches(scaled_k0_output, scaled_k0_expected)
            and matches(scaled_k1_output, scaled_k1_expected)
            and matches(sinc_output, sinc_expected)
            and matches(spherical_j0_output, spherical_j0_expected)
            and shape(input) == [2];
    (dispose(spherical_j0_output); dispose(sinc_output); dispose(scaled_k1_output); dispose(scaled_k0_output); dispose(psi_output); dispose(ndtri_output); dispose(ndtr_output); dispose(modified_k1_output); dispose(spherical_j0_expected); dispose(sinc_expected); dispose(scaled_k1_expected); dispose(scaled_k0_expected); dispose(psi_expected); dispose(ndtri_expected); dispose(ndtr_expected); dispose(modified_k1_expected); dispose(input); valid).
