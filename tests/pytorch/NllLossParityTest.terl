/**
 * CPU value parity evidence for aten::nll_loss forms.
 */
module pytorch.NllLossParityTest.

import pytorch.NllLossCompletion.{nll_loss_default, nll_loss_out_default, nll_loss_out_weight, nll_loss_weight}.
import pytorch.Tensor.{dispose, from_floats, from_ints, item_float}.

@test
pub nll_loss_forms_match(): Bool ->
    let input = from_floats([-1.0, -2.0, -3.0, -1.0, -2.0, -3.0], [2, 3]);
    let target = from_ints([1, 2], [2]);
    let weight = from_floats([1.0, 2.0, 3.0], [3]);
    let actual = nll_loss_default(input, target, 1, -100);
    let weighted = nll_loss_weight(input, target, weight, 1, -100);
    let output = from_floats([], [0]);
    nll_loss_out_default(output, input, target, 1, -100);
    let weighted_output = from_floats([], [0]);
    (nll_loss_out_weight(weighted_output, input, target, weight, 1, -100); let valid =
    item_float(actual) == 2.5
        and item_float(weighted) == 2.6
        and item_float(output) == 2.5
        and item_float(weighted_output) == 2.6;
(dispose(weighted_output); dispose(output); dispose(weight); dispose(target); dispose(weighted); dispose(actual); dispose(input); valid)).
