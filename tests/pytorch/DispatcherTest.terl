        ],
        [2, 2, 2, 2]
    );
    let pointwise_loss = mse_loss(pointwise, expected_pointwise, 1);
    let pointwise_activated = relu(pointwise);
    let pooled = adaptive_avg_pool2d(pointwise_activated, [1, 1]);
    let expected_pool = from_floats([8.0, 8.0, 16.0, 16.0], [2, 2, 1, 1]);
    let pool_loss = mse_loss(pooled, expected_pool, 1);
