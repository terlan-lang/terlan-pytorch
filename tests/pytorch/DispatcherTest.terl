module pytorch.DispatcherTest.

import pytorch.Tensor.{Tensor, TorchScriptModel, TensorPair, from_int, from_float, from_bool, from_floats, from_ints, full_float, item, item_float, item_bool, dim, numel, shape, dtype, device_type, device_index, clone, unsqueeze, matmul, transpose, multiply, add, subtract, relu, gelu, softmax, argmax, embedding, batch_norm, layer_norm, mse_loss, mse_loss_gradient, cross_entropy_loss, narrow, flatten, amax, conv2d, adaptive_avg_pool2d, load_torchscript, torchscript_forward, torchscript_forward2, torchscript_forward_pair, torchscript_forward_float, torchscript_forward_int, torchscript_forward_bool, torchscript_forward_string, torchscript_forward_int_list, torchscript_forward_float_list, torchscript_forward_bool_list, torchscript_forward_string_list, tensor_pair_first, tensor_pair_second, run_torchscript, dispose_model, dispose_tensor_pair, dispose}.

@test
pub signed_integer_dispatch_changes_tensor_shape(): Bool ->
    let source = from_int(40);
    let expanded = unsqueeze(source, -1);
    let copied = clone(expanded);
    let source_dim = dim(source);
    let expanded_dim = dim(expanded);
    let expanded_shape = shape(expanded);
    let copied_item = item(copied);
    dispose(copied);
    dispose(expanded);
    dispose(source);
    expanded_dim == source_dim + 1 and
        expanded_shape.length() == expanded_dim and
        copied_item == 40.

@test
pub multiple_tensor_dispatch_executes_matmul(): Bool ->
    let left_scalar = from_int(4);
    let left_vector = unsqueeze(left_scalar, -1);
    let left_matrix = unsqueeze(left_vector, -1);
    let right_scalar = from_int(5);
    let right_vector = unsqueeze(right_scalar, -1);
    let right_matrix = unsqueeze(right_vector, -1);
    let product = matmul(left_matrix, right_matrix);
    let product_item = item(product);
    let product_dim = dim(product);
    let product_shape = shape(product);
    let product_dtype = dtype(product);
    let product_device_type = device_type(product);
    let product_device_index = device_index(product);
    dispose(product);
    dispose(right_matrix);
    dispose(right_vector);
    dispose(right_scalar);
    dispose(left_matrix);
    dispose(left_vector);
    dispose(left_scalar);
    product_item == 20 and product_dim == 2 and product_shape.length() == 2 and
        product_dtype == 4 and product_device_type == 0 and product_device_index == -1.

@test
pub mixed_dispatcher_stack_executes_named_transpose_overload(): Bool ->
    let scalar = from_int(14);
    let vector = unsqueeze(scalar, -1);
    let matrix = unsqueeze(vector, -1);
    let result = transpose(matrix, 0, 1);
    let observed = item(result);
    let observed_dim = dim(result);
    dispose(result);
    dispose(matrix);
    dispose(vector);
    dispose(scalar);
    observed == 14 and observed_dim == 2.

@test
pub named_tensor_arithmetic_overload_executes_multiply(): Bool ->
    let left = from_int(4);
    let right = from_int(5);
    let result = multiply(left, right);
    let observed = item(result);
    dispose(result);
    dispose(right);
    dispose(left);
    observed == 20.

@test
pub float64_scalar_roundtrip_and_tensor_arithmetic(): Bool ->
    let left = from_float(2.5);
    let right = from_float(4.0);
    let result = multiply(left, right);
    let observed = item_float(result);
    let observed_dtype = dtype(result);
    dispose(result);
    dispose(right);
    dispose(left);
    observed == 10.0 and observed_dtype == 7.

@test
pub stable_c_scalar_arithmetic_executes_for_float64_tensors(): Bool ->
    let left = from_float(4.0);
    let right = from_float(1.5);
    let result = subtract(left, right, 2.0);
    let observed = item_float(result);
    dispose(result);
    dispose(right);
    dispose(left);
    observed == 1.0.

@test
pub bool_scalar_roundtrips_true_and_false(): Bool ->
    let enabled = from_bool(true);
    let disabled = from_bool(false);
    let observed_enabled = item_bool(enabled);
    let observed_disabled = item_bool(disabled);
    let observed_dtype = dtype(enabled);
    dispose(disabled);
    dispose(enabled);
    observed_enabled and not observed_disabled and observed_dtype == 11.

@test
pub relu_executes_without_mutating_or_consuming_its_input(): Bool ->
    let source = from_float(-2.5);
    let result = relu(source);
    let observed_source = item_float(source);
    let observed_result = item_float(result);
    let observed_dtype = dtype(result);
    dispose(result);
    dispose(source);
    observed_source == -2.5 and observed_result == 0.0 and observed_dtype == 7.

@test
pub serialized_torchscript_model_loads_and_executes_owned_tensor(): Bool ->
    let input = from_float(3.0);
    let output = run_torchscript(input, "fixtures/models/double.pt");
    let observed_input = item_float(input);
    let observed_output = item_float(output);
    let observed_dtype = dtype(output);
    let observed_rank = dim(output);
    dispose(output);
    dispose(input);
    observed_input == 3.0 and observed_output == 6.0 and
        observed_dtype == 7 and observed_rank == 0.

@test
pub loaded_torchscript_model_executes_multiple_independent_forwards(): Bool ->
    let model = load_torchscript("fixtures/models/double.pt");
    let first_input = from_float(3.0);
    let first_output = torchscript_forward(model, first_input);
    let first = item_float(first_output);
    dispose(first_output);
    dispose(first_input);
    let second_input = from_float(4.0);
    let second_output = torchscript_forward(model, second_input);
    let second = item_float(second_output);
    dispose(second_output);
    dispose(second_input);
    dispose_model(model);
    first == 6.0 and second == 8.0.

@test
pub loaded_torchscript_model_accepts_two_ordered_tensor_inputs(): Bool ->
    let model = load_torchscript("fixtures/models/weighted_difference.pt");
    let first_input = from_float(3.0);
    let second_input = from_float(4.0);
    let output = torchscript_forward2(model, first_input, second_input);
    let observed_first = item_float(first_input);
    let observed_second = item_float(second_input);
    let observed_output = item_float(output);
    dispose(output);
    dispose(second_input);
    dispose(first_input);
    dispose_model(model);
    observed_first == 3.0 and observed_second == 4.0 and
        observed_output == -5.0.

@test
pub torchscript_tensor_pair_outputs_extract_as_independent_tensors(): Bool ->
    let model = load_torchscript("fixtures/models/tensor_pair.pt");
    let input = from_float(2.0);
    let pair = torchscript_forward_pair(model, input);
    let first_output = tensor_pair_first(pair);
    let second_output = tensor_pair_second(pair);
    dispose_tensor_pair(pair);
    let observed_input = item_float(input);
    let observed_first = item_float(first_output);
    let observed_second = item_float(second_output);
    dispose(second_output);
    dispose(first_output);
    dispose(input);
    dispose_model(model);
    observed_input == 2.0 and observed_first == 4.0 and
        observed_second == 6.0.

