/**
 * Proves every remainder floating-scalar overload.
 */
@test
pub remainder_floating_overloads_match_libtorch(): Bool ->
    let left = from_float(7.0);
    let functional_right = remainder_right_float(left, 4.0);
    let functional_left = remainder_left_float(4.0, left);
    let right_output = from_float(0.0);
    let left_output = from_float(0.0);
    let mutation = from_float(7.0);
    remainder_right_float_out(right_output, left, 4.0);
    remainder_left_float_out(left_output, 4.0, left);
    remainder_right_float_in_place(mutation, 4.0);
    let valid =
        item_float(functional_right) == 3.0
            and item_float(functional_left) == 4.0
            and item_float(right_output) == 3.0
            and item_float(left_output) == 4.0
            and item_float(mutation) == 3.0
            and item_float(left) == 7.0;
    (dispose(mutation); dispose(left_output); dispose(right_output); dispose(functional_left); dispose(functional_right); dispose(left); valid).

