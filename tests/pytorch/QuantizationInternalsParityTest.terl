/**
 * CPU runtime evidence for executable quantization-internal ATen kernels.
 */
module pytorch.QuantizationInternalsParityTest.

import pytorch.QuantizationInternals.{choose_qparams_optimized, fused_moving_avg_obs_fake_quant}.
import pytorch.Tensor.{dispose, from_floats, is_defined, shape, to_dtype}.

@test
pub executable_quantization_internals_match_libtorch(): Bool ->
    let source_double = from_floats([-1.0, 0.0, 1.0], [3]);
    let source = to_dtype(source_double, 6);
    let {scale, zero_point} = choose_qparams_optimized(source, 3, 10, 0.7, 8);
    let observer_on = to_dtype(from_floats([1.0], []), 11);
    let fake_quant_on = to_dtype(from_floats([1.0], []), 11);
    let running_min = to_dtype(from_floats([0.0], [1]), 6);
    let running_max = to_dtype(from_floats([0.0], [1]), 6);
    let quant_scale = to_dtype(from_floats([1.0], [1]), 6);
    let zero_point_state = to_dtype(from_floats([0.0], [1]), 3);
    let output =
        fused_moving_avg_obs_fake_quant(
            source,
            observer_on,
            fake_quant_on,
            running_min,
            running_max,
            quant_scale,
            zero_point_state,
            0.1,
            -128,
            127,
            -1,
            false,
            false,
        );
    let valid =
        shape(scale) == [1]
            and shape(zero_point) == [1]
            and shape(output) == [3]
            and shape(running_min) == [1]
            and shape(running_max) == [1]
            and shape(quant_scale) == [1]
            and shape(zero_point_state) == [1]
            and is_defined(output);
    dispose(output);
    dispose(zero_point_state);
    dispose(quant_scale);
    dispose(running_max);
    dispose(running_min);
    dispose(fake_quant_on);
    dispose(observer_on);
    dispose(zero_point);
    dispose(scale);
    dispose(source);
    dispose(source_double);
    valid.
