/**
 * CPU shape and dtype evidence for aten::upsample_linear1d.
 */
module pytorch.UpsampleLinear1dParityTest.

import pytorch.Tensor.{dispose, dtype, from_floats, shape}.
import pytorch.UpsampleLinear1dCompletion.{upsample_linear1d, upsample_linear1d_out}.

@test
pub upsample_linear1d_forms_match(): Bool ->
    let input = from_floats([0.0, 1.0, 2.0, 3.0], [1, 1, 4]);
    let actual = upsample_linear1d(input, [8], false);
    let output = from_floats([], [0]);
    upsample_linear1d_out(output, input, [8], false);
    let valid =
        shape(actual) == [1, 1, 8]
            and shape(output) == [1, 1, 8]
            and dtype(actual) == dtype(input)
            and dtype(output) == dtype(input);
    (dispose(output); dispose(actual); dispose(input); valid).
