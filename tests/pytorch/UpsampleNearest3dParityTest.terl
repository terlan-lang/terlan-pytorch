/**
 * CPU shape and dtype evidence for aten::upsample_nearest3d.
 */
module pytorch.UpsampleNearest3dParityTest.

import pytorch.Tensor.{dispose, dtype, from_floats, shape}.
import pytorch.UpsampleNearest3dCompletion.{upsample_nearest3d, upsample_nearest3d_out}.

@test
pub upsample_nearest3d_forms_match(): Bool ->
    let input = from_floats([0.0, 1.0, 2.0, 3.0], [1, 1, 1, 2, 2]);
    let actual = upsample_nearest3d(input, [2, 4, 4]);
    let output = from_floats([], [0]);
    upsample_nearest3d_out(output, input, [2, 4, 4]);
    let valid =
        shape(actual) == [1, 1, 2, 4, 4]
            and shape(output) == [1, 1, 2, 4, 4]
            and dtype(actual) == dtype(input)
            and dtype(output) == dtype(input);
    (dispose(output); dispose(actual); dispose(input); valid).
