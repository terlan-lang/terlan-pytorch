module pytorch.ShapeBehaviorSupport.

import pytorch.Shape.{diag, expand, permute, reshape, roll, view}.
import pytorch.Tensor.{Float64, Strided, dispose, dtype, is_cuda, ones_device, shape}.

/**
 * Exercises representative generated shape, view, permutation, and indexing leaves.
 */
pub shape_contracts_on(device_name: String, expected_cuda: Bool): Bool ->
    let values = ones_device([2, 2], Float64, Strided, device_name);
    let diagonal = diag(values, 0);
    let expanded = expand(values, [2, 2], false);
    let permuted = permute(values, [1, 0]);
    let reshaped = reshape(values, [4]);
    let rolled = roll(values, [1], []);
    let viewed = view(values, [4]);
    let valid =
        shape(diagonal) == [2]
            and shape(expanded) == [2, 2]
            and shape(permuted) == [2, 2]
            and shape(reshaped) == [4]
            and shape(rolled) == [2, 2]
            and shape(viewed) == [4]
            and dtype(reshaped) == Float64
            and is_cuda(values) == expected_cuda;
    dispose(viewed);
    dispose(rolled);
    dispose(reshaped);
    dispose(permuted);
    dispose(expanded);
    dispose(diagonal);
    dispose(values);
    valid.
