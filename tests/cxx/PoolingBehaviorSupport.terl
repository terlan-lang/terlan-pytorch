    plane,
    [2, 2],
    [2, 2],
    [0, 0],
    false,
    true,
); avg_pool3d_backward_out(
    average_volume_gradient_output,
    volume_gradient,
    volume,
    [2, 2, 2],
    [2, 2, 2],
    [0, 0, 0],
    false,
    true,
); avg_pool2d_backward_out_divisor(
