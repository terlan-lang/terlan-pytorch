    let plane_samples = ones_device([1, 1, 2], Float64, Strided, device_name);
    let volume_samples = ones_device([1, 1, 3], Float64, Strided, device_name);
    let {adaptive_plane_values, adaptive_plane_indices} = adaptive_max_pool2d(plane, [2, 2]);
    let {adaptive_volume_values, adaptive_volume_indices} = adaptive_max_pool3d(volume, [2, 2, 2]);
    let {fractional_plane_values, fractional_plane_indices} = fractional_max_pool2d(plane, [2, 2], [2, 2], plane_samples);
    let {fractional_volume_values, fractional_volume_indices} = fractional_max_pool3d(volume, [2, 2, 2], [2, 2, 2], volume_samples);
    let {indexed_plane_values, indexed_plane_indices} = max_pool2d_with_indices(plane, [2, 2]);
    let {indexed_volume_values, indexed_volume_indices} = max_pool3d_with_indices(volume, [2, 2, 2]);
    let adaptive_average_line_output = ones_device([0], Float64, Strided, device_name);
    let adaptive_average_plane_output = ones_device([0], Float64, Strided, device_name);
    let adaptive_average_volume_output = ones_device([0], Float64, Strided, device_name);
    let adaptive_average_volume_gradient_output = ones_device([0], Float64, Strided, device_name);
    adaptive_avg_pool1d_out(adaptive_average_line_output, line, [2]);
    adaptive_avg_pool2d_out(adaptive_average_plane_output, plane, [2, 2]);
    adaptive_avg_pool3d_out(adaptive_average_volume_output, volume, [2, 2, 2]);
    adaptive_avg_pool3d_backward_out(
        adaptive_average_volume_gradient_output,
        volume_gradient,
        volume,
    );
    let adaptive_plane_output = ones_device([0], Float64, Strided, device_name);
    let adaptive_plane_indices_output = ones_device([0], Int64, Strided, device_name);
    let adaptive_volume_output = ones_device([0], Float64, Strided, device_name);
    let adaptive_volume_indices_output = ones_device([0], Int64, Strided, device_name);
    let adaptive_plane_gradient_output = ones_device([0], Float64, Strided, device_name);
    let adaptive_volume_gradient_output = ones_device([0], Float64, Strided, device_name);
    (adaptive_max_pool2d_out(adaptive_plane_output, adaptive_plane_indices_output, plane, [2, 2]); adaptive_max_pool3d_out(adaptive_volume_output, adaptive_volume_indices_output, volume, [2, 2, 2]); adaptive_max_pool2d_backward_out(
    adaptive_plane_gradient_output,
    plane_gradient,
    plane,
    adaptive_plane_indices,
); adaptive_max_pool3d_backward_out(
    adaptive_volume_gradient_output,
    volume_gradient,
    volume,
    adaptive_volume_indices,
); let average_line_output = ones_device([0], Float64, Strided, device_name);
let average_plane_output = ones_device([0], Float64, Strided, device_name);
let average_volume_output = ones_device([0], Float64, Strided, device_name);
let average_plane_divisor_output = ones_device([0], Float64, Strided, device_name);
let average_volume_divisor_output = ones_device([0], Float64, Strided, device_name);
