let average_volume_gradient_output = ones_device([0], Float64, Strided, device_name);
let average_plane_gradient_divisor_output = ones_device([0], Float64, Strided, device_name);
let average_volume_gradient_divisor_output = ones_device([0], Float64, Strided, device_name);
(avg_pool1d_out(average_line_output, line, [2], [], [0], false, true); avg_pool2d_out(average_plane_output, plane, [2, 2], [2, 2], [0, 0], false, true); avg_pool3d_out(average_volume_output, volume, [2, 2, 2], [2, 2, 2], [0, 0, 0], false, true); avg_pool2d_out_divisor(average_plane_divisor_output, plane, [2, 2], [2, 2], [0, 0], false, true, 4); avg_pool3d_out_divisor(
    average_volume_divisor_output,
    volume,
    [2, 2, 2],
    [2, 2, 2],
    [0, 0, 0],
    false,
    true,
    8,
); avg_pool2d_backward_out(
