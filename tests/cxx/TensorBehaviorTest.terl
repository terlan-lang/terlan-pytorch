@test
pub generated_cxx_unary_family_behavior(): Bool ->
    let original = ones([1]);
    let ceiled = ceil(original);
    let cloned = clone(ceiled);
    let floored = floor(cloned);
    let inverted = reciprocal(floored);
    let rounded = round(inverted);
    let signed = sign(rounded);
    let squared = square(signed);
    let truncated = trunc(squared);
    let scalar = item(truncated);
    let observed = scalar_to_int(scalar);
    dispose_scalar(scalar);
    dispose(truncated);
    dispose(squared);
    dispose(signed);
    dispose(rounded);
    dispose(inverted);
    dispose(floored);
    dispose(cloned);
    dispose(ceiled);
    dispose(original);
    case observed {
        Ok(value) -> value == 1;
        Err(_reason) -> false
    }.

@test
pub generated_cxx_owned_tensor_list_behavior(): Bool ->
    let tensor = ones([2, 3]);
    let rows = unbind(tensor);
    let columns = unbind(tensor, 1);
    dispose(tensor);
    owned_row_pair(rows) and owned_column_triplet(columns).

owned_row_pair(rows: List[Tensor]): Bool ->
    case rows {
        [first, second] -> validate_owned_row_pair(first, second);
        _ -> false
    }.

validate_owned_row_pair(first: Tensor, second: Tensor): Bool ->
    let valid = shape(first) == [3] and shape(second) == [3] and is_cpu(first) and is_cpu(second);
    dispose(second);
    dispose(first);
    valid.

owned_column_triplet(columns: List[Tensor]): Bool ->
    case columns {
        [first, second, third] -> validate_owned_column_triplet(first, second, third);
        _ -> false
    }.

validate_owned_column_triplet(first: Tensor, second: Tensor, third: Tensor): Bool ->
    let valid =
        shape(first) == [2]
            and shape(second) == [2]
            and shape(third) == [2]
            and is_cpu(first)
            and is_cpu(second)
            and is_cpu(third);
    dispose(third);
    dispose(second);
    dispose(first);
    valid.

