@test
pub generated_cxx_scalar_behavior(): Bool ->
    let tensor = ones([1]);
    let scaled = mul_int(tensor, 3);
    let scalar = item(scaled);
    let observed = scalar_to_int(scalar);
    dispose_scalar(scalar);
    dispose(scaled);
    dispose(tensor);
    case observed {
        Ok(value) -> value == 3;
        Err(_reason) -> false
    }.

@test
pub generated_cxx_optional_dtype_behavior(): Bool ->
    let tensor = ones_dtype([1], Float64);
    let selected_dtype = dtype(tensor);
    let scaled = mul_float(tensor, 3.5);
    let scalar = item(scaled);
    let observed = scalar_to_float(scalar);
    dispose_scalar(scalar);
    dispose(scaled);
    dispose(tensor);
    observed == 3.5 and selected_dtype == Float64.

@test
pub generated_cxx_optional_layout_behavior(): Bool ->
    let tensor = ones_layout([2, 2], Float64, Strided);
    let selected_dtype = dtype(tensor);
    let selected_layout = layout(tensor);
    let selected_rank = rank(tensor);
    let selected_element_count = element_count(tensor);
    let selected_shape = shape(tensor);
    let selected_strides = strides(tensor);
    let selected_flags =
        is_defined(tensor)
            and has_storage(tensor)
            and is_contiguous(tensor)
            and is_cpu(tensor)
            and not is_cuda(tensor)
            and not is_complex(tensor)
            and is_floating_point(tensor)
            and not is_quantized(tensor)
            and is_signed(tensor)
            and not is_sparse(tensor)
            and not requires_grad(tensor)
            and is_leaf(tensor);
    dispose(tensor);
    selected_dtype == Float64
        and selected_layout == Strided
        and selected_rank == 2
        and selected_element_count == 4
        and selected_shape == [2, 2]
        and selected_strides == [2, 1]
        and selected_flags.

@test
pub generated_cxx_optional_device_and_bool_behavior(): Bool ->
    let device_tensor = ones_device([2], Float64, Strided, "cpu");
    let options_tensor = ones_options([2], Float64, Strided, "cpu", false);
    let device_ok =
        dtype(device_tensor) == Float64
            and layout(device_tensor) == Strided
            and device(device_tensor) == "cpu";
    let options_ok =
        dtype(options_tensor) == Float64
            and layout(options_tensor) == Strided
            and device(options_tensor) == "cpu";
    dispose(options_tensor);
    dispose(device_tensor);
    device_ok and options_ok.

@test
pub generated_cxx_distance_behavior(): Bool ->
    let first = ones([1, 1]);
    let second = mul_float(first, 2.0);
    let cosine_explicit = cosine_similarity(first, second, 1, 1e-8);
    let cosine_default = cosine_similarity(first, second);
    let distance_explicit = pairwise_distance(first, second, 2.0, 0.000001, false);
    let distance_default = pairwise_distance(first, second);
    let cosine_explicit_scalar = item(cosine_explicit);
    let cosine_default_scalar = item(cosine_default);
    let distance_explicit_scalar = item(distance_explicit);
    let distance_default_scalar = item(distance_default);
    let cosine_explicit_value = scalar_to_float(cosine_explicit_scalar);
    let cosine_default_value = scalar_to_float(cosine_default_scalar);
    let distance_explicit_value = scalar_to_float(distance_explicit_scalar);
    let distance_default_value = scalar_to_float(distance_default_scalar);
    dispose_scalar(distance_default_scalar);
    dispose_scalar(distance_explicit_scalar);
    dispose_scalar(cosine_default_scalar);
    dispose_scalar(cosine_explicit_scalar);
    dispose(distance_default);
    dispose(distance_explicit);
    dispose(cosine_default);
    dispose(cosine_explicit);
    dispose(second);
    dispose(first);
    cosine_explicit_value == 1.0
        and cosine_default_value == 1.0
        and distance_explicit_value > 0.999
        and distance_explicit_value < 1.001
        and distance_default_value > 0.999
        and distance_default_value < 1.001.

@test
pub generated_cxx_regularization_behavior(): Bool ->
    let input = ones([1, 1, 1, 1]);
    let mask = ones_dtype([1, 1, 1, 1], Bool);
    let alpha = alpha_dropout(input, 0.5, false);
    let element = dropout(input, 0.5, false);
    let feature = feature_dropout(input, 0.5, false);
    let backward = native_dropout_backward(input, mask, 2.0);
    let alpha_scalar = item(alpha);
    let element_scalar = item(element);
    let feature_scalar = item(feature);
    let backward_scalar = item(backward);
    let valid =
        scalar_to_float(alpha_scalar) == 1.0
            and scalar_to_float(element_scalar) == 1.0
            and scalar_to_float(feature_scalar) == 1.0
            and scalar_to_float(backward_scalar) == 2.0;
    dispose_scalar(backward_scalar);
    dispose_scalar(feature_scalar);
    dispose_scalar(element_scalar);
    dispose_scalar(alpha_scalar);
    dispose(backward);
    dispose(feature);
    dispose(element);
    dispose(alpha);
    dispose(mask);
    dispose(input);
    valid.

@test
pub generated_cxx_dropout_completion_behavior(): Bool ->
    let input = ones([1, 1, 1, 1]);
    let feature = feature_alpha_dropout(input, 0.5, false);
    alpha_dropout_in_place(input, 0.5, false);
    dropout_in_place(input, 0.5, false);
    feature_alpha_dropout_in_place(input, 0.5, false);
    feature_dropout_in_place(input, 0.5, false);
    let input_scalar = item(input);
    let feature_scalar = item(feature);
    let valid = scalar_to_float(input_scalar) == 1.0 and scalar_to_float(feature_scalar) == 1.0;
    (dispose_scalar(feature_scalar); dispose_scalar(input_scalar); dispose(feature); dispose(input); valid).

@test
pub generated_cxx_glu_completion_behavior(): Bool ->
    let input = ones_dtype([1, 2], Float64);
    let gradient_glu = ones_dtype([1, 1], Float64);
    let input_tangent = ones_dtype([1, 2], Float64);
    let gradient_glu_tangent = ones_dtype([1, 1], Float64);
    let forward = ones_dtype([0], Float64);
    glu_out(forward, input, 1);
    let gradient_input = ones_dtype([0], Float64);
    (glu_backward_out(gradient_input, gradient_glu, input, 1); let forward_jvp = glu_jvp(forward, input, input_tangent, 1);
let forward_jvp_output = ones_dtype([0], Float64);
(glu_jvp_out(forward_jvp_output, forward, input, input_tangent, 1); let backward_jvp = glu_backward_jvp(gradient_input, gradient_glu, input, gradient_glu_tangent, input_tangent, 1);
let backward_jvp_output = ones_dtype([0], Float64);
(glu_backward_jvp_out(
    backward_jvp_output,
    gradient_input,
    gradient_glu,
    input,
    gradient_glu_tangent,
    input_tangent,
    1,
); let forward_valid = tensor_scalar_between(forward, 0.73, 0.74);
let forward_jvp_valid =
    tensor_scalar_between(forward_jvp, 0.92, 0.94)
        and tensor_scalar_between(forward_jvp_output, 0.92, 0.94);
let gradient_valid = glu_scalar_pair_between(tensor_split_sections(gradient_input, 2, 1), 0.73, 0.74, 0.19, 0.2);
let backward_jvp_valid =
    glu_scalar_pair_between(tensor_split_sections(backward_jvp, 2, 1), 0.92, 0.94, 0.29, 0.31)
        and glu_scalar_pair_between(tensor_split_sections(backward_jvp_output, 2, 1), 0.92, 0.94, 0.29, 0.31);
let shapes_valid =
    shape(input) == [1, 2]
        and shape(forward) == [1, 1]
        and shape(gradient_input) == [1, 2]
        and shape(forward_jvp) == [1, 1]
        and shape(backward_jvp) == [1, 2];
(dispose(backward_jvp_output); dispose(backward_jvp); dispose(forward_jvp_output); dispose(forward_jvp); dispose(gradient_input); dispose(forward); dispose(gradient_glu_tangent); dispose(input_tangent); dispose(gradient_glu); dispose(input); forward_valid and forward_jvp_valid and gradient_valid and backward_jvp_valid and shapes_valid)))).

@test
pub generated_cxx_shape_gradient_behavior(): Bool ->
    let matrix = ones_dtype([2, 2], Float64);
    let diagonal_result = diagonal(matrix, 0, 0, 1);
    let source = ones_dtype([2], Float64);
    let diagonal_scatter_output = ones_dtype([0], Float64);
    diagonal_scatter_out(diagonal_scatter_output, matrix, source, 0, 0, 1);
    let gradient = ones_dtype([2], Float64);
    let diagonal_gradient = diagonal_backward(gradient, [2, 2], 0, 0, 1);
    let diagonal_gradient_output = ones_dtype([0], Float64);
    (diagonal_backward_out(diagonal_gradient_output, gradient, [2, 2], 0, 0, 1); let selected_gradient = select_backward(gradient, [2, 2], 0, 0);
let selected_gradient_output = ones_dtype([0], Float64);
(select_backward_out(selected_gradient_output, gradient, [2, 2], 0, 0); let slice_gradient_input = ones_dtype([1, 2], Float64);
let sliced_gradient = slice_backward(slice_gradient_input, [2, 2], 0, 0, 1, 1);
let sliced_gradient_output = ones_dtype([0], Float64);
(slice_backward_out(sliced_gradient_output, slice_gradient_input, [2, 2], 0, 0, 1, 1); let unfold_gradient_input = ones_dtype([2, 2], Float64);
let unfolded_gradient = unfold_backward(unfold_gradient_input, [3], 0, 2, 1);
let unfolded_gradient_output = ones_dtype([0], Float64);
(unfold_backward_out(unfolded_gradient_output, unfold_gradient_input, [3], 0, 2, 1); let diagonal_values = glu_scalar_pair_between(tensor_split_sections(diagonal_result, 2, 0), 0.99, 1.01, 0.99, 1.01);
let shapes_valid =
    shape(diagonal_result) == [2]
        and shape(diagonal_scatter_output) == [2, 2]
        and shape(diagonal_gradient) == [2, 2]
        and shape(diagonal_gradient_output) == [2, 2]
        and shape(selected_gradient) == [2, 2]
        and shape(selected_gradient_output) == [2, 2]
        and shape(sliced_gradient) == [2, 2]
        and shape(sliced_gradient_output) == [2, 2]
        and shape(unfolded_gradient) == [3]
        and shape(unfolded_gradient_output) == [3];
let placement_valid =
    is_cpu(diagonal_result)
        and is_cpu(diagonal_scatter_output)
        and is_cpu(diagonal_gradient)
        and is_cpu(diagonal_gradient_output)
        and is_cpu(selected_gradient)
        and is_cpu(selected_gradient_output)
        and is_cpu(sliced_gradient)
        and is_cpu(sliced_gradient_output)
        and is_cpu(unfolded_gradient)
        and is_cpu(unfolded_gradient_output);
(dispose(unfolded_gradient_output); dispose(unfolded_gradient); dispose(unfold_gradient_input); dispose(sliced_gradient_output); dispose(sliced_gradient); dispose(slice_gradient_input); dispose(selected_gradient_output); dispose(selected_gradient); dispose(diagonal_gradient_output); dispose(diagonal_gradient); dispose(gradient); dispose(diagonal_scatter_output); dispose(source); dispose(diagonal_result); dispose(matrix); diagonal_values and shapes_valid and placement_valid))))).

@test
pub generated_cxx_padding_backward_completion_behavior(): Bool ->
    let input1 = ones_dtype([1, 1, 2], Float64);
    let gradient1 = ones_dtype([1, 1, 4], Float64);
    let reflection1 = reflection_pad1d_backward(gradient1, input1, [1, 1]);
    let replication1 = replication_pad1d_backward(gradient1, input1, [1, 1]);
    let reflection1_output = ones_dtype([0], Float64);
    let replication1_output = ones_dtype([0], Float64);
    reflection_pad1d_backward_out(reflection1_output, gradient1, input1, [1, 1]);
    replication_pad1d_backward_out(replication1_output, gradient1, input1, [1, 1]);
    let input2 = ones_dtype([1, 1, 2, 2], Float64);
    let gradient2 = ones_dtype([1, 1, 4, 4], Float64);
    let reflection2 = reflection_pad2d_backward(gradient2, input2, [1, 1, 1, 1]);
    let replication2 = replication_pad2d_backward(gradient2, input2, [1, 1, 1, 1]);
    let reflection2_output = ones_dtype([0], Float64);
    let replication2_output = ones_dtype([0], Float64);
    (reflection_pad2d_backward_out(reflection2_output, gradient2, input2, [1, 1, 1, 1]); replication_pad2d_backward_out(replication2_output, gradient2, input2, [1, 1, 1, 1]); let input3 = ones_dtype([1, 1, 2, 2, 2], Float64);
let gradient3 = ones_dtype([1, 1, 4, 4, 4], Float64);
