activation_pair(
    first: Tensor,
    second: Tensor,
    first_lower: Float,
    first_upper: Float,
    second_lower: Float,
    second_upper: Float,
): Bool ->
    let valid =
        is_cpu(first)
            and is_cpu(second)
            and tensor_scalar_between(first, first_lower, first_upper)
            and tensor_scalar_between(second, second_lower, second_upper);
    dispose(second);
    dispose(first);
    valid.

validate_cpu_where_indices(values: List[Tensor]): Bool ->
    case values {
        [indices] -> validate_cpu_where_index(indices);
        _ -> false
    }.

validate_cpu_where_index(indices: Tensor): Bool ->
    let valid = shape(indices) == [1] and dtype(indices) == Int64 and is_cpu(indices);
    dispose(indices);
    valid.

validate_cpu_grid_pair(values: List[Tensor], expected_shape: List[Int]): Bool ->
    case values {
        [first, second] -> validate_cpu_grid_values(first, second, expected_shape);
        _ -> false
    }.

validate_cpu_grid_values(first: Tensor, second: Tensor, expected_shape: List[Int]): Bool ->
    let valid =
        shape(first) == expected_shape
            and shape(second) == expected_shape
            and is_cpu(first)
            and is_cpu(second);
    dispose(second);
    dispose(first);
    valid.

owned_partition_pair(parts: List[Tensor], first_size: Int, second_size: Int): Bool ->
    case parts {
        [first, second] -> validate_owned_partition_pair(first, second, first_size, second_size);
        _ -> false
    }.

validate_owned_partition_pair(
    first: Tensor,
    second: Tensor,
    first_size: Int,
    second_size: Int,
): Bool ->
    let valid =
        shape(first) == [first_size, 2]
            and shape(second) == [second_size, 2]
            and is_cpu(first)
            and is_cpu(second);
    dispose(second);
    dispose(first);
    valid.

owned_partition_triplet(
    parts: List[Tensor],
    first_size: Int,
    second_size: Int,
    third_size: Int,
): Bool ->
    case parts {
        [first, second, third] ->
            validate_owned_partition_triplet(
                first,
                second,
                third,
                first_size,
                second_size,
                third_size,
            );
        _ -> false
    }.

validate_owned_partition_triplet(
    first: Tensor,
    second: Tensor,
    third: Tensor,
    first_size: Int,
    second_size: Int,
    third_size: Int,
): Bool ->
    let valid =
        shape(first) == [first_size, 2]
            and shape(second) == [second_size, 2]
            and shape(third) == [third_size, 2]
            and is_cpu(first)
            and is_cpu(second)
            and is_cpu(third);
    dispose(third);
    dispose(second);
    dispose(first);
    valid.

owned_partition_shape_pair(parts: List[Tensor], expected_shape: List[Int]): Bool ->
    case parts {
        [first, second] -> validate_owned_partition_shape_pair(first, second, expected_shape);
        _ -> false
    }.

validate_owned_partition_shape_pair(
    first: Tensor,
    second: Tensor,
    expected_shape: List[Int],
): Bool ->
    let valid =
        shape(first) == expected_shape
            and shape(second) == expected_shape
            and is_cpu(first)
            and is_cpu(second);
    dispose(second);
    dispose(first);
    valid.

@test
pub generated_cxx_indexing_behavior(): Bool ->
    // Keep this smoke test on the generated CXX scalar path.  The full
    // indexing overload matrix is covered by the public parity fixtures;
    // this fixture only needs to prove owned index tensors cross the CXX
    // boundary without relying on dtype atoms in a generated test module.
    let input = ones([1]);
    let index_seed = from_ints([0], [1]);
    let ordered = argsort_stable(input, true, 0, false);
    let selected = index_select(input, 0, index_seed);
    let copied = index_copy(input, 0, index_seed, input);
    let shapes_valid =
        shape(ordered) == [1]
        and shape(selected) == [1]
        and shape(copied) == [1]
        and is_cpu(ordered)
        and is_cpu(selected)
        and is_cpu(copied);
(dispose(copied); dispose(selected); dispose(ordered); dispose(index_seed); dispose(input); shapes_valid).

