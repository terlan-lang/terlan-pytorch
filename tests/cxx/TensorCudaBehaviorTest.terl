cuda_activation_pair(
    first: Tensor,
    second: Tensor,
    first_lower: Float,
    first_upper: Float,
    second_lower: Float,
    second_upper: Float,
): Bool ->
    let valid =
        is_cuda(first)
            and is_cuda(second)
            and cuda_tensor_scalar_between(first, first_lower, first_upper)
            and cuda_tensor_scalar_between(second, second_lower, second_upper);
    dispose(second);
    dispose(first);
    valid.

validate_cuda_where_indices(values: List[Tensor]): Bool ->
    case values {
        [indices] -> validate_cuda_where_index(indices);
        _ -> false
    }.

validate_cuda_where_index(indices: Tensor): Bool ->
    let valid = shape(indices) == [1] and dtype(indices) == Int64 and is_cuda(indices);
    dispose(indices);
    valid.

validate_cuda_grid_pair(values: List[Tensor]): Bool ->
    case values {
        [first, second] -> validate_cuda_grid_values(first, second);
        _ -> false
    }.

validate_cuda_grid_values(first: Tensor, second: Tensor): Bool ->
    let valid = shape(first) == [3, 2] and shape(second) == [3, 2] and is_cuda(first) and is_cuda(second);
    dispose(second);
    dispose(first);
    valid.

validate_cuda_partition_pair(parts: List[Tensor]): Bool ->
    case parts {
        [first, second] -> validate_cuda_pair_values(first, second);
        _ -> false
    }.

validate_cuda_pair_values(first: Tensor, second: Tensor): Bool ->
    let valid = shape(first) == [2, 2] and shape(second) == [2, 2] and is_cuda(first) and is_cuda(second);
    dispose(second);
    dispose(first);
    valid.

validate_cuda_partition_triplet(parts: List[Tensor]): Bool ->
    case parts {
        [first, second, third] -> validate_cuda_triplet_values(first, second, third);
        _ -> false
    }.

validate_cuda_triplet_values(first: Tensor, second: Tensor, third: Tensor): Bool ->
    let valid =
        shape(first) == [1, 2]
            and shape(second) == [2, 2]
            and shape(third) == [1, 2]
            and is_cuda(first)
            and is_cuda(second)
            and is_cuda(third);
    dispose(third);
    dispose(second);
    dispose(first);
    valid.

validate_cuda_shape_pair(parts: List[Tensor], expected_shape: List[Int]): Bool ->
    case parts {
        [first, second] -> validate_cuda_shape_values(first, second, expected_shape);
        _ -> false
    }.

validate_cuda_shape_values(first: Tensor, second: Tensor, expected_shape: List[Int]): Bool ->
    let valid =
        shape(first) == expected_shape
            and shape(second) == expected_shape
            and is_cuda(first)
            and is_cuda(second);
    dispose(second);
    dispose(first);
    valid.

