cuda_tensor_scalar_between(tensor: Tensor, lower: Float, upper: Float): Bool ->
    let scalar = item(tensor);
    let value = scalar_to_float(scalar);
    dispose_scalar(scalar);
    value > lower and value < upper.

cuda_glu_scalar_pair_between(
    parts: List[Tensor],
    first_lower: Float,
    first_upper: Float,
    second_lower: Float,
    second_upper: Float,
): Bool ->
    case parts {
        [first, second] ->
            let valid =
                is_cuda(first)
                    and is_cuda(second)
                    and cuda_tensor_scalar_between(first, first_lower, first_upper)
                    and cuda_tensor_scalar_between(second, second_lower, second_upper);
            (dispose(second); dispose(first); valid);
        _ -> false
    }.

