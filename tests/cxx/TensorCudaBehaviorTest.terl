@test
pub generated_cxx_cuda_tensor_behavior(): Bool ->
    let tensor = ones_device([1], Float64, Strided, "cuda:0");
    let placement_ok = is_cuda(tensor) and not is_cpu(tensor) and device(tensor) == "cuda:0";
    let properties_ok =
        has_storage(tensor)
            and is_floating_point(tensor)
            and dtype(tensor) == Float64
            and layout(tensor) == Strided;
    let scaled = mul_float(tensor, 2.5);
    let scalar = item(scaled);
    let observed = scalar_to_float(scalar);
    dispose_scalar(scalar);
    dispose(scaled);
    dispose(tensor);
    placement_ok and properties_ok and observed == 2.5.

@test
pub generated_cxx_cuda_unary_family_behavior(): Bool ->
    let original = ones_device([1], Float64, Strided, "cuda:0");
    let ceiled = ceil(original);
    let cloned = clone(ceiled);
    let floored = floor(cloned);
    let inverted = reciprocal(floored);
    let rounded = round(inverted);
    let signed = sign(rounded);
    let squared = square(signed);
    let truncated = trunc(squared);
    let scalar = item(truncated);
    let observed = scalar_to_float(scalar);
    let placement_ok = is_cuda(truncated);
    dispose_scalar(scalar);
    dispose(truncated);
    dispose(squared);
    dispose(signed);
    dispose(rounded);
    dispose(inverted);
    dispose(floored);
    dispose(cloned);
    dispose(ceiled);
    dispose(original);
    placement_ok and observed == 1.0.

@test
pub generated_cxx_cuda_distance_behavior(): Bool ->
    let first = ones_device([1, 1], Float64, Strided, "cuda:0");
    let second = mul_float(first, 2.0);
    let cosine = cosine_similarity(first, second, 1, 1e-8);
    let distance = pairwise_distance(first, second, 2.0, 0.000001, false);
    let cosine_scalar = item(cosine);
    let distance_scalar = item(distance);
    let cosine_value = scalar_to_float(cosine_scalar);
    let distance_value = scalar_to_float(distance_scalar);
    let placement_ok = is_cuda(cosine) and is_cuda(distance);
    dispose_scalar(distance_scalar);
    dispose_scalar(cosine_scalar);
    dispose(distance);
    dispose(cosine);
    dispose(second);
    dispose(first);
    placement_ok and cosine_value == 1.0 and distance_value > 0.999 and distance_value < 1.001.

@test
pub generated_cxx_cuda_regularization_behavior(): Bool ->
    let input = ones_device([1, 1, 1, 1], Float64, Strided, "cuda:0");
    let mask = ones_device([1, 1, 1, 1], Bool, Strided, "cuda:0");
    let alpha = alpha_dropout(input, 0.5, false);
    let element = dropout(input, 0.5, false);
    let feature = feature_dropout(input, 0.5, false);
    let backward = native_dropout_backward(input, mask, 2.0);
    let alpha_scalar = item(alpha);
    let element_scalar = item(element);
    let feature_scalar = item(feature);
    let backward_scalar = item(backward);
    let valid =
        is_cuda(alpha)
            and is_cuda(element)
            and is_cuda(feature)
            and is_cuda(backward)
            and scalar_to_float(alpha_scalar) == 1.0
            and scalar_to_float(element_scalar) == 1.0
            and scalar_to_float(feature_scalar) == 1.0
            and scalar_to_float(backward_scalar) == 2.0;
    dispose_scalar(backward_scalar);
    dispose_scalar(feature_scalar);
    dispose_scalar(element_scalar);
    dispose_scalar(alpha_scalar);
    dispose(backward);
    dispose(feature);
    dispose(element);
    dispose(alpha);
    dispose(mask);
    dispose(input);
    valid.

@test
pub generated_cxx_cuda_dropout_completion_behavior(): Bool ->
    let input = ones_device([1, 1, 1, 1], Float64, Strided, "cuda:0");
    let feature = feature_alpha_dropout(input, 0.5, false);
    alpha_dropout_in_place(input, 0.5, false);
    dropout_in_place(input, 0.5, false);
    feature_alpha_dropout_in_place(input, 0.5, false);
    feature_dropout_in_place(input, 0.5, false);
    let input_scalar = item(input);
    let feature_scalar = item(feature);
    let valid =
        is_cuda(input)
            and is_cuda(feature)
            and scalar_to_float(input_scalar) == 1.0
            and scalar_to_float(feature_scalar) == 1.0;
    (dispose_scalar(feature_scalar); dispose_scalar(input_scalar); dispose(feature); dispose(input); valid).

@test
pub generated_cxx_cuda_glu_completion_behavior(): Bool ->
    let input = ones_device([1, 2], Float64, Strided, "cuda:0");
    let gradient_glu = ones_device([1, 1], Float64, Strided, "cuda:0");
    let input_tangent = ones_device([1, 2], Float64, Strided, "cuda:0");
    let gradient_glu_tangent = ones_device([1, 1], Float64, Strided, "cuda:0");
    let forward = ones_device([0], Float64, Strided, "cuda:0");
    glu_out(forward, input, 1);
    let gradient_input = ones_device([0], Float64, Strided, "cuda:0");
    (glu_backward_out(gradient_input, gradient_glu, input, 1); let forward_jvp = glu_jvp(forward, input, input_tangent, 1);
let forward_jvp_output = ones_device([0], Float64, Strided, "cuda:0");
(glu_jvp_out(forward_jvp_output, forward, input, input_tangent, 1); let backward_jvp = glu_backward_jvp(gradient_input, gradient_glu, input, gradient_glu_tangent, input_tangent, 1);
let backward_jvp_output = ones_device([0], Float64, Strided, "cuda:0");
(glu_backward_jvp_out(
    backward_jvp_output,
    gradient_input,
    gradient_glu,
    input,
    gradient_glu_tangent,
    input_tangent,
    1,
); let forward_valid = cuda_tensor_scalar_between(forward, 0.73, 0.74);
let forward_jvp_valid =
    cuda_tensor_scalar_between(forward_jvp, 0.92, 0.94)
        and cuda_tensor_scalar_between(forward_jvp_output, 0.92, 0.94);
let gradient_valid =
    cuda_glu_scalar_pair_between(
        tensor_split_indices(gradient_input, [1], 1),
        0.73,
        0.74,
        0.19,
        0.2,
    );
let backward_jvp_valid =
    cuda_glu_scalar_pair_between(tensor_split_indices(backward_jvp, [1], 1), 0.92, 0.94, 0.29, 0.31)
        and cuda_glu_scalar_pair_between(
    tensor_split_indices(backward_jvp_output, [1], 1),
    0.92,
    0.94,
    0.29,
    0.31,
);
let placement_valid =
    is_cuda(input)
        and is_cuda(forward)
        and is_cuda(gradient_input)
        and is_cuda(forward_jvp)
        and is_cuda(backward_jvp);
(dispose(backward_jvp_output); dispose(backward_jvp); dispose(forward_jvp_output); dispose(forward_jvp); dispose(gradient_input); dispose(forward); dispose(gradient_glu_tangent); dispose(input_tangent); dispose(gradient_glu); dispose(input); forward_valid and forward_jvp_valid and gradient_valid and backward_jvp_valid and placement_valid)))).

@test
pub generated_cxx_cuda_shape_gradient_behavior(): Bool ->
    let matrix = ones_device([2, 2], Float64, Strided, "cuda:0");
    let diagonal_result = diagonal(matrix, 0, 0, 1);
    let source = ones_device([2], Float64, Strided, "cuda:0");
    let diagonal_scatter_output = ones_device([0], Float64, Strided, "cuda:0");
    diagonal_scatter_out(diagonal_scatter_output, matrix, source, 0, 0, 1);
    let gradient = ones_device([2], Float64, Strided, "cuda:0");
    let diagonal_gradient = diagonal_backward(gradient, [2, 2], 0, 0, 1);
    let diagonal_gradient_output = ones_device([0], Float64, Strided, "cuda:0");
    (diagonal_backward_out(diagonal_gradient_output, gradient, [2, 2], 0, 0, 1); let selected_gradient = select_backward(gradient, [2, 2], 0, 0);
let selected_gradient_output = ones_device([0], Float64, Strided, "cuda:0");
(select_backward_out(selected_gradient_output, gradient, [2, 2], 0, 0); let slice_gradient_input = ones_device([1, 2], Float64, Strided, "cuda:0");
let sliced_gradient = slice_backward(slice_gradient_input, [2, 2], 0, 0, 1, 1);
let sliced_gradient_output = ones_device([0], Float64, Strided, "cuda:0");
(slice_backward_out(sliced_gradient_output, slice_gradient_input, [2, 2], 0, 0, 1, 1); let unfold_gradient_input = ones_device([2, 2], Float64, Strided, "cuda:0");
let unfolded_gradient = unfold_backward(unfold_gradient_input, [3], 0, 2, 1);
let unfolded_gradient_output = ones_device([0], Float64, Strided, "cuda:0");
(unfold_backward_out(unfolded_gradient_output, unfold_gradient_input, [3], 0, 2, 1); let diagonal_values =
    cuda_glu_scalar_pair_between(
        tensor_split_indices(diagonal_result, [1], 0),
        0.99,
        1.01,
        0.99,
        1.01,
    );
let shapes_valid =
    shape(diagonal_result) == [2]
        and shape(diagonal_scatter_output) == [2, 2]
        and shape(diagonal_gradient) == [2, 2]
        and shape(diagonal_gradient_output) == [2, 2]
        and shape(selected_gradient) == [2, 2]
        and shape(selected_gradient_output) == [2, 2]
        and shape(sliced_gradient) == [2, 2]
        and shape(sliced_gradient_output) == [2, 2]
        and shape(unfolded_gradient) == [3]
        and shape(unfolded_gradient_output) == [3];
let placement_valid =
    is_cuda(diagonal_result)
        and is_cuda(diagonal_scatter_output)
        and is_cuda(diagonal_gradient)
        and is_cuda(diagonal_gradient_output)
        and is_cuda(selected_gradient)
        and is_cuda(selected_gradient_output)
        and is_cuda(sliced_gradient)
        and is_cuda(sliced_gradient_output)
        and is_cuda(unfolded_gradient)
        and is_cuda(unfolded_gradient_output);
(dispose(unfolded_gradient_output); dispose(unfolded_gradient); dispose(unfold_gradient_input); dispose(sliced_gradient_output); dispose(sliced_gradient); dispose(slice_gradient_input); dispose(selected_gradient_output); dispose(selected_gradient); dispose(diagonal_gradient_output); dispose(diagonal_gradient); dispose(gradient); dispose(diagonal_scatter_output); dispose(source); dispose(diagonal_result); dispose(matrix); diagonal_values and shapes_valid and placement_valid))))).

@test
pub generated_cxx_cuda_padding_backward_completion_behavior(): Bool ->
    let input1 = ones_device([1, 1, 2], Float64, Strided, "cuda:0");
    let gradient1 = ones_device([1, 1, 4], Float64, Strided, "cuda:0");
    let reflection1 = reflection_pad1d_backward(gradient1, input1, [1, 1]);
    let replication1 = replication_pad1d_backward(gradient1, input1, [1, 1]);
    let reflection1_output = ones_device([0], Float64, Strided, "cuda:0");
    let replication1_output = ones_device([0], Float64, Strided, "cuda:0");
    reflection_pad1d_backward_out(reflection1_output, gradient1, input1, [1, 1]);
    replication_pad1d_backward_out(replication1_output, gradient1, input1, [1, 1]);
    let input2 = ones_device([1, 1, 2, 2], Float64, Strided, "cuda:0");
    let gradient2 = ones_device([1, 1, 4, 4], Float64, Strided, "cuda:0");
    let reflection2 = reflection_pad2d_backward(gradient2, input2, [1, 1, 1, 1]);
    let replication2 = replication_pad2d_backward(gradient2, input2, [1, 1, 1, 1]);
    let reflection2_output = ones_device([0], Float64, Strided, "cuda:0");
    let replication2_output = ones_device([0], Float64, Strided, "cuda:0");
    (reflection_pad2d_backward_out(reflection2_output, gradient2, input2, [1, 1, 1, 1]); replication_pad2d_backward_out(replication2_output, gradient2, input2, [1, 1, 1, 1]); let input3 = ones_device([1, 1, 2, 2, 2], Float64, Strided, "cuda:0");
let gradient3 = ones_device([1, 1, 4, 4, 4], Float64, Strided, "cuda:0");
let reflection3 = reflection_pad3d_backward(gradient3, input3, [1, 1, 1, 1, 1, 1]);
let replication3 = replication_pad3d_backward(gradient3, input3, [1, 1, 1, 1, 1, 1]);
let reflection3_output = ones_device([0], Float64, Strided, "cuda:0");
let replication3_output = ones_device([0], Float64, Strided, "cuda:0");
(reflection_pad3d_backward_out(reflection3_output, gradient3, input3, [1, 1, 1, 1, 1, 1]); replication_pad3d_backward_out(replication3_output, gradient3, input3, [1, 1, 1, 1, 1, 1]); let shapes_valid =
    shape(reflection1) == [1, 1, 2]
        and shape(replication1) == [1, 1, 2]
        and shape(reflection1_output) == [1, 1, 2]
        and shape(replication1_output) == [1, 1, 2]
        and shape(reflection2) == [1, 1, 2, 2]
        and shape(replication2) == [1, 1, 2, 2]
