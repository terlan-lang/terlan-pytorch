            and is_cuda(trapz_coordinates)
            and is_cuda(divergence);
    dispose(divergence);
    dispose(trapz_coordinates);
    dispose(trapz_spacing);
    dispose(trapezoid_coordinates);
    dispose(trapezoid_float);
    dispose(trapezoid_int);
    dispose(cumulative_x);
    dispose(cumulative_float);
    dispose(cumulative_int);
    dispose(x);
    dispose(y);
    cumulative_valid and scalar_valid and shapes_valid and placement_valid.

