@test
pub generated_cxx_cuda_loss_behavior(): Bool ->
    let input = ones_device([1, 1], Float64, Strided, "cuda:0");
    let target = ones_device([1, 1], Float64, Strided, "cuda:0");
    let label = ones_device([1], Float64, Strided, "cuda:0");
    let gradient = ones_device([1, 1], Float64, Strided, "cuda:0");
    let zero_losses =
        cuda_activation_pair(
            cosine_embedding_loss(input, target, label, 0.0, 1),
            huber_loss(input, target, 1, 1.0),
            -0.01,
            0.01,
            -0.01,
            0.01,
        );
    let unit_losses =
        cuda_activation_pair(
            hinge_embedding_loss(input, label, 1.0, 1),
            triplet_margin_loss(input, target, target, 1.0, 2.0, 0.000001, false, 1),
            0.99,
            1.01,
            0.99,
            1.01,
        );
    let other_zero_losses =
        cuda_activation_pair(
            l1_loss(input, target, 1),
            margin_ranking_loss(input, target, label, 0.0, 1),
            -0.01,
            0.01,
            -0.01,
            0.01,
        );
    let scalar_losses =
        cuda_activation_pair(
            poisson_nll_loss(input, target, true, false, 1e-8, 1),
            soft_margin_loss(input, target, 1),
            1.71,
            1.72,
            0.31,
            0.32,
        );
    let backward_losses =
        cuda_activation_pair(
            huber_loss_backward(gradient, input, target, 1, 1.0),
            smooth_l1_loss_backward(gradient, input, target, 1, 1.0),
            -0.01,
            0.01,
            -0.01,
            0.01,
        );
    let smooth_loss = smooth_l1_loss(input, target, 1, 1.0);
    let smooth_valid = cuda_tensor_scalar_between(smooth_loss, -0.01, 0.01);
    dispose(smooth_loss);
    let huber_output = ones_device([0], Float64, Strided, "cuda:0");
    let huber_backward_output = ones_device([0], Float64, Strided, "cuda:0");
    (huber_loss_out(huber_output, input, target, 1, 1.0); huber_loss_backward_out(huber_backward_output, gradient, input, target, 1, 1.0); let huber_outputs = cuda_activation_pair(huber_output, huber_backward_output, -0.01, 0.01, -0.01, 0.01);
let mse_output = ones_device([0], Float64, Strided, "cuda:0");
let mse_backward_output = ones_device([0], Float64, Strided, "cuda:0");
(mse_loss_out(mse_output, input, target, 1); mse_loss_backward_out(mse_backward_output, gradient, input, target, 1); let mse_outputs = cuda_activation_pair(mse_output, mse_backward_output, -0.01, 0.01, -0.01, 0.01);
let smooth_output = ones_device([0], Float64, Strided, "cuda:0");
let smooth_backward_output = ones_device([0], Float64, Strided, "cuda:0");
(smooth_l1_loss_out(smooth_output, input, target, 1, 1.0); smooth_l1_loss_backward_out(smooth_backward_output, gradient, input, target, 1, 1.0); let smooth_outputs = cuda_activation_pair(smooth_output, smooth_backward_output, -0.01, 0.01, -0.01, 0.01);
let soft_output = ones_device([0], Float64, Strided, "cuda:0");
