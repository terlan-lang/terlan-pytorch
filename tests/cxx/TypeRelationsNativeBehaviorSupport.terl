module pytorch.TypeRelationsNativeBehaviorSupport.

import pytorch.ShapeCompletion.{zero}.
import pytorch.Tensor.{Complex128, Float64, Int32, Strided, UInt8, dispose, is_cuda, mul_float, ones_device, requires_grad_in_place}.
import pytorch.TypeRelationsNative.{allclose_native, can_cast_native, equal_native, get_device_native, is_complex_native, is_conj_native, is_distributed_native, is_floating_point_native, is_inference_native, is_leaf_native, is_neg_native, is_nonzero_native, is_same_size_native, is_set_to_native, is_signed_native, output_nr_native, promote_types_native, result_type_scalar_native, result_type_scalar_scalar_native, result_type_scalar_tensor_native, result_type_tensor_native, retain_grad_native, retains_grad_native, size_dimension_native, stride_dimension_native}.
import pytorch.View.{alias, conj}.

/**
 * Executes exact equality, shape equality, and configured tolerance queries.
 */
pub type_relation_comparisons_on(device_name: String): Bool ->
    let expected_cuda = device_name == "cuda:0";
    let left = ones_device([2], Float64, Strided, device_name);
    let exact = ones_device([2], Float64, Strided, device_name);
    let near = mul_float(left, 1.0001);
    let matrix = ones_device([1, 2], Float64, Strided, device_name);
    let valid =
        equal_native(left, exact)
            and not equal_native(left, near)
            and is_same_size_native(left, near)
            and not is_same_size_native(left, matrix)
            and not allclose_native(left, near, 0.00001, 1e-8, false)
            and allclose_native(left, near, 0.001, 0.0, false)
            and is_cuda(near) == expected_cuda;
    dispose(matrix);
    dispose(near);
    dispose(exact);
    dispose(left);
    valid.

/**
 * Executes tensor dtype, view-bit, distribution, inference, and leaf predicates.
 */
pub type_relation_properties_on(device_name: String): Bool ->
    let expected_cuda = device_name == "cuda:0";
    let vector = ones_device([2], Float64, Strided, device_name);
    let unsigned_value = ones_device([2], UInt8, Strided, device_name);
    let complex_value = ones_device([2], Complex128, Strided, device_name);
    let conjugated = conj(complex_value);
    let valid =
        not is_complex_native(vector)
            and is_complex_native(complex_value)
            and not is_conj_native(complex_value)
            and is_conj_native(conjugated)
            and not is_distributed_native(vector)
            and is_floating_point_native(vector)
            and not is_floating_point_native(complex_value)
            and not is_inference_native(vector)
            and is_leaf_native(vector)
            and not is_neg_native(vector)
            and is_signed_native(vector)
            and not is_signed_native(unsigned_value)
            and is_cuda(conjugated) == expected_cuda;
    dispose(conjugated);
    dispose(complex_value);
    dispose(unsigned_value);
    dispose(vector);
    valid.

/**
 * Executes scalar truth-value extraction for nonzero and zero tensors.
 */
pub type_relation_nonzero_on(device_name: String): Bool ->
    let truth = ones_device([], Float64, Strided, device_name);
    let falsehood = zero(truth);
    let valid = is_nonzero_native(truth) and not is_nonzero_native(falsehood);
    dispose(falsehood);
    dispose(truth);
    valid.

/**
 * Executes exact shared-storage-view identity checks.
 */
pub type_relation_storage_identity_on(device_name: String): Bool ->
    let vector = ones_device([2], Float64, Strided, device_name);
    let same_view = alias(vector);
    let separate = ones_device([2], Float64, Strided, device_name);
    let valid = is_set_to_native(vector, same_view) and not is_set_to_native(vector, separate);
    dispose(separate);
    dispose(same_view);
    dispose(vector);
    valid.

/**
 * Executes exact backend device, output number, size, and stride queries.
 */
pub type_relation_geometry_on(device_name: String): Bool ->
    let expected_cuda = device_name == "cuda:0";
    let expected_device_index =
        if {
            expected_cuda -> 0;
            true -> -1
        };
    let matrix = ones_device([1, 2], Float64, Strided, device_name);
    let valid =
        get_device_native(matrix) == expected_device_index
            and output_nr_native(matrix) == 0
            and size_dimension_native(matrix, -1) == 2
            and size_dimension_native(matrix, 0) == 1
            and stride_dimension_native(matrix, -1) == 1
            and stride_dimension_native(matrix, 0) == 2;
    dispose(matrix);
    valid.

/**
 * Executes representative safe-cast and promotion rules over exact dtype tags.
 */
pub type_relation_dtype_rules(): Bool ->
    can_cast_native(3, 4)
        and can_cast_native(4, 6)
        and not can_cast_native(6, 4)
        and not can_cast_native(9, 6)
        and can_cast_native(6, 9)
        and promote_types_native(3, 6) == 6
        and promote_types_native(5, 6) == 6
        and promote_types_native(9, 7) == 10
        and promote_types_native(0, 1) == 2.

/**
 * Executes all four exact result_type overloads, including the permuted Scalar/Tensor call.
 */
pub type_relation_result_types_on(device_name: String): Bool ->
    let expected_cuda = device_name == "cuda:0";
    let integer32 = ones_device([2], Int32, Strided, device_name);
    let floating64 = ones_device([2], Float64, Strided, device_name);
    let valid =
        result_type_tensor_native(integer32, floating64) == 7
            and result_type_scalar_native(integer32, false, 0, 1.5) == 6
            and result_type_scalar_tensor_native(floating64, false, 0, 1.5) == 7
            and result_type_scalar_scalar_native(true, 1, 0.0, false, 0, 1.5) == 6
            and is_cuda(floating64) == expected_cuda;
    dispose(floating64);
    dispose(integer32);
    valid.

/**
 * Executes the valid non-leaf retain_grad state transition.
 */
pub type_relation_retain_grad_on(device_name: String): Bool ->
    let expected_cuda = device_name == "cuda:0";
    let leaf = ones_device([2], Float64, Strided, device_name);
    requires_grad_in_place(leaf, true);
    let retained = mul_float(leaf, 2.0);
    let before = is_leaf_native(leaf) and not is_leaf_native(retained) and not retains_grad_native(retained);
    (retain_grad_native(retained); let valid = before and retains_grad_native(retained) and is_cuda(retained) == expected_cuda; (dispose(retained); dispose(leaf); valid)).
