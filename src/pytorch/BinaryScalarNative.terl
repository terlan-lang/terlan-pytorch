/**
 * Writes a selected two-tensor binary operation into retained output storage.
 */
pub binary_tensor_out(output: Tensor, left: Tensor, operation: Int, right: Tensor): Unit ->
    if {
        operation == 0 -> binary_tensor_out_bitwise_and(output, left, right);
        operation == 1 -> binary_tensor_out_bitwise_or(output, left, right);
        operation == 2 -> binary_tensor_out_bitwise_xor(output, left, right);
        operation == 3 -> binary_tensor_out_bitwise_left_shift(output, left, right);
        operation == 4 -> binary_tensor_out_bitwise_right_shift(output, left, right);
        operation == 5 -> binary_tensor_out_remainder(output, left, right);
        operation == 6 -> binary_tensor_out_pow(output, left, right);
        operation == 7 -> binary_tensor_out_float_power(output, left, right);
        operation == 8 -> binary_tensor_out_mul(output, left, right);
        operation == 9 -> binary_tensor_out_floor_divide(output, left, right);
        operation == 10 -> binary_tensor_out_xlogy(output, left, right);
        operation == 11 -> binary_tensor_out_eq(output, left, right);
        operation == 12 -> binary_tensor_out_ne(output, left, right);
        operation == 13 -> binary_tensor_out_lt(output, left, right);
        operation == 14 -> binary_tensor_out_le(output, left, right);
        operation == 15 -> binary_tensor_out_gt(output, left, right);
        operation == 16 -> binary_tensor_out_ge(output, left, right);
        true -> let _failed = fail(exit_reason(7120));
        binary_tensor_out_bitwise_and(output, left, right)
    }.

