): Unit ->
    if {
        mode == 0 -> scatter_tensor_in_src(input, dimension, index, source);
        mode == 1 and reduction == 0 -> scatter_tensor_in_legacy_add(input, dimension, index, source, "add");
        mode == 1 and reduction == 1 -> scatter_tensor_in_legacy_multiply(input, dimension, index, source, "multiply");
        mode == 2 -> scatter_tensor_in_add(input, dimension, index, source);
        mode == 3 and reduction == 0 -> scatter_tensor_in_modern_sum(input, dimension, index, source, "sum", include_self);
        mode == 3 and reduction == 1 -> scatter_tensor_in_modern_prod(input, dimension, index, source, "prod", include_self);
        mode == 3 and reduction == 2 -> scatter_tensor_in_modern_mean(input, dimension, index, source, "mean", include_self);
        mode == 3 and reduction == 3 -> scatter_tensor_in_modern_amax(input, dimension, index, source, "amax", include_self);
        mode == 3 and reduction == 4 -> scatter_tensor_in_modern_amin(input, dimension, index, source, "amin", include_self);
        true -> fail(exit_reason(7280))
    }.

/**
 * Exact generated CXX scatter dispatcher.
 */
pub scatter_scalar(
    input: Tensor,
    mode: Int,
    dimension: Int,
    index: Tensor,
    value_is_int: Bool,
    value_int: Int,
    value_float: Float,
    reduction: Int,
): Tensor ->
    if {
        mode == 0 and value_is_int -> scatter_scalar_int(input, dimension, index, true, value_int, value_float);
        mode == 0 -> scatter_scalar_float(input, dimension, index, false, value_int, value_float);
        mode == 1 and value_is_int and reduction == 0 -> scatter_scalar_reduce_int_add(input, dimension, index, true, value_int, value_float, "add");
        mode == 1 and value_is_int and reduction == 1 -> scatter_scalar_reduce_int_multiply(
            input,
            dimension,
            index,
            true,
            value_int,
            value_float,
            "multiply",
        );
        mode == 1 and reduction == 0 -> scatter_scalar_reduce_float_add(
            input,
            dimension,
            index,
            false,
            value_int,
            value_float,
            "add",
        );
        mode == 1 and reduction == 1 -> scatter_scalar_reduce_float_multiply(
            input,
            dimension,
            index,
            false,
            value_int,
            value_float,
            "multiply",
        );
        true -> let _failed = fail(exit_reason(7281));
        scatter_scalar_int(input, dimension, index, true, value_int, value_float)
    }.

