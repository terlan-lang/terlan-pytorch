/**
 * Generated direct ATen scatter primitives with exact typed and reduced overload dispatch.
 */
module pytorch.ScatterNative.

import std.vm.Process.{exit_reason, fail}.

import type pytorch.Tensor.

/**
 * Exact generated CXX scatter dispatcher.
 */
pub scatter_tensor(
    input: Tensor,
    mode: Int,
    dimension: Int,
    index: Tensor,
    source: Tensor,
    reduction: Int,
    include_self: Bool,
): Tensor ->
    if {
        mode == 0 -> scatter_tensor_src(input, dimension, index, source);
        mode == 1 and reduction == 0 -> scatter_tensor_legacy_add(input, dimension, index, source, "add");
        mode == 1 and reduction == 1 -> scatter_tensor_legacy_multiply(input, dimension, index, source, "multiply");
        mode == 2 -> scatter_tensor_add(input, dimension, index, source);
        mode == 3 and reduction == 0 -> scatter_tensor_modern_sum(input, dimension, index, source, "sum", include_self);
        mode == 3 and reduction == 1 -> scatter_tensor_modern_prod(input, dimension, index, source, "prod", include_self);
        mode == 3 and reduction == 2 -> scatter_tensor_modern_mean(input, dimension, index, source, "mean", include_self);
        mode == 3 and reduction == 3 -> scatter_tensor_modern_amax(input, dimension, index, source, "amax", include_self);
        mode == 3 and reduction == 4 -> scatter_tensor_modern_amin(input, dimension, index, source, "amin", include_self);
        true -> let _failed = fail(exit_reason(7280));
        scatter_tensor_src(input, dimension, index, source)
    }.

/**
 * Exact generated CXX scatter dispatcher.
 */
pub scatter_tensor_out(
    output: Tensor,
    input: Tensor,
    mode: Int,
    dimension: Int,
    index: Tensor,
    source: Tensor,
    reduction: Int,
    include_self: Bool,
): Unit ->
    if {
        mode == 0 -> scatter_tensor_out_src(output, input, dimension, index, source);
        mode == 1 and reduction == 0 -> scatter_tensor_out_legacy_add(output, input, dimension, index, source, "add");
        mode == 1 and reduction == 1 -> scatter_tensor_out_legacy_multiply(output, input, dimension, index, source, "multiply");
        mode == 2 -> scatter_tensor_out_add(output, input, dimension, index, source);
        mode == 3 and reduction == 0 -> scatter_tensor_out_modern_sum(output, input, dimension, index, source, "sum", include_self);
        mode == 3 and reduction == 1 -> scatter_tensor_out_modern_prod(
            output,
            input,
            dimension,
            index,
            source,
            "prod",
            include_self,
        );
        mode == 3 and reduction == 2 -> scatter_tensor_out_modern_mean(
            output,
            input,
            dimension,
            index,
            source,
            "mean",
            include_self,
        );
        mode == 3 and reduction == 3 -> scatter_tensor_out_modern_amax(
            output,
            input,
            dimension,
            index,
            source,
            "amax",
            include_self,
        );
        mode == 3 and reduction == 4 -> scatter_tensor_out_modern_amin(
            output,
            input,
            dimension,
            index,
            source,
            "amin",
            include_self,
        );
        true -> fail(exit_reason(7280))
    }.

/**
 * Exact generated CXX scatter dispatcher.
