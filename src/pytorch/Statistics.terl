    native.

/**
 * Generated composition for aten::norm dimension and dtype semantics.
 */
pub norm_dimensions_dtype(
    tensor: Tensor,
    order: Float,
    dimensions: List[Int],
    dtype: Int,
    keep_dimension: Bool = false,
): Tensor ->
    let value = norm_dimensions(tensor, order, dimensions, keep_dimension);
    norm_dimensions_to_dtype(value, dtype).

/**
 * Generated retained-output composition for aten::norm dimension semantics.
 */
pub norm_dimensions_out(
    output: Tensor,
    tensor: Tensor,
    order: Float,
    dimensions: List[Int],
    keep_dimension: Bool = false,
): Unit ->
    let value = norm_dimensions(tensor, order, dimensions, keep_dimension);
    norm_dimensions_copy_in_place(output, value, false).

/**
 * Generated retained-output composition for aten::norm dimension and dtype semantics.
 */
pub norm_dimensions_dtype_out(
    output: Tensor,
    tensor: Tensor,
    order: Float,
    dimensions: List[Int],
    dtype: Int,
    keep_dimension: Bool = false,
): Unit ->
    let value = norm_dimensions_dtype(tensor, order, dimensions, dtype, keep_dimension);
    norm_dimensions_copy_in_place(output, value, false).

