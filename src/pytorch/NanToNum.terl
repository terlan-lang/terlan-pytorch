/**
 * Exact non-finite replacement operations with explicit optional-state entry points.
 */
module pytorch.NanToNum.

import pytorch.NanToNumNative.{nan_to_num_configured, nan_to_num_configured_in_place, nan_to_num_configured_out}.

import type pytorch.Tensor.

/**
 * Replaces NaN with zero and infinities with the finite dtype limits.
 */
pub nan_to_num(input: Tensor): Tensor ->
    nan_to_num_configured(input, false, 0.0, false, 0.0, false, 0.0).

/**
 * Replaces NaN explicitly and uses default infinity replacements.
 */
pub nan_to_num_nan(input: Tensor, nan: Float): Tensor ->
    nan_to_num_configured(input, true, nan, false, 0.0, false, 0.0).

/**
 * Replaces positive infinity explicitly and uses other defaults.
 */
pub nan_to_num_posinf(input: Tensor, posinf: Float): Tensor ->
    nan_to_num_configured(input, false, 0.0, true, posinf, false, 0.0).

/**
 * Replaces negative infinity explicitly and uses other defaults.
 */
pub nan_to_num_neginf(input: Tensor, neginf: Float): Tensor ->
    nan_to_num_configured(input, false, 0.0, false, 0.0, true, neginf).

/**
 * Replaces NaN and positive infinity explicitly.
 */
pub nan_to_num_nan_posinf(input: Tensor, nan: Float, posinf: Float): Tensor ->
    nan_to_num_configured(input, true, nan, true, posinf, false, 0.0).

/**
 * Replaces NaN and negative infinity explicitly.
 */
pub nan_to_num_nan_neginf(input: Tensor, nan: Float, neginf: Float): Tensor ->
    nan_to_num_configured(input, true, nan, false, 0.0, true, neginf).

/**
 * Replaces positive and negative infinity explicitly.
 */
pub nan_to_num_posinf_neginf(input: Tensor, posinf: Float, neginf: Float): Tensor ->
    nan_to_num_configured(input, false, 0.0, true, posinf, true, neginf).

/**
 * Replaces NaN and both infinity signs explicitly.
 */
pub nan_to_num_all(input: Tensor, nan: Float, posinf: Float, neginf: Float): Tensor ->
    nan_to_num_configured(input, true, nan, true, posinf, true, neginf).

/**
 * Writes default replacements into retained output storage.
 */
pub nan_to_num_out(output: Tensor, input: Tensor): Unit ->
    nan_to_num_configured_out(output, input, false, 0.0, false, 0.0, false, 0.0).

/**
 * Writes an explicit NaN replacement and default infinity replacements.
 */
pub nan_to_num_nan_out(output: Tensor, input: Tensor, nan: Float): Unit ->
    nan_to_num_configured_out(output, input, true, nan, false, 0.0, false, 0.0).

/**
 * Writes an explicit positive-infinity replacement and other defaults.
 */
pub nan_to_num_posinf_out(output: Tensor, input: Tensor, posinf: Float): Unit ->
    nan_to_num_configured_out(output, input, false, 0.0, true, posinf, false, 0.0).

/**
 * Writes an explicit negative-infinity replacement and other defaults.
 */
pub nan_to_num_neginf_out(output: Tensor, input: Tensor, neginf: Float): Unit ->
    nan_to_num_configured_out(output, input, false, 0.0, false, 0.0, true, neginf).

/**
 * Writes explicit NaN and positive-infinity replacements.
 */
pub nan_to_num_nan_posinf_out(output: Tensor, input: Tensor, nan: Float, posinf: Float): Unit ->
    nan_to_num_configured_out(output, input, true, nan, true, posinf, false, 0.0).

/**
 * Writes explicit NaN and negative-infinity replacements.
 */
pub nan_to_num_nan_neginf_out(output: Tensor, input: Tensor, nan: Float, neginf: Float): Unit ->
    nan_to_num_configured_out(output, input, true, nan, false, 0.0, true, neginf).

/**
 * Writes explicit positive- and negative-infinity replacements.
 */
pub nan_to_num_posinf_neginf_out(output: Tensor, input: Tensor, posinf: Float, neginf: Float): Unit ->
    nan_to_num_configured_out(output, input, false, 0.0, true, posinf, true, neginf).

/**
 * Writes explicit replacements for NaN and both infinity signs.
 */
pub nan_to_num_all_out(
    output: Tensor,
    input: Tensor,
    nan: Float,
    posinf: Float,
    neginf: Float,
): Unit ->
    nan_to_num_configured_out(output, input, true, nan, true, posinf, true, neginf).

/**
 * Mutates storage using default replacements.
 */
pub nan_to_num_in_place(input: Tensor): Unit ->
    nan_to_num_configured_in_place(input, false, 0.0, false, 0.0, false, 0.0).

/**
 * Mutates storage with an explicit NaN replacement.
 */
pub nan_to_num_nan_in_place(input: Tensor, nan: Float): Unit ->
    nan_to_num_configured_in_place(input, true, nan, false, 0.0, false, 0.0).

/**
 * Mutates storage with an explicit positive-infinity replacement.
 */
pub nan_to_num_posinf_in_place(input: Tensor, posinf: Float): Unit ->
    nan_to_num_configured_in_place(input, false, 0.0, true, posinf, false, 0.0).

/**
 * Mutates storage with an explicit negative-infinity replacement.
 */
pub nan_to_num_neginf_in_place(input: Tensor, neginf: Float): Unit ->
    nan_to_num_configured_in_place(input, false, 0.0, false, 0.0, true, neginf).

/**
 * Mutates storage with explicit NaN and positive-infinity replacements.
 */
pub nan_to_num_nan_posinf_in_place(input: Tensor, nan: Float, posinf: Float): Unit ->
    nan_to_num_configured_in_place(input, true, nan, true, posinf, false, 0.0).

/**
 * Mutates storage with explicit NaN and negative-infinity replacements.
 */
pub nan_to_num_nan_neginf_in_place(input: Tensor, nan: Float, neginf: Float): Unit ->
    nan_to_num_configured_in_place(input, true, nan, false, 0.0, true, neginf).

/**
 * Mutates storage with explicit positive- and negative-infinity replacements.
 */
pub nan_to_num_posinf_neginf_in_place(input: Tensor, posinf: Float, neginf: Float): Unit ->
    nan_to_num_configured_in_place(input, false, 0.0, true, posinf, true, neginf).

/**
 * Mutates storage with explicit replacements for every non-finite class.
 */
pub nan_to_num_all_in_place(input: Tensor, nan: Float, posinf: Float, neginf: Float): Unit ->
    nan_to_num_configured_in_place(input, true, nan, true, posinf, true, neginf).
