/**
 * Exact generated CXX float32 matmul precision query.
 */
@compiler.native {pytorch.backend_availability.float32_matmul_precision}
pub get_float32_matmul_precision(): String ->
    native.

/**
 * Exact generated CXX float32 matmul precision code setter.
 */
@compiler.native {pytorch.backend_availability.set_float32_matmul_precision_code}
pub set_float32_matmul_precision_code(code: Int): Unit ->
    native.

/**
 * Sets LibTorch's float32 matmul precision mode.
 */
pub set_float32_matmul_precision(precision: String): Unit ->
    if {
        precision == "highest" -> set_float32_matmul_precision_code(0);
        precision == "high" -> set_float32_matmul_precision_code(1);
        precision == "medium" -> set_float32_matmul_precision_code(2);
        true -> set_float32_matmul_precision_code(-1)
    }.

