/**
 * Exact reflection and replication padding backward kernels with retained-output variants.
 */
module pytorch.PaddingBackwardCompletion.

import type pytorch.Tensor.

/**
 * Executes exact aten::reflection_pad1d_backward.
 */
@compiler.native {pytorch.padding_backward_completion.reflection_pad1d_backward}
pub reflection_pad1d_backward(gradient: Tensor, input: Tensor, padding: List[Int]): Tensor ->
    native.

/**
 * Writes exact aten::reflection_pad1d_backward.grad_input into retained storage.
 */
@compiler.native {pytorch.padding_backward_completion.reflection_pad1d_backward_out}
pub reflection_pad1d_backward_out(
    output: Tensor,
    gradient: Tensor,
    input: Tensor,
    padding: List[Int],
): Unit ->
    native.

