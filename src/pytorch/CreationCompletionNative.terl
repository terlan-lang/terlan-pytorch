@compiler.native {pytorch.creation_completion_native.cxx.creation_empty}
creation_empty(
    size: List[Int],
    has_dtype: Bool,
    dtype: Int,
    has_layout: Bool,
    layout: Int,
    has_device: Bool,
    device: Device,
    has_pin_memory: Bool,
    pin_memory: Bool,
    has_memory_format: Bool,
    memory_format: Int,
): Tensor ->
    native.

