/**
 * Composes the public string-selected grid_sample contract over generated grid_sampler leaves.
 */
pub grid_sample(
    input: Tensor,
    grid: Tensor,
    mode: String = "bilinear",
    padding_mode: String = "zeros",
    align_corners: Bool = false,
): Tensor ->
    let interpolation =
        if {
            mode == "bilinear" -> 0;
            mode == "nearest" -> 1;
            true -> 2
        };
    let padding =
        if {
            padding_mode == "zeros" -> 0;
            padding_mode == "border" -> 1;
            true -> 2
        };
    grid_sampler(input, grid, interpolation, padding, align_corners).

