 */
pub backward_many(
    outputs: List[Tensor],
    grad_outputs: List[Tensor],
    retain_graph: Bool = false,
    create_graph: Bool = false,
): Unit ->
    let token = backward_many_token(outputs, grad_outputs, retain_graph, create_graph);
    dispose(token).

