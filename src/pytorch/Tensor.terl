/**
 * Computes softmin by applying softmax to the negated input.
 */
pub softmin(tensor: Tensor, dimension: Int): Tensor ->
    softmax(negate(tensor), dimension).

/**
 * Computes softsign as input divided by one plus its absolute value.
 */
pub softsign(tensor: Tensor): Tensor ->
    let denominator = add_scalar(abs(tensor), 1.0, 1.0);
    divide(tensor, denominator).

/**
 * Computes tanhshrink as input minus its hyperbolic tangent.
 */
pub tanhshrink(tensor: Tensor): Tensor ->
    let tangent = tanh(tensor);
    subtract(tensor, tangent, 1.0).

