/**
 * Public-compatible embedding_bag form returning only the embedding output while releasing LibTorch auxiliary tensors.
 */
pub embedding_bag_public(
    weight: Tensor,
    indices: Tensor,
    offsets: Tensor,
    scale_gradient_by_frequency: Bool = false,
    mode: Int = 0,
    sparse: Bool = false,
    include_last_offset: Bool = false,
): Tensor ->
    let {output, offset_to_bag, bag_size, maximum_indices} =
        embedding_bag(
            weight,
            indices,
            offsets,
            scale_gradient_by_frequency,
            mode,
            sparse,
            include_last_offset,
        );
    dispose(maximum_indices);
    dispose(bag_size);
    dispose(offset_to_bag);
    output.

