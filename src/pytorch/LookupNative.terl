/**
 * Writes tensor bucket indices into retained output storage.
 */
pub bucketize_tensor_out(
    output: Tensor,
    values: Tensor,
    boundaries: Tensor,
    out_int32: Bool,
    right: Bool,
): Unit ->
    lookup_bucketize_tensor_out(output, values, boundaries, out_int32, right).

/**
 * Returns the bucket index for an integer or floating-point scalar.
 */
pub bucketize_scalar(
    boundaries: Tensor,
    value_is_int: Bool,
    value_int: Int,
    value_float: Float,
    out_int32: Bool,
    right: Bool,
): Tensor ->
    lookup_bucketize_scalar(value_is_int, value_int, value_float, boundaries, out_int32, right).

