/**
 * Generated exact CXX membership, sorted lookup, and bucketization dispatchers.
 */
module pytorch.LookupNative.

import std.vm.Process.{exit_reason, fail}.

import type pytorch.Tensor.

/**
 * Writes tensor membership results into retained output storage.
 */
pub isin_tensor_out(
    output: Tensor,
    elements: Tensor,
    test_elements: Tensor,
    assume_unique: Bool,
    invert: Bool,
): Unit ->
    lookup_isin_tensor_tensor_out(output, elements, test_elements, assume_unique, invert).

/**
 * Evaluates tensor-scalar or scalar-tensor membership.
 */
pub isin_scalar(
    tensor: Tensor,
    mode: Int,
    value_is_int: Bool,
    value_int: Int,
    value_float: Float,
    assume_unique: Bool,
    invert: Bool,
): Tensor ->
    if {
        mode == 0 -> lookup_isin_tensor_scalar(
            tensor,
            value_is_int,
            value_int,
            value_float,
            assume_unique,
            invert,
        );
        true -> lookup_isin_scalar_tensor(
            value_is_int,
            value_int,
            value_float,
            tensor,
            assume_unique,
            invert,
        )
    }.

/**
 * Writes tensor-scalar or scalar-tensor membership into retained output storage.
 */
pub isin_scalar_out(
    output: Tensor,
    tensor: Tensor,
    mode: Int,
    value_is_int: Bool,
    value_int: Int,
    value_float: Float,
    assume_unique: Bool,
    invert: Bool,
): Unit ->
    if {
        mode == 0 -> lookup_isin_tensor_scalar_out(
            output,
            tensor,
            value_is_int,
            value_int,
            value_float,
            assume_unique,
            invert,
        );
        true -> lookup_isin_scalar_tensor_out(
            output,
            value_is_int,
            value_int,
            value_float,
            tensor,
            assume_unique,
            invert,
        )
    }.

/**
 * Finds tensor insertion indices with explicit side, width, and optional sorter policy.
 */
pub searchsorted_tensor(
    sorted_sequence: Tensor,
    values: Tensor,
    out_int32: Bool,
    right: Bool,
    side: Int,
    sorter: Tensor,
    has_sorter: Bool,
): Tensor ->
    if {
        side == 0 -> lookup_searchsorted_tensor(
            sorted_sequence,
            values,
            out_int32,
            right,
            false,
            "",
            has_sorter,
            sorter,
        );
        side == 1 -> lookup_searchsorted_tensor(
            sorted_sequence,
            values,
            out_int32,
            right,
            true,
            "left",
            has_sorter,
            sorter,
        );
        side == 2 -> lookup_searchsorted_tensor(
            sorted_sequence,
            values,
            out_int32,
            right,
            true,
            "right",
            has_sorter,
            sorter,
        );
        true -> let _failed = fail(exit_reason(7290));
        lookup_searchsorted_tensor(
            sorted_sequence,
            values,
            out_int32,
            right,
            false,
            "",
            has_sorter,
            sorter,
        )
    }.

