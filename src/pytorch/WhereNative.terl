/**
 * Compiler-generated direct CXX selection and index extraction over exact upstream where overloads.
 */
module pytorch.WhereNative.

import type pytorch.Tensor.

/**
 * Returns independently owned index tensors through exact aten::nonzero_numpy.
 */
@compiler.native {pytorch.where_native.nonzero_numpy}
pub nonzero_numpy(condition: Tensor): List[Tensor] ->
    native.

/**
 * Returns independently owned index tensors through the exact single-condition at::where overload.
 */
@compiler.native {pytorch.where_native.indices}
pub where_indices(condition: Tensor): List[Tensor] ->
    native.

/**
 * Selects between tagged integer or floating-point Scalar values through exact at::where.
 */
@compiler.native {pytorch.where_native.scalar}
pub where_scalar(
    condition: Tensor,
    self_is_int: Bool,
    self_int: Int,
    self_float: Float,
    other_is_int: Bool,
    other_int: Int,
    other_float: Float,
): Tensor ->
    native.

/**
 * Selects between a Tensor and a tagged integer or floating-point Scalar through exact at::where.
 */
@compiler.native {pytorch.where_native.scalar_other}
pub where_scalar_other(
    condition: Tensor,
    when_true: Tensor,
    other_is_int: Bool,
    other_int: Int,
    other_float: Float,
): Tensor ->
    native.

/**
 * Selects between a tagged integer or floating-point Scalar and a Tensor through exact at::where.
 */
@compiler.native {pytorch.where_native.scalar_self}
pub where_scalar_self(
    condition: Tensor,
    self_is_int: Bool,
    self_int: Int,
    self_float: Float,
    when_false: Tensor,
): Tensor ->
    native.

/**
 * Writes exact Tensor selection into retained output storage through at::where_out.
 */
@compiler.native {pytorch.where_native.tensor_out}
pub where_tensor_out(output: Tensor, condition: Tensor, when_true: Tensor, when_false: Tensor): Unit ->
    native.
