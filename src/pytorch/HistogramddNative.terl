/**
 * CXX-owned histogramdd result carrier and projections.
 */
module pytorch.HistogramddNative.

import type pytorch.Tensor.

/**
 * Owned histogramdd result carrier.
 */
pub opaque type HistogramddResult.

/**
 * Computes histogramdd with integer bin count.
 */
@compiler.native {pytorch.histogramdd.int_result}
pub histogramdd_int_result(
    input: Tensor,
    bins: Int,
    has_range: Bool,
    range: List[Float],
    has_weight: Bool,
    weight: Tensor,
    density: Bool,
): HistogramddResult ->
    native.

/**
 * Computes histogramdd with integer-list bins.
 */
@compiler.native {pytorch.histogramdd.bins_result}
pub histogramdd_bins_result(
    input: Tensor,
    bins: List[Int],
    has_range: Bool,
    range: List[Float],
    has_weight: Bool,
    weight: Tensor,
    density: Bool,
): HistogramddResult ->
    native.

/**
 * Computes histogramdd with Tensor-list bins.
 */
@compiler.native {pytorch.histogramdd.tensor_bins_result}
pub histogramdd_tensor_bins_result(
    input: Tensor,
    bins: List[Tensor],
    has_range: Bool,
    range: List[Float],
    has_weight: Bool,
    weight: Tensor,
    density: Bool,
): HistogramddResult ->
    native.

/**
 * Projects the histogram tensor.
 */
@compiler.native {pytorch.histogramdd.result_hist}
pub histogramdd_result_hist(result: HistogramddResult): Tensor ->
    native.

/**
 * Projects histogram bin-edge tensors.
 */
@compiler.native {pytorch.histogramdd.result_bin_edges}
pub histogramdd_result_bin_edges(result: HistogramddResult): List[Tensor] ->
    native.

/**
 * Drops a histogramdd result carrier.
 */
@compiler.native {pytorch.histogramdd.result_dispose}
histogramdd_result_dispose(result: HistogramddResult): Unit ->
    native.

/**
 * Computes histogramdd with an integer bin count.
 */
histogramdd_int(
    input: Tensor,
    bins: Int,
    has_range: Bool,
    range: List[Float],
    has_weight: Bool,
    weight: Tensor,
    density: Bool,
): {Tensor, List[Tensor]} ->
    let result = histogramdd_int_result(input, bins, has_range, range, has_weight, weight, density);
    let hist = histogramdd_result_hist(result);
    let edges = histogramdd_result_bin_edges(result);
    histogramdd_result_dispose(result);
    {hist, edges}.

/**
 * Computes histogramdd with integer-list bins.
 */
histogramdd_bins(
    input: Tensor,
    bins: List[Int],
    has_range: Bool,
    range: List[Float],
    has_weight: Bool,
    weight: Tensor,
    density: Bool,
): {Tensor, List[Tensor]} ->
    let result = histogramdd_bins_result(input, bins, has_range, range, has_weight, weight, density);
    let hist = histogramdd_result_hist(result);
    let edges = histogramdd_result_bin_edges(result);
    histogramdd_result_dispose(result);
    {hist, edges}.

/**
 * Computes histogramdd with Tensor-list bins.
 */
histogramdd_tensor_bins(
    input: Tensor,
    bins: List[Tensor],
    has_range: Bool,
    range: List[Float],
    has_weight: Bool,
    weight: Tensor,
    density: Bool,
): {Tensor, List[Tensor]} ->
    let result = histogramdd_tensor_bins_result(input, bins, has_range, range, has_weight, weight, density);
    let hist = histogramdd_result_hist(result);
    let edges = histogramdd_result_bin_edges(result);
    histogramdd_result_dispose(result);
    {hist, edges}.
