/**
 * Tensor equality, tolerance comparison, casting, and scalar-type promotion.
 */
module pytorch.TypeRelations.

import pytorch.Tensor.dtype_code.
import pytorch.TypeRelationsNative.{allclose_native, can_cast_native, equal_native, get_device_native, is_complex_native, is_conj_native, is_distributed_native, is_floating_point_native, is_inference_native, is_leaf_native, is_neg_native, is_nonzero_native, is_same_size_native, is_set_to_native, is_signed_native, output_nr_native, promote_types_native, result_type_scalar_native, result_type_scalar_scalar_native, result_type_scalar_tensor_native, result_type_tensor_native, retain_grad_native, retains_grad_native, size_dimension_native, stride_dimension_native}.

import type pytorch.Scalar.
import type pytorch.Tensor.{DType, Tensor}.

/**
 * Tests whether two tensors are elementwise close with PyTorch defaults.
 */
pub allclose(left: Tensor, right: Tensor): Bool ->
    allclose(left, right, 0.00001, 1e-8, false).

/**
 * Tests whether two tensors are elementwise close under explicit tolerances.
 */
pub allclose(
    left: Tensor,
    right: Tensor,
    relative_tolerance: Float,
    absolute_tolerance: Float,
    equal_nan: Bool,
): Bool ->
    allclose_native(left, right, relative_tolerance, absolute_tolerance, equal_nan).

/**
 * Tests whether two tensors have identical shapes and element values.
 */
pub equal(left: Tensor, right: Tensor): Bool ->
    equal_native(left, right).

/**
 * Tests whether two tensors have identical dimensions and extents.
 */
pub is_same_size(left: Tensor, right: Tensor): Bool ->
    is_same_size_native(left, right).

/**
 * Tests whether a tensor has a complex dtype.
 */
pub is_complex(tensor: Tensor): Bool ->
    is_complex_native(tensor).

/**
 * Tests whether a tensor carries PyTorch's lazy conjugate bit.
 */
pub is_conj(tensor: Tensor): Bool ->
    is_conj_native(tensor).

/**
 * Tests whether a tensor uses a distributed representation.
 */
pub is_distributed(tensor: Tensor): Bool ->
    is_distributed_native(tensor).

/**
 * Tests whether a tensor has a floating-point dtype.
 */
pub is_floating_point(tensor: Tensor): Bool ->
    is_floating_point_native(tensor).

/**
 * Tests whether a tensor was created in inference mode.
 */
pub is_inference(tensor: Tensor): Bool ->
    is_inference_native(tensor).

/**
 * Tests whether a tensor is an autograd leaf.
 */
pub is_leaf(tensor: Tensor): Bool ->
    is_leaf_native(tensor).

/**
 * Tests whether a tensor carries PyTorch's lazy negative bit.
 */
pub is_neg(tensor: Tensor): Bool ->
    is_neg_native(tensor).

/**
 * Returns the truth value of an exactly one-element tensor.
 */
pub is_nonzero(tensor: Tensor): Bool ->
    is_nonzero_native(tensor).

/**
 * Tests whether two tensors share the exact same storage view.
 */
pub is_set_to(tensor: Tensor, other: Tensor): Bool ->
    is_set_to_native(tensor, other).

/**
 * Tests whether a tensor's dtype is signed.
 */
pub is_signed(tensor: Tensor): Bool ->
    is_signed_native(tensor).

/**
 * Returns the backend device index, or `-1` for CPU.
 */
pub get_device(tensor: Tensor): Int ->
    get_device_native(tensor).

/**
 * Returns the tensor's autograd output number.
 */
pub output_nr(tensor: Tensor): Int ->
    output_nr_native(tensor).

/**
 * Returns one dimension extent with negative-dimension support.
 */
pub size(tensor: Tensor, dimension: Int): Int ->
    size_dimension_native(tensor, dimension).

/**
 * Returns one dimension stride with negative-dimension support.
 */
pub stride(tensor: Tensor, dimension: Int): Int ->
    stride_dimension_native(tensor, dimension).

/**
 * Enables gradient retention on an eligible non-leaf tensor.
 */
pub retain_grad(tensor: Tensor): Unit ->
    retain_grad_native(tensor).

/**
 * Tests whether a tensor has enabled retained gradients.
 */
pub retains_grad(tensor: Tensor): Bool ->
    retains_grad_native(tensor).

/**
 * Tests whether PyTorch permits values of one dtype to be cast into another.
 */
pub can_cast(from_dtype: DType, to_dtype: DType): Bool ->
    can_cast_native(dtype_code(from_dtype), dtype_code(to_dtype)).

/**
 * Returns PyTorch's promoted dtype for two scalar dtypes.
 */
pub promote_types(first: DType, second: DType): DType ->
    DType.parse(promote_types_native(dtype_code(first), dtype_code(second))).

/**
 * Returns the calculation dtype selected for two tensors.
 */
pub result_type(first: Tensor, second: Tensor): DType ->
    DType.parse(result_type_tensor_native(first, second)).

/**
 * Returns the calculation dtype selected for a tensor and exact scalar.
 */
pub result_type(tensor: Tensor, scalar: Scalar): DType ->
    DType.parse(
        result_type_scalar_native(
            tensor,
            scalar.is_integer,
            scalar.integer_value,
            scalar.floating_value,
        ),
    ).

/**
 * Returns the calculation dtype selected for an exact scalar and tensor.
 */
pub result_type(scalar: Scalar, tensor: Tensor): DType ->
    DType.parse(
        result_type_scalar_tensor_native(
            tensor,
            scalar.is_integer,
            scalar.integer_value,
            scalar.floating_value,
        ),
    ).

/**
 * Returns the calculation dtype selected for two exact scalars.
 */
pub result_type(first: Scalar, second: Scalar): DType ->
    DType.parse(
        result_type_scalar_scalar_native(
            first.is_integer,
            first.integer_value,
            first.floating_value,
            second.is_integer,
            second.integer_value,
            second.floating_value,
        ),
    ).

/**
 * Unambiguous aliases for generated consumers that cannot import overloaded arity-2 names.
 */
pub result_type_tensor_tensor(first: Tensor, second: Tensor): DType ->
    DType.parse(result_type_tensor_native(first, second)).

pub result_type_tensor_scalar_values(
    tensor: Tensor,
    scalar_is_integer: Bool,
    scalar_integer: Int,
    scalar_floating: Float,
): DType ->
    DType.parse(
        result_type_scalar_native(tensor, scalar_is_integer, scalar_integer, scalar_floating),
    ).

pub result_type_scalar_tensor_values(
    scalar_is_integer: Bool,
    scalar_integer: Int,
    scalar_floating: Float,
    tensor: Tensor,
): DType ->
    DType.parse(
        result_type_scalar_tensor_native(tensor, scalar_is_integer, scalar_integer, scalar_floating),
    ).

pub result_type_scalar_scalar_values(
    first_is_integer: Bool,
    first_integer: Int,
    first_floating: Float,
    second_is_integer: Bool,
    second_integer: Int,
    second_floating: Float,
): DType ->
    DType.parse(
        result_type_scalar_scalar_native(
            first_is_integer,
            first_integer,
            first_floating,
            second_is_integer,
            second_integer,
            second_floating,
        ),
    ).
