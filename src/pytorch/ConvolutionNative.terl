    native.

/**
 * Exact generated CXX retained-output leaf for aten::convolution.out.
 */
@compiler.native {pytorch.convolution.convolution_out}
pub convolution_out(
    output: Tensor,
    input: Tensor,
    weight: Tensor,
    has_bias: Bool,
    bias: Tensor,
    stride: List[Int],
    padding: List[Int],
    dilation: List[Int],
    transposed: Bool,
    output_padding: List[Int],
    groups: Int,
