/**
 * Exact one-, two-, and three-dimensional convolution primitives with absent and present optional bias.
 */
module pytorch.ConvolutionNative.

import type pytorch.Tensor.

/**
 * Exact generated CXX tuple leaf for aten::convolution_backward.
 */
@compiler.native {pytorch.convolution.convolution_backward}
pub convolution_backward(
    gradient: Tensor,
    input: Tensor,
    weight: Tensor,
    has_bias_sizes: Bool,
    bias_sizes: List[Int],
    stride: List[Int],
    padding: List[Int],
    dilation: List[Int],
    transposed: Bool,
    output_padding: List[Int],
    groups: Int,
    output_mask_input: Bool,
    output_mask_weight: Bool,
    output_mask_bias: Bool,
): {Tensor, Tensor, Tensor} ->
    native.

/**
 * Exact generated CXX retained-output leaf for aten::convolution_backward.out.
 */
@compiler.native {pytorch.convolution.convolution_backward_out}
pub convolution_backward_out(
    grad_input: Tensor,
    grad_weight: Tensor,
    grad_bias: Tensor,
    gradient: Tensor,
    input: Tensor,
    weight: Tensor,
    has_bias_sizes: Bool,
    bias_sizes: List[Int],
    stride: List[Int],
    padding: List[Int],
    dilation: List[Int],
    transposed: Bool,
    output_padding: List[Int],
    groups: Int,
    output_mask_input: Bool,
    output_mask_weight: Bool,
    output_mask_bias: Bool,
): Unit ->
    native.

/**
 * Exact generated CXX leaf for aten::convolution.
 */
@compiler.native {pytorch.convolution.convolution}
pub convolution(
    input: Tensor,
    weight: Tensor,
    has_bias: Bool,
    bias: Tensor,
    stride: List[Int],
    padding: List[Int],
    dilation: List[Int],
    transposed: Bool,
    output_padding: List[Int],
    groups: Int,
