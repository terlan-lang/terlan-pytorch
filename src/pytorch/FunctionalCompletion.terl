/**
 * Executes the LibTorch C++ multilabel_soft_margin_loss functional with explicit options.
 */
@compiler.native {pytorch.functional_completion.multilabel_soft_margin_loss_configured}
pub multilabel_soft_margin_loss_configured(
    input: Tensor,
    target: Tensor,
    has_weight: Bool,
    weight: Tensor,
    has_size_average: Bool,
    size_average: Bool,
    has_reduce: Bool,
    reduce: Bool,
    reduction: String,
): Tensor ->
    native.

/**
 * Projects an optional loss weight into the native presence-bit representation.
 */
loss_optional_tensor(value: Option[Tensor], fallback: Tensor): {Bool, Tensor} ->
    case value {
        None -> {false, fallback};
        Some(tensor) -> {true, tensor}
    }.

/**
 * Projects a legacy optional loss flag into the native presence-bit representation.
 */
loss_optional_bool(value: Option[Bool], fallback: Bool): {Bool, Bool} ->
    case value {
        None -> {false, fallback};
        Some(selected) -> {true, selected}
    }.

/**
 * Computes multilabel soft-margin loss with all PyTorch defaults.
 */
pub multilabel_soft_margin_loss(input: Tensor, target: Tensor): Tensor ->
    multilabel_soft_margin_loss_configured(
        input,
        target,
        false,
        input,
        false,
        true,
        false,
        true,
        "mean",
    ).

/**
 * Computes multilabel soft-margin loss with optional weight and the default reduction.
 */
pub multilabel_soft_margin_loss(input: Tensor, target: Tensor, weight: Option[Tensor]): Tensor ->
    let {has_weight, selected_weight} = loss_optional_tensor(weight, input);
    multilabel_soft_margin_loss_configured(
        input,
        target,
        has_weight,
        selected_weight,
        false,
        true,
        false,
        true,
        "mean",
    ).

/**
 * Computes multilabel soft-margin loss with optional weight and size_average.
 */
pub multilabel_soft_margin_loss(
    input: Tensor,
    target: Tensor,
    weight: Option[Tensor],
    size_average: Option[Bool],
): Tensor ->
    let {has_weight, selected_weight} = loss_optional_tensor(weight, input);
    let {has_size_average, selected_size_average} = loss_optional_bool(size_average, true);
    multilabel_soft_margin_loss_configured(
        input,
        target,
        has_weight,
        selected_weight,
        has_size_average,
        selected_size_average,
        false,
        true,
        "mean",
    ).

/**
 * Computes multilabel soft-margin loss with optional legacy reduction flags.
 */
pub multilabel_soft_margin_loss(
    input: Tensor,
    target: Tensor,
    weight: Option[Tensor],
    size_average: Option[Bool],
    reduce: Option[Bool],
): Tensor ->
    let {has_weight, selected_weight} = loss_optional_tensor(weight, input);
    let {has_size_average, selected_size_average} = loss_optional_bool(size_average, true);
    let {has_reduce, selected_reduce} = loss_optional_bool(reduce, true);
    multilabel_soft_margin_loss_configured(
        input,
        target,
        has_weight,
        selected_weight,
        has_size_average,
        selected_size_average,
        has_reduce,
        selected_reduce,
        "mean",
    ).

/**
 * Computes multilabel soft-margin loss with PyTorch optional weight and reduction semantics.
 */
pub multilabel_soft_margin_loss(
    input: Tensor,
    target: Tensor,
    weight: Option[Tensor],
    size_average: Option[Bool],
    reduce: Option[Bool],
    reduction: String,
): Tensor ->
    let {has_weight, selected_weight} = loss_optional_tensor(weight, input);
    let {has_size_average, selected_size_average} = loss_optional_bool(size_average, true);
    let {has_reduce, selected_reduce} = loss_optional_bool(reduce, true);
    multilabel_soft_margin_loss_configured(
        input,
        target,
        has_weight,
        selected_weight,
        has_size_average,
        selected_size_average,
        has_reduce,
        selected_reduce,
        reduction,
    ).

