/**
 * Private norm leaf for the public normalize composition.
 */
@compiler.native {pytorch.functional_completion.normalize_norm}
normalize_norm(input: Tensor, p: Float, dimensions: List[Int], keep_dimension: Bool): Tensor ->
    native.

/**
 * Private clamp-min leaf for the public normalize composition.
 */
@compiler.native {pytorch.functional_completion.normalize_clamp_min}
normalize_clamp_min(input: Tensor, minimum: Float): Tensor ->
    native.

/**
 * Private divide leaf for the public normalize composition.
 */
@compiler.native {pytorch.functional_completion.normalize_divide}
normalize_divide(left: Tensor, right: Tensor): Tensor ->
    native.

/**
 * Normalizes a tensor along one dimension using an epsilon floor.
 */
pub normalize(input: Tensor, p: Float = 2.0, dimension: Int = 1, epsilon: Float = 1e-12): Tensor ->
    let magnitude = normalize_norm(input, p, [dimension], true);
    let bounded = normalize_clamp_min(magnitude, epsilon);
    normalize_divide(input, bounded).

