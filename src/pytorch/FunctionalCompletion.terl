): Tensor ->
    gaussian_nll_loss_configured(input, target, false, input, variance, full, eps, reduction).

/**
 * Applies Gaussian negative log-likelihood loss with tensor variance.
 */
pub gaussian_nll_loss(
    input: Tensor,
    target: Tensor,
    variance: Tensor,
    full: Bool,
    eps: Float,
    reduction: String,
): Tensor ->
    gaussian_nll_loss_configured(input, target, true, variance, 0.0, full, eps, reduction).

/**
 * Applies Gaussian negative log-likelihood loss with scalar variance.
 */
pub gaussian_nll_loss(
    input: Tensor,
    target: Tensor,
    variance: Float,
    full: Bool,
    eps: Float,
    reduction: String,
): Tensor ->
    gaussian_nll_loss_configured(input, target, false, input, variance, full, eps, reduction).

/**
 * Executes the LibTorch C++ interpolation functional with explicit optional presence.
 */
@compiler.native {pytorch.functional_completion.interpolate_configured}
pub interpolate_configured(
    input: Tensor,
    has_size: Bool,
    size: List[Int],
    has_scale: Bool,
    scale_factor: List[Float],
    mode: String,
    has_align_corners: Bool,
    align_corners: Bool,
    has_recompute: Bool,
    recompute_scale_factor: Bool,
    antialias: Bool,
): Tensor ->
    native.

/**
 * Applies interpolation with size/scale, mode, alignment, recomputation, and anti-alias options.
 */
pub interpolate(
    input: Tensor,
    has_size: Bool,
    size: List[Int],
    has_scale: Bool,
    scale_factor: List[Float],
    mode: String,
    has_align_corners: Bool,
    align_corners: Bool,
    has_recompute: Bool,
    recompute_scale_factor: Bool,
    antialias: Bool,
): Tensor ->
    interpolate_configured(
        input,
        has_size,
        size,
        has_scale,
        scale_factor,
        mode,
        has_align_corners,
        align_corners,
        has_recompute,
        recompute_scale_factor,
        antialias,
    ).

/**
 * upsample compatibility alias backed by generated interpolation.
 */
pub upsample(
    input: Tensor,
    has_size: Bool,
    size: List[Int],
    has_scale: Bool,
    scale_factor: List[Float],
    mode: String,
    has_align_corners: Bool,
    align_corners: Bool,
    has_recompute: Bool,
    recompute_scale_factor: Bool,
    antialias: Bool,
): Tensor ->
    interpolate(
        input,
        has_size,
        size,
        has_scale,
        scale_factor,
        mode,
        has_align_corners,
        align_corners,
        has_recompute,
        recompute_scale_factor,
        antialias,
    ).

/**
 * upsample_bilinear compatibility alias backed by generated interpolation.
 */
pub upsample_bilinear(
    input: Tensor,
    has_size: Bool,
    size: List[Int],
    has_scale: Bool,
    scale_factor: List[Float],
): Tensor ->
    interpolate(
        input,
        has_size,
        size,
        has_scale,
        scale_factor,
        "bilinear",
        true,
        false,
        false,
        false,
        false,
    ).

/**
 * upsample_nearest compatibility alias backed by generated interpolation.
 */
pub upsample_nearest(
    input: Tensor,
    has_size: Bool,
    size: List[Int],
    has_scale: Bool,
    scale_factor: List[Float],
): Tensor ->
    interpolate(
        input,
        has_size,
        size,
        has_scale,
        scale_factor,
        "nearest",
        false,
        false,
        false,
        false,
        false,
    ).
