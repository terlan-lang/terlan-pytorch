/**
 * Compiler-generated exact hardshrink, softshrink, softplus, and threshold forward/backward primitives.
 */
module pytorch.ActivationCompletion.

import type pytorch.Tensor.

/**
 * Executes exact hardshrink with the public integer Scalar form.
 */
@compiler.native {pytorch.activation_completion.hardshrink_int}
pub hardshrink_int(input: Tensor, lambd: Int): Tensor ->
    native.

/**
 * Executes exact hardshrink with the public floating-point Scalar form.
 */
@compiler.native {pytorch.activation_completion.hardshrink_float}
pub hardshrink_float(input: Tensor, lambd: Float): Tensor ->
    native.

/**
 * Executes exact hardshrink out with the public integer Scalar form.
 */
@compiler.native {pytorch.activation_completion.hardshrink_out_int}
pub hardshrink_out_int(output: Tensor, input: Tensor, lambd: Int): Unit ->
    native.

/**
 * Executes exact hardshrink out with the public floating-point Scalar form.
 */
@compiler.native {pytorch.activation_completion.hardshrink_out_float}
pub hardshrink_out_float(output: Tensor, input: Tensor, lambd: Float): Unit ->
    native.

/**
 * Executes exact hardshrink backward with the public integer Scalar form.
 */
@compiler.native {pytorch.activation_completion.hardshrink_backward_int}
pub hardshrink_backward_int(gradient: Tensor, input: Tensor, lambd: Int): Tensor ->
    native.

/**
 * Executes exact hardshrink backward with the public floating-point Scalar form.
 */
@compiler.native {pytorch.activation_completion.hardshrink_backward_float}
pub hardshrink_backward_float(gradient: Tensor, input: Tensor, lambd: Float): Tensor ->
    native.

