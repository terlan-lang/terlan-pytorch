/**
 * Generated direct CXX range, identity, and endpoint-spacing primitives.
 */
module pytorch.RangeNative.

import std.vm.Process.{exit_reason, fail}.

import type pytorch.Tensor.
import type pytorch.Tensor.{DType, Device, Layout}.

/**
 * Creates an exact arange overload with integer-preserving scalar inference and explicit option presence.
 */
pub arange_exact_native(
    form: Int,
    start_is_integer: Bool,
    start_integer: Int,
    start_floating: Float,
    end_is_integer: Bool,
    end_integer: Int,
    end_floating: Float,
    step_is_integer: Bool,
    step_integer: Int,
    step_floating: Float,
    dtype: Int,
    has_dtype: Bool,
    layout: Int,
    has_layout: Bool,
    device_type: Int,
    device_index: Int,
    has_device: Bool,
    pin_memory: Bool,
    has_pin_memory: Bool,
): Tensor ->
    if {
        form == 0 -> range_arange_end(
            end_is_integer,
            end_integer,
            end_floating,
            has_dtype,
            range_dtype(dtype),
            has_layout,
            0,
            has_device,
            range_device(device_type, device_index),
            has_pin_memory,
            pin_memory,
        );
        form == 1 -> range_arange_start_end(
            start_is_integer,
            start_integer,
            start_floating,
            end_is_integer,
            end_integer,
            end_floating,
            has_dtype,
            range_dtype(dtype),
            has_layout,
            0,
            has_device,
            range_device(device_type, device_index),
            has_pin_memory,
            pin_memory,
        );
        true -> range_arange_start_end_step(
            start_is_integer,
            start_integer,
            start_floating,
            end_is_integer,
            end_integer,
            end_floating,
            step_is_integer,
            step_integer,
            step_floating,
            has_dtype,
            range_dtype(dtype),
            has_layout,
            0,
            has_device,
            range_device(device_type, device_index),
            has_pin_memory,
            pin_memory,
        )
    }.

/**
 * Writes an exact arange overload into retained tensor storage.
 */
pub arange_out_exact_native(
    output: Tensor,
    form: Int,
    start_is_integer: Bool,
    start_integer: Int,
    start_floating: Float,
    end_is_integer: Bool,
    end_integer: Int,
    end_floating: Float,
    step_is_integer: Bool,
    step_integer: Int,
    step_floating: Float,
): Unit ->
    if {
        form == 0 -> range_arange_out_end(output, end_is_integer, end_integer, end_floating);
        true -> range_arange_out_start_end_step(
            output,
            start_is_integer,
            start_integer,
            start_floating,
            end_is_integer,
            end_integer,
            end_floating,
            step_is_integer,
            step_integer,
            step_floating,
        )
    }.

/**
 * Creates an exact square or rectangular identity overload with explicit option presence.
 */
pub eye_exact_native(
    rows: Int,
    columns: Int,
    rectangular: Bool,
    dtype: Int,
    has_dtype: Bool,
    layout: Int,
    has_layout: Bool,
    device_type: Int,
    device_index: Int,
    has_device: Bool,
    pin_memory: Bool,
    has_pin_memory: Bool,
): Tensor ->
    if {
        rectangular -> range_eye_rect(
            rows,
            columns,
            has_dtype,
            range_dtype(dtype),
            has_layout,
            0,
            has_device,
            range_device(device_type, device_index),
            has_pin_memory,
            pin_memory,
        );
        true -> range_eye_square(
            rows,
            has_dtype,
            range_dtype(dtype),
            has_layout,
            0,
            has_device,
            range_device(device_type, device_index),
            has_pin_memory,
            pin_memory,
        )
    }.

/**
 * Writes a square or rectangular identity into retained tensor storage.
 */
pub eye_out_exact_native(output: Tensor, rows: Int, columns: Int, rectangular: Bool): Unit ->
    if {
        rectangular -> range_eye_out_rect(output, rows, columns);
        true -> range_eye_out_square(output, rows)
    }.

