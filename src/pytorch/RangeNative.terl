/**
 * Creates an inclusive legacy range with exact scalar kinds and option presence.
 */
pub range_exact_native(
    explicit_step: Bool,
    start_is_integer: Bool,
    start_integer: Int,
    start_floating: Float,
    end_is_integer: Bool,
    end_integer: Int,
    end_floating: Float,
    step_is_integer: Bool,
    step_integer: Int,
    step_floating: Float,
    dtype: Int,
    has_dtype: Bool,
    layout: Int,
    has_layout: Bool,
    device_type: Int,
    device_index: Int,
    has_device: Bool,
    pin_memory: Bool,
    has_pin_memory: Bool,
): Tensor ->
    if {
        explicit_step -> range_range_start_end_step(
            start_is_integer,
            start_integer,
            start_floating,
            end_is_integer,
            end_integer,
            end_floating,
            step_is_integer,
            step_integer,
            step_floating,
            has_dtype,
            range_dtype(dtype),
            has_layout,
            0,
            has_device,
            range_device(device_type, device_index),
            has_pin_memory,
            pin_memory,
        );
        true -> range_range_start_end(
            start_is_integer,
            start_integer,
            start_floating,
            end_is_integer,
            end_integer,
            end_floating,
            has_dtype,
            range_dtype(dtype),
            has_layout,
            0,
            has_device,
            range_device(device_type, device_index),
            has_pin_memory,
            pin_memory,
        )
    }.

/**
 * Writes an inclusive legacy range into retained tensor storage.
 */
pub range_out_exact_native(
    output: Tensor,
    explicit_step: Bool,
    start_is_integer: Bool,
    start_integer: Int,
    start_floating: Float,
    end_is_integer: Bool,
    end_integer: Int,
    end_floating: Float,
    step_is_integer: Bool,
    step_integer: Int,
    step_floating: Float,
): Unit ->
    if {
        explicit_step -> range_range_out_start_end_step(
            output,
            start_is_integer,
            start_integer,
            start_floating,
            end_is_integer,
            end_integer,
            end_floating,
            step_is_integer,
            step_integer,
            step_floating,
        );
        true -> range_range_out_start_end(
            output,
            start_is_integer,
            start_integer,
            start_floating,
            end_is_integer,
            end_integer,
            end_floating,
        )
    }.

/**
 * Maps stable dtype selectors.
 */
range_dtype(code: Int): Int ->
    if {
        code == 0 -> 0;
        code == 1 -> 1;
        code == 2 -> 2;
        code == 3 -> 3;
        code == 4 -> 4;
        code == 5 -> 5;
        code == 6 -> 6;
        code == 7 -> 7;
        code == 8 -> 8;
        code == 9 -> 9;
        code == 10 -> 10;
        code == 11 -> 11;
        code == 12 -> 12;
        code == 13 -> 13;
        code == 14 -> 14;
        code == 15 -> 15;
        code == 16 -> 16;
        code == 17 -> 17;
        code == 18 -> 18;
        code == 19 -> 19;
        code == 20 -> 20;
        code == 21 -> 21;
        code == 22 -> 22;
        code == 23 -> 23;
        code == 24 -> 24;
        code == 25 -> 25;
        code == 26 -> 26;
        code == 27 -> 27;
        code == 28 -> 28;
        code == 29 -> 29;
        code == 30 -> 30;
        code == 31 -> 31;
        code == 32 -> 32;
        code == 33 -> 33;
        code == 34 -> 34;
        code == 35 -> 35;
        code == 36 -> 36;
        code == 37 -> 37;
        code == 38 -> 38;
        code == 39 -> 39;
        code == 40 -> 40;
        code == 41 -> 41;
        code == 42 -> 42;
        code == 43 -> 43;
        code == 44 -> 44;
        code == 45 -> 45;
        true -> let _failed = fail(exit_reason(7260));
        6
    }.

/**
 * Maps stable device selectors.
 */
range_device(kind: Int, index: Int): Device ->
    if {
        kind == 0 -> "cpu";
        kind == 1 -> "cuda:" + std.core.Int.to_string(index);
        true -> let _failed = fail(exit_reason(7260));
        "cpu"
    }.

