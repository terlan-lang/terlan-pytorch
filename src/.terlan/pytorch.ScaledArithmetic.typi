/// Writes rsub with a Int operand and Float alpha.

pub rsub_right_int_alpha_float_out(output: pytorch.Tensor, left: pytorch.Tensor, right: Int, alpha: Float): Unit.

/// Applies rsub with a Int operand and Int alpha.

pub rsub_right_int_alpha_int(left: pytorch.Tensor, right: Int, alpha: Int): pytorch.Tensor.

/// Writes rsub with a Int operand and Int alpha.

pub rsub_right_int_alpha_int_out(output: pytorch.Tensor, left: pytorch.Tensor, right: Int, alpha: Int): Unit.

/// Applies tensor rsub with Float alpha.

pub rsub_tensor_alpha_float(left: pytorch.Tensor, right: pytorch.Tensor, alpha: Float): pytorch.Tensor.

/// Writes tensor rsub with Float alpha.

pub rsub_tensor_alpha_float_out(output: pytorch.Tensor, left: pytorch.Tensor, right: pytorch.Tensor, alpha: Float): Unit.

/// Applies tensor rsub with Int alpha.

pub rsub_tensor_alpha_int(left: pytorch.Tensor, right: pytorch.Tensor, alpha: Int): pytorch.Tensor.

/// Writes tensor rsub with Int alpha.

pub rsub_tensor_alpha_int_out(output: pytorch.Tensor, left: pytorch.Tensor, right: pytorch.Tensor, alpha: Int): Unit.

