//! Typed alpha-scaled addition, subtraction, and reverse subtraction.

module pytorch.ScaledArithmetic.

/// Applies add with a Float operand and Float alpha.

pub add_right_float_alpha_float(left: pytorch.Tensor, right: Float, alpha: Float): pytorch.Tensor.

/// Applies add with a Float operand and Float alpha in place.

pub add_right_float_alpha_float_in_place(left: pytorch.Tensor, right: Float, alpha: Float): Unit.

/// Writes add with a Float operand and Float alpha.

pub add_right_float_alpha_float_out(output: pytorch.Tensor, left: pytorch.Tensor, right: Float, alpha: Float): Unit.

/// Applies add with a Float operand and Int alpha.

pub add_right_float_alpha_int(left: pytorch.Tensor, right: Float, alpha: Int): pytorch.Tensor.

/// Applies add with a Float operand and Int alpha in place.

pub add_right_float_alpha_int_in_place(left: pytorch.Tensor, right: Float, alpha: Int): Unit.

/// Writes add with a Float operand and Int alpha.

pub add_right_float_alpha_int_out(output: pytorch.Tensor, left: pytorch.Tensor, right: Float, alpha: Int): Unit.

/// Applies add with a Int operand and Float alpha.

pub add_right_int_alpha_float(left: pytorch.Tensor, right: Int, alpha: Float): pytorch.Tensor.

/// Applies add with a Int operand and Float alpha in place.

pub add_right_int_alpha_float_in_place(left: pytorch.Tensor, right: Int, alpha: Float): Unit.

/// Writes add with a Int operand and Float alpha.

pub add_right_int_alpha_float_out(output: pytorch.Tensor, left: pytorch.Tensor, right: Int, alpha: Float): Unit.

/// Applies add with a Int operand and Int alpha.

pub add_right_int_alpha_int(left: pytorch.Tensor, right: Int, alpha: Int): pytorch.Tensor.

/// Applies add with a Int operand and Int alpha in place.

pub add_right_int_alpha_int_in_place(left: pytorch.Tensor, right: Int, alpha: Int): Unit.

/// Writes add with a Int operand and Int alpha.

pub add_right_int_alpha_int_out(output: pytorch.Tensor, left: pytorch.Tensor, right: Int, alpha: Int): Unit.

/// Applies tensor add with Float alpha.

pub add_tensor_alpha_float(left: pytorch.Tensor, right: pytorch.Tensor, alpha: Float): pytorch.Tensor.

/// Applies tensor add with Float alpha in place.

pub add_tensor_alpha_float_in_place(left: pytorch.Tensor, right: pytorch.Tensor, alpha: Float): Unit.

/// Writes tensor add with Float alpha.

pub add_tensor_alpha_float_out(output: pytorch.Tensor, left: pytorch.Tensor, right: pytorch.Tensor, alpha: Float): Unit.

/// Applies tensor add with Int alpha.

pub add_tensor_alpha_int(left: pytorch.Tensor, right: pytorch.Tensor, alpha: Int): pytorch.Tensor.

/// Applies tensor add with Int alpha in place.

pub add_tensor_alpha_int_in_place(left: pytorch.Tensor, right: pytorch.Tensor, alpha: Int): Unit.

/// Writes tensor add with Int alpha.

pub add_tensor_alpha_int_out(output: pytorch.Tensor, left: pytorch.Tensor, right: pytorch.Tensor, alpha: Int): Unit.

/// Top-level `torch.rsub` alias for a floating-point scalar operand and alpha.

pub rsub(input: pytorch.Tensor, other: Float, alpha: Float): pytorch.Tensor.

/// Applies rsub with a Float operand and Float alpha.

pub rsub_right_float_alpha_float(left: pytorch.Tensor, right: Float, alpha: Float): pytorch.Tensor.

/// Writes rsub with a Float operand and Float alpha.

pub rsub_right_float_alpha_float_out(output: pytorch.Tensor, left: pytorch.Tensor, right: Float, alpha: Float): Unit.

/// Applies rsub with a Float operand and Int alpha.

pub rsub_right_float_alpha_int(left: pytorch.Tensor, right: Float, alpha: Int): pytorch.Tensor.

/// Writes rsub with a Float operand and Int alpha.

