//! Generated CXX scalar-quantile completion surface.

module pytorch.QuantileCompletion.

pub quantile_scalar(input: pytorch.Tensor, q: Float, dimension: Int, keep_dimension: Bool, interpolation: String): pytorch.Tensor.

pub quantile_scalar_out(output: pytorch.Tensor, input: pytorch.Tensor, q: Float, dimension: Int, keep_dimension: Bool, interpolation: String): Unit.

pub quantile_tensor(input: pytorch.Tensor, q: pytorch.Tensor, dimension: Int, keep_dimension: Bool, interpolation: String): pytorch.Tensor.

pub quantile_tensor_out(output: pytorch.Tensor, input: pytorch.Tensor, q: pytorch.Tensor, dimension: Int, keep_dimension: Bool, interpolation: String): Unit.
