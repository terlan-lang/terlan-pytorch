pub gumbel_softmax_configured(logits: pytorch.Tensor, tau: Float, hard: Bool, eps: Float, dimension: Int): pytorch.Tensor.

/// Applies interpolation with size/scale, mode, alignment, recomputation, and anti-alias options.

pub interpolate(input: pytorch.Tensor, has_size: Bool, size: List[Int], has_scale: Bool, scale_factor: List[Float], mode: String, has_align_corners: Bool, align_corners: Bool, has_recompute: Bool, recompute_scale_factor: Bool, antialias: Bool): pytorch.Tensor.

