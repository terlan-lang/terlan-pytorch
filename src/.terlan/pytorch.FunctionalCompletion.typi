pub gaussian_nll_loss_configured(input: pytorch.Tensor, target: pytorch.Tensor, var_is_tensor: Bool, var_tensor: pytorch.Tensor, var_scalar: Float, full: Bool, eps: Float, reduction: String): pytorch.Tensor.

