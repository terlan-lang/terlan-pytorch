//! Generated direct-CXX implementation of functional completion operations.

module pytorch.FunctionalCompletion.

/// Executes exact aten::diff with append only.

pub diff_append(input: pytorch.Tensor, order: Int, dimension: Int, append: pytorch.Tensor): pytorch.Tensor.

/// Executes exact aten::diff without boundary tensors.

pub diff_basic(input: pytorch.Tensor, order: Int, dimension: Int): pytorch.Tensor.

/// Executes exact aten::diff with both boundary tensors.

pub diff_both(input: pytorch.Tensor, order: Int, dimension: Int, prepend: pytorch.Tensor, append: pytorch.Tensor): pytorch.Tensor.

/// Writes exact aten::diff.out with append only.

pub diff_out_append(output: pytorch.Tensor, input: pytorch.Tensor, order: Int, dimension: Int, append: pytorch.Tensor): Unit.

/// Writes exact aten::diff.out without boundary tensors.

pub diff_out_basic(output: pytorch.Tensor, input: pytorch.Tensor, order: Int, dimension: Int): Unit.

/// Writes exact aten::diff.out with both boundary tensors.

pub diff_out_both(output: pytorch.Tensor, input: pytorch.Tensor, order: Int, dimension: Int, prepend: pytorch.Tensor, append: pytorch.Tensor): Unit.

/// Writes exact aten::diff.out with prepend only.

pub diff_out_prepend(output: pytorch.Tensor, input: pytorch.Tensor, order: Int, dimension: Int, prepend: pytorch.Tensor): Unit.

/// Executes exact aten::diff with prepend only.

pub diff_prepend(input: pytorch.Tensor, order: Int, dimension: Int, prepend: pytorch.Tensor): pytorch.Tensor.

