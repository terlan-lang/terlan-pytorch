//! Typed Tensor.new_* compatibility wrappers with inherited device and dtype.

module pytorch.CreationAliasCompletion.

pub new_empty(input: pytorch.Tensor, size: List[Int]): pytorch.Tensor.

pub new_empty_out(output: pytorch.Tensor, input: pytorch.Tensor, size: List[Int]): Unit.

pub new_full(input: pytorch.Tensor, size: List[Int], fill: pytorch.Scalar): pytorch.Tensor.

pub new_full_scalar_out(output: pytorch.Tensor, input: pytorch.Tensor, size: List[Int], fill: pytorch.Scalar): Unit.

pub new_ones(input: pytorch.Tensor, size: List[Int]): pytorch.Tensor.

pub new_ones_out(output: pytorch.Tensor, input: pytorch.Tensor, size: List[Int]): Unit.

pub new_zeros(input: pytorch.Tensor, size: List[Int]): pytorch.Tensor.

pub new_zeros_out(output: pytorch.Tensor, input: pytorch.Tensor, size: List[Int]): Unit.
