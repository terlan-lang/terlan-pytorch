//! Generated CXX NLL-loss completion surface.

module pytorch.NllLossCompletion.

/// Computes mean NLL loss without class weights.

pub nll_loss_default(input: Tensor, target: Tensor, reduction: Int, ignore_index: Int): Tensor.

/// Writes mean NLL loss into retained output storage without class weights.

pub nll_loss_out_default(output: Tensor, input: Tensor, target: Tensor, reduction: Int, ignore_index: Int): Unit.

/// Writes mean NLL loss into retained output storage with class weights.

pub nll_loss_out_weight(output: Tensor, input: Tensor, target: Tensor, weight: Tensor, reduction: Int, ignore_index: Int): Unit.

/// Computes mean NLL loss with class weights.

pub nll_loss_weight(input: Tensor, target: Tensor, weight: Tensor, reduction: Int, ignore_index: Int): Tensor.
