//! Compiler-generated exact full-tensor, diagonal, and masked filling primitives.

module pytorch.FillNative.

/// Executes exact fill diagonal in place behavior through the selected upstream overload.

pub fill_diagonal_in_place(input: pytorch.Tensor, value_is_int: Bool, value_int: Int, value_float: Float, wrap: Bool): Unit.

/// Executes exact fill scalar behavior through the selected upstream overload.

pub fill_scalar(input: pytorch.Tensor, value_is_int: Bool, value_int: Int, value_float: Float): pytorch.Tensor.

/// Executes exact fill scalar in place behavior through the selected upstream overload.

pub fill_scalar_in_place(input: pytorch.Tensor, value_is_int: Bool, value_int: Int, value_float: Float): Unit.

/// Executes exact fill scalar out behavior through the selected upstream overload.

pub fill_scalar_out(output: pytorch.Tensor, input: pytorch.Tensor, value_is_int: Bool, value_int: Int, value_float: Float): Unit.

/// Executes exact fill tensor in place behavior through the selected upstream overload.

pub fill_tensor_in_place(input: pytorch.Tensor, value: pytorch.Tensor): Unit.

/// Executes exact fill tensor out behavior through the selected upstream overload.

pub fill_tensor_out(output: pytorch.Tensor, input: pytorch.Tensor, value: pytorch.Tensor): Unit.

/// Executes exact masked fill scalar behavior through the selected upstream overload.

pub masked_fill_scalar(input: pytorch.Tensor, mask: pytorch.Tensor, value_is_int: Bool, value_int: Int, value_float: Float): pytorch.Tensor.

/// Executes exact masked fill scalar in place behavior through the selected upstream overload.

pub masked_fill_scalar_in_place(input: pytorch.Tensor, mask: pytorch.Tensor, value_is_int: Bool, value_int: Int, value_float: Float): Unit.

/// Executes exact masked fill scalar out behavior through the selected upstream overload.

pub masked_fill_scalar_out(output: pytorch.Tensor, input: pytorch.Tensor, mask: pytorch.Tensor, value_is_int: Bool, value_int: Int, value_float: Float): Unit.

/// Executes exact masked fill tensor in place behavior through the selected upstream overload.

pub masked_fill_tensor_in_place(input: pytorch.Tensor, mask: pytorch.Tensor, value: pytorch.Tensor): Unit.

/// Executes exact masked fill tensor out behavior through the selected upstream overload.

pub masked_fill_tensor_out(output: pytorch.Tensor, input: pytorch.Tensor, mask: pytorch.Tensor, value: pytorch.Tensor): Unit.
