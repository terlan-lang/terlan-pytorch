//! Generated exact CXX unique and consecutive-unique completion surface.

module pytorch.UniqueCompletion.

pub unique_consecutive(input: pytorch.Tensor, return_inverse: Bool = false, return_counts: Bool = false): {pytorch.Tensor, pytorch.Tensor, pytorch.Tensor}.

pub unique_consecutive_out(out0: pytorch.Tensor, out1: pytorch.Tensor, out2: pytorch.Tensor, input: pytorch.Tensor, return_inverse: Bool, return_counts: Bool): Unit.

pub unique_dim(input: pytorch.Tensor, dim: Int, sorted: Bool = true, return_inverse: Bool = false, return_counts: Bool = false): {pytorch.Tensor, pytorch.Tensor, pytorch.Tensor}.

pub unique_dim_consecutive(input: pytorch.Tensor, dim: Int, return_inverse: Bool = false, return_counts: Bool = false): {pytorch.Tensor, pytorch.Tensor, pytorch.Tensor}.

pub unique_dim_consecutive_out(out0: pytorch.Tensor, out1: pytorch.Tensor, out2: pytorch.Tensor, input: pytorch.Tensor, dim: Int, return_inverse: Bool, return_counts: Bool): Unit.

pub unique_dim_out(out0: pytorch.Tensor, out1: pytorch.Tensor, out2: pytorch.Tensor, input: pytorch.Tensor, dim: Int, sorted: Bool, return_inverse: Bool, return_counts: Bool): Unit.

/// Preserves the legacy Tensor.unique flatten and optional-dimension contract.

pub unique_legacy(input: pytorch.Tensor, dim: std.core.Option[Int], sorted: Bool = true, return_inverse: Bool = false, return_counts: Bool = false): {pytorch.Tensor, pytorch.Tensor, pytorch.Tensor}.
