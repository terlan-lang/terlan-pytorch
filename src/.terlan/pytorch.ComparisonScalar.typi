//! Typed scalar, retained-output, and in-place comparison operations.

module pytorch.ComparisonScalar.

/// Returns eq comparison with a Float scalar right operand.

pub eq_right_float(tensor: Tensor, scalar: Float): Tensor.

/// Applies eq comparison with a Float scalar right operand in place.

pub eq_right_float_in_place(tensor: Tensor, scalar: Float): Unit.

/// Writes eq comparison with a Float scalar right operand.

pub eq_right_float_out(output: Tensor, tensor: Tensor, scalar: Float): Unit.

/// Returns eq comparison with a Int scalar right operand.

pub eq_right_int(tensor: Tensor, scalar: Int): Tensor.

/// Applies eq comparison with a Int scalar right operand in place.

pub eq_right_int_in_place(tensor: Tensor, scalar: Int): Unit.

/// Writes eq comparison with a Int scalar right operand.

pub eq_right_int_out(output: Tensor, tensor: Tensor, scalar: Int): Unit.

/// Applies eq comparison with a tensor right operand in place.

pub eq_tensor_in_place(left: Tensor, right: Tensor): Unit.

/// Writes eq comparison for two tensors into retained output storage.

pub eq_tensor_out(output: Tensor, left: Tensor, right: Tensor): Unit.

