//! Bartlett, Blackman, Hamming, Hann, and Kaiser signal-processing windows.

module pytorch.Window.

/// Constructs a periodic CPU float32 Bartlett window.

pub bartlett_window(window_length: Int): pytorch.Tensor.

/// Constructs a CPU float32 Bartlett window with explicit periodicity.

pub bartlett_window(window_length: Int, periodic: Bool): pytorch.Tensor.

/// Constructs a Bartlett window with explicit tensor options.

pub bartlett_window_on(window_length: Int, periodic: Bool, dtype: pytorch.Tensor.DType, device: pytorch.Tensor.Device, pin_memory: Bool): pytorch.Tensor.

/// Writes a periodic Bartlett window into retained tensor storage.

pub bartlett_window_out(output: pytorch.Tensor, window_length: Int): Unit.

/// Writes a Bartlett window with explicit periodicity into retained storage.

pub bartlett_window_out(output: pytorch.Tensor, window_length: Int, periodic: Bool): Unit.

/// Constructs a periodic CPU float32 Blackman window.

pub blackman_window(window_length: Int): pytorch.Tensor.

/// Constructs a CPU float32 Blackman window with explicit periodicity.

pub blackman_window(window_length: Int, periodic: Bool): pytorch.Tensor.

/// Constructs a Blackman window with explicit tensor options.

pub blackman_window_on(window_length: Int, periodic: Bool, dtype: pytorch.Tensor.DType, device: pytorch.Tensor.Device, pin_memory: Bool): pytorch.Tensor.

/// Writes a periodic Blackman window into retained tensor storage.

pub blackman_window_out(output: pytorch.Tensor, window_length: Int): Unit.

/// Writes a Blackman window with explicit periodicity into retained storage.

pub blackman_window_out(output: pytorch.Tensor, window_length: Int, periodic: Bool): Unit.

/// Constructs a periodic CPU float32 Hamming window with PyTorch coefficients.

pub hamming_window(window_length: Int): pytorch.Tensor.

/// Constructs a CPU float32 Hamming window with explicit periodicity.

pub hamming_window(window_length: Int, periodic: Bool): pytorch.Tensor.

/// Constructs a Hamming window with explicit alpha and default beta.

pub hamming_window(window_length: Int, periodic: Bool, alpha: Float): pytorch.Tensor.

/// Constructs a CPU float32 Hamming window with explicit coefficients.

pub hamming_window(window_length: Int, periodic: Bool, alpha: Float, beta: Float): pytorch.Tensor.

/// Constructs a Hamming window with explicit coefficients and tensor options.

pub hamming_window_on(window_length: Int, periodic: Bool, alpha: Float, beta: Float, dtype: pytorch.Tensor.DType, device: pytorch.Tensor.Device, pin_memory: Bool): pytorch.Tensor.

/// Writes a periodic default-coefficient Hamming window into retained storage.

pub hamming_window_out(output: pytorch.Tensor, window_length: Int): Unit.

/// Writes a default-coefficient Hamming window with explicit periodicity.

pub hamming_window_out(output: pytorch.Tensor, window_length: Int, periodic: Bool): Unit.

/// Writes a Hamming window with explicit alpha and default beta.

pub hamming_window_out(output: pytorch.Tensor, window_length: Int, periodic: Bool, alpha: Float): Unit.

/// Writes a Hamming window with explicit coefficients into retained storage.

pub hamming_window_out(output: pytorch.Tensor, window_length: Int, periodic: Bool, alpha: Float, beta: Float): Unit.

/// Constructs a periodic CPU float32 Hann window.

pub hann_window(window_length: Int): pytorch.Tensor.

/// Constructs a CPU float32 Hann window with explicit periodicity.

pub hann_window(window_length: Int, periodic: Bool): pytorch.Tensor.

/// Constructs a Hann window with explicit tensor options.

pub hann_window_on(window_length: Int, periodic: Bool, dtype: pytorch.Tensor.DType, device: pytorch.Tensor.Device, pin_memory: Bool): pytorch.Tensor.

/// Writes a periodic Hann window into retained tensor storage.

pub hann_window_out(output: pytorch.Tensor, window_length: Int): Unit.

/// Writes a Hann window with explicit periodicity into retained storage.

pub hann_window_out(output: pytorch.Tensor, window_length: Int, periodic: Bool): Unit.

/// Constructs a periodic CPU float32 Kaiser window with PyTorch beta.

pub kaiser_window(window_length: Int): pytorch.Tensor.

/// Constructs a default-beta CPU float32 Kaiser window.

pub kaiser_window(window_length: Int, periodic: Bool): pytorch.Tensor.

/// Constructs a CPU float32 Kaiser window with explicit beta.

pub kaiser_window(window_length: Int, periodic: Bool, beta: Float): pytorch.Tensor.

/// Constructs a Kaiser window with explicit beta and tensor options.

pub kaiser_window_on(window_length: Int, periodic: Bool, beta: Float, dtype: pytorch.Tensor.DType, device: pytorch.Tensor.Device, pin_memory: Bool): pytorch.Tensor.

/// Writes a periodic default-beta Kaiser window into retained storage.

pub kaiser_window_out(output: pytorch.Tensor, window_length: Int): Unit.

/// Writes a default-beta Kaiser window with explicit periodicity.

pub kaiser_window_out(output: pytorch.Tensor, window_length: Int, periodic: Bool): Unit.

/// Writes a Kaiser window with explicit beta into retained storage.

pub kaiser_window_out(output: pytorch.Tensor, window_length: Int, periodic: Bool, beta: Float): Unit.
