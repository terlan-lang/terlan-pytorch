pub histogram_bins_tensor_out(hist: pytorch.Tensor, bin_edges: pytorch.Tensor, input: pytorch.Tensor, bins: pytorch.Tensor, has_weight: Bool, weight: pytorch.Tensor, density: Bool): Unit.

pub histogramdd_bins(input: pytorch.Tensor, bins: List[Int], has_range: Bool, range: List[Float], has_weight: Bool, weight: pytorch.Tensor, density: Bool): {pytorch.Tensor, List[pytorch.Tensor]}.

pub histogramdd_int(input: pytorch.Tensor, bins: Int, has_range: Bool, range: List[Float], has_weight: Bool, weight: pytorch.Tensor, density: Bool): {pytorch.Tensor, List[pytorch.Tensor]}.

pub histogramdd_tensor_bins(input: pytorch.Tensor, bins: List[pytorch.Tensor], has_range: Bool, range: List[Float], has_weight: Bool, weight: pytorch.Tensor, density: Bool): {pytorch.Tensor, List[pytorch.Tensor]}.
