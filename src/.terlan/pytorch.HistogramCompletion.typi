pub histogram_bin_ct_out(hist: pytorch.Tensor, bin_edges: pytorch.Tensor, input: pytorch.Tensor, bins: Int, has_range: Bool, range: List[Float], has_weight: Bool, weight: pytorch.Tensor, density: Bool): Unit.

