//! Typed indexed addition, copy mutation, selection output, and selection gradients.

module pytorch.IndexMutation.

/// Adds source slices at explicit indices with a floating-point alpha.

pub index_add_float(input: pytorch.Tensor, dimension: Int, index: pytorch.Tensor, source: pytorch.Tensor, alpha: Float): pytorch.Tensor.

/// Adds source slices with a floating-point alpha into the input in place.

pub index_add_float_in_place(input: pytorch.Tensor, dimension: Int, index: pytorch.Tensor, source: pytorch.Tensor, alpha: Float): Unit.

/// Writes indexed addition with a floating-point alpha into retained output storage.

pub index_add_float_out(output: pytorch.Tensor, input: pytorch.Tensor, dimension: Int, index: pytorch.Tensor, source: pytorch.Tensor, alpha: Float): Unit.

/// Adds source slices at explicit indices with an integer alpha.

pub index_add_int(input: pytorch.Tensor, dimension: Int, index: pytorch.Tensor, source: pytorch.Tensor, alpha: Int = 1): pytorch.Tensor.

/// Adds source slices with an integer alpha into the input in place.

pub index_add_int_in_place(input: pytorch.Tensor, dimension: Int, index: pytorch.Tensor, source: pytorch.Tensor, alpha: Int = 1): Unit.

/// Writes indexed addition with an integer alpha into retained output storage.

pub index_add_int_out(output: pytorch.Tensor, input: pytorch.Tensor, dimension: Int, index: pytorch.Tensor, source: pytorch.Tensor, alpha: Int = 1): Unit.

/// Copies indexed source slices into the input in place.

pub index_copy_in_place(input: pytorch.Tensor, dimension: Int, index: pytorch.Tensor, source: pytorch.Tensor): Unit.

/// Writes indexed source slices into retained output storage.

pub index_copy_out(output: pytorch.Tensor, input: pytorch.Tensor, dimension: Int, index: pytorch.Tensor, source: pytorch.Tensor): Unit.

/// Scatters selected gradients back into the original input shape.

pub index_select_backward(gradient: pytorch.Tensor, input_shape: List[Int], dimension: Int, index: pytorch.Tensor): pytorch.Tensor.

/// Writes selected slices into retained output storage.

pub index_select_out(output: pytorch.Tensor, input: pytorch.Tensor, dimension: Int, index: pytorch.Tensor): Unit.
