//! Generated exact CXX quantized CPU normalization surface.

module pytorch.QuantizedNormalization.

/// Exact generated CXX quantized batch-normalization leaf.

pub quantized_batch_norm(input: Tensor, has_weight: Bool, weight: Tensor, has_bias: Bool, bias: Tensor, mean: Tensor, var: Tensor, eps: Float, output_scale: Float, output_zero_point: Int): Tensor.

/// Exact generated CXX quantized batch-normalization output leaf.

pub quantized_batch_norm_out(out: Tensor, input: Tensor, has_weight: Bool, weight: Tensor, has_bias: Bool, bias: Tensor, mean: Tensor, var: Tensor, eps: Float, output_scale: Float, output_zero_point: Int): Unit.
