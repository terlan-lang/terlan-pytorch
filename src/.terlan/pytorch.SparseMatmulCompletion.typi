//! Generated exact CXX sparse matrix multiplication forms.

module pytorch.SparseMatmulCompletion.

/// Exact hspmm form.

pub hspmm_default(mat1: pytorch.Tensor, mat2: pytorch.Tensor): pytorch.Tensor.

/// Exact hspmm output form.

pub hspmm_out_default(out: pytorch.Tensor, mat1: pytorch.Tensor, mat2: pytorch.Tensor): Unit.

/// Exact smm form.

pub smm_default(self: pytorch.Tensor, mat2: pytorch.Tensor): pytorch.Tensor.

/// Exact sspaddmm form.

pub sspaddmm_default(self: pytorch.Tensor, mat1: pytorch.Tensor, mat2: pytorch.Tensor, beta: Float = 1.0, alpha: Float = 1.0): pytorch.Tensor.

/// Exact sspaddmm output form.

pub sspaddmm_out_default(out: pytorch.Tensor, self: pytorch.Tensor, mat1: pytorch.Tensor, mat2: pytorch.Tensor, beta: Float = 1.0, alpha: Float = 1.0): Unit.
