/// Jagged tensor layout.

pub type Jagged =
    Atom["jagged"].

/// Finite public layouts generated from c10::Layout.

pub type Layout =
    Atom["strided"]
  | Atom["sparse_coo"]
  | Atom["sparse_csr"]
  | Atom["mkldnn"]
  | Atom["sparse_csc"]
  | Atom["sparse_bsr"]
  | Atom["sparse_bsc"]
