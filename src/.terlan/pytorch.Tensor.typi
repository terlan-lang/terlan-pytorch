//! Generated CXX-owned LibTorch tensor resources and migration support.

module pytorch.Tensor.

/// Brain floating-point 16-bit dtype.

pub type BFloat16 =
    Atom["bfloat16"].

/// Opaque 16-bit dtype.

pub type Bits16 =
    Atom["bits16"].

/// Packed one-bit dtype.

pub type Bits1x8 =
    Atom["bits1x8"].

/// Packed two-bit dtype.

pub type Bits2x4 =
    Atom["bits2x4"].

/// Packed four-bit dtype.

pub type Bits4x2 =
    Atom["bits4x2"].

/// Opaque 8-bit dtype.

pub type Bits8 =
    Atom["bits8"].

/// Boolean dtype.

pub type Bool =
    Atom["bool"].

/// Complex double-precision dtype.

pub type Complex128 =
    Atom["complex128"].

/// Complex half-precision dtype.

pub type Complex32 =
    Atom["complex32"].

/// Complex single-precision dtype.

pub type Complex64 =
    Atom["complex64"].

/// Finite public dtype values generated from c10::ScalarType.

pub type DType: Int =
    UINT8 = 0
  | INT8 = 1
  | INT16 = 2
  | INT32 = 3
  | INT64 = 4
  | FLOAT16 = 5
  | FLOAT32 = 6
  | FLOAT64 = 7
  | COMPLEX32 = 8
  | COMPLEX64 = 9
  | COMPLEX128 = 10
  | BOOL = 11
  | QINT8 = 12
  | QUINT8 = 13
  | QINT32 = 14
  | BFLOAT16 = 15
  | QUINT4X2 = 16
  | QUINT2X4 = 17
  | BITS1X8 = 18
  | BITS2X4 = 19
  | BITS4X2 = 20
  | BITS8 = 21
  | BITS16 = 22
  | FLOAT8_E5M2 = 23
  | FLOAT8_E4M3FN = 24
  | FLOAT8_E5M2FNUZ = 25
  | FLOAT8_E4M3FNUZ = 26
  | UINT16 = 27
  | UINT32 = 28
  | UINT64 = 29
  | UINT1 = 30
  | UINT2 = 31
  | UINT3 = 32
  | UINT4 = 33
  | UINT5 = 34
  | UINT6 = 35
  | UINT7 = 36
  | INT1 = 37
  | INT2 = 38
  | INT3 = 39
  | INT4 = 40
  | INT5 = 41
  | INT6 = 42
  | INT7 = 43
  | FLOAT8_E8M0FNU = 44
  | FLOAT4_E2M1FN_X2 = 45.

/// Validated LibTorch device spelling such as cpu or cuda:0.

pub type Device =
    String.

/// IEEE half-precision floating dtype.

pub type Float16 =
    Atom["float16"].

/// IEEE single-precision floating dtype.

pub type Float32 =
    Atom["float32"].

/// Packed 4-bit E2M1 floating dtype.

pub type Float4E2M1FnX2 =
    Atom["float4_e2m1fn_x2"].

/// IEEE double-precision floating dtype.

pub type Float64 =
    Atom["float64"].

/// 8-bit E4M3 finite floating dtype.

pub type Float8E4M3Fn =
    Atom["float8_e4m3fn"].

/// 8-bit E4M3 FNUZ floating dtype.

pub type Float8E4M3Fnuz =
    Atom["float8_e4m3fnuz"].

/// 8-bit E5M2 floating dtype.

pub type Float8E5M2 =
    Atom["float8_e5m2"].

/// 8-bit E5M2 FNUZ floating dtype.

pub type Float8E5M2Fnuz =
    Atom["float8_e5m2fnuz"].

/// 8-bit E8M0 finite floating dtype.

pub type Float8E8M0Fnu =
    Atom["float8_e8m0fnu"].

