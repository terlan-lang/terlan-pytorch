/// Signed 4-bit integer dtype.

pub type Int4 =
    Atom["int4"].

/// Signed 5-bit integer dtype.

pub type Int5 =
    Atom["int5"].

/// Signed 6-bit integer dtype.

pub type Int6 =
    Atom["int6"].

/// Signed 64-bit integer dtype.

pub type Int64 =
    Atom["int64"].

/// Signed 7-bit integer dtype.

pub type Int7 =
