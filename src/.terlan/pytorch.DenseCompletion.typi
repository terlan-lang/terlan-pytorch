//! Typed completion wrappers for dense matrix operations with explicit output dtype.

module pytorch.DenseCompletion.

pub bmm_dtype(left: pytorch.Tensor, right: pytorch.Tensor, out_dtype: Int): pytorch.Tensor.

pub bmm_dtype_out(output: pytorch.Tensor, left: pytorch.Tensor, right: pytorch.Tensor, out_dtype: Int): Unit.

pub mm_dtype(left: pytorch.Tensor, right: pytorch.Tensor, out_dtype: Int): pytorch.Tensor.

pub mm_dtype_out(output: pytorch.Tensor, left: pytorch.Tensor, right: pytorch.Tensor, out_dtype: Int): Unit.
