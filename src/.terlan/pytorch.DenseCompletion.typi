//! Typed completion wrappers for dense matrix operations with explicit output dtype.

module pytorch.DenseCompletion.

pub bmm_dtype(left: Tensor, right: Tensor, out_dtype: Int): Tensor.

pub bmm_dtype_out(output: Tensor, left: Tensor, right: Tensor, out_dtype: Int): Unit.

pub mm_dtype(left: Tensor, right: Tensor, out_dtype: Int): Tensor.

pub mm_dtype_out(output: Tensor, left: Tensor, right: Tensor, out_dtype: Int): Unit.
