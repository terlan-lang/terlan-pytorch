//! Exact paired correction-based standard-deviation, variance, and mean operations.

module pytorch.CorrectionStatisticsPairCompletion.

/// Computes dimension-wise paired standard deviation and mean with floating correction.

pub std_mean_correction_dimensions_float(input: pytorch.Tensor, dimensions: List[Int], correction: Float, keep_dimension: Bool): {pytorch.Tensor, pytorch.Tensor}.

/// Computes dimension-wise paired standard deviation and mean with integer correction.

pub std_mean_correction_dimensions_int(input: pytorch.Tensor, dimensions: List[Int], correction: Int, keep_dimension: Bool): {pytorch.Tensor, pytorch.Tensor}.

/// Computes paired standard deviation and mean with floating correction.

pub std_mean_correction_float(input: pytorch.Tensor, correction: Float, keep_dimension: Bool): {pytorch.Tensor, pytorch.Tensor}.

/// Computes paired standard deviation and mean with integer correction.

pub std_mean_correction_int(input: pytorch.Tensor, correction: Int, keep_dimension: Bool): {pytorch.Tensor, pytorch.Tensor}.

/// Writes dimension-wise paired standard deviation and mean with floating correction into retained outputs.

pub std_mean_correction_out_dimensions_float(output: pytorch.Tensor, mean_output: pytorch.Tensor, input: pytorch.Tensor, dimensions: List[Int], correction: Float, keep_dimension: Bool): Unit.

/// Writes dimension-wise paired standard deviation and mean with integer correction into retained outputs.

pub std_mean_correction_out_dimensions_int(output: pytorch.Tensor, mean_output: pytorch.Tensor, input: pytorch.Tensor, dimensions: List[Int], correction: Int, keep_dimension: Bool): Unit.

/// Writes paired standard deviation and mean with floating correction into retained outputs.

pub std_mean_correction_out_float(output: pytorch.Tensor, mean_output: pytorch.Tensor, input: pytorch.Tensor, correction: Float, keep_dimension: Bool): Unit.

/// Writes paired standard deviation and mean with integer correction into retained outputs.

pub std_mean_correction_out_int(output: pytorch.Tensor, mean_output: pytorch.Tensor, input: pytorch.Tensor, correction: Int, keep_dimension: Bool): Unit.

/// Computes dimension-wise paired variance and mean with floating correction.

pub var_mean_correction_dimensions_float(input: pytorch.Tensor, dimensions: List[Int], correction: Float, keep_dimension: Bool): {pytorch.Tensor, pytorch.Tensor}.

/// Computes dimension-wise paired variance and mean with integer correction.

pub var_mean_correction_dimensions_int(input: pytorch.Tensor, dimensions: List[Int], correction: Int, keep_dimension: Bool): {pytorch.Tensor, pytorch.Tensor}.

/// Computes paired variance and mean with floating correction.

pub var_mean_correction_float(input: pytorch.Tensor, correction: Float, keep_dimension: Bool): {pytorch.Tensor, pytorch.Tensor}.

/// Computes paired variance and mean with integer correction.

pub var_mean_correction_int(input: pytorch.Tensor, correction: Int, keep_dimension: Bool): {pytorch.Tensor, pytorch.Tensor}.

/// Writes dimension-wise paired variance and mean with floating correction into retained outputs.

pub var_mean_correction_out_dimensions_float(output: pytorch.Tensor, mean_output: pytorch.Tensor, input: pytorch.Tensor, dimensions: List[Int], correction: Float, keep_dimension: Bool): Unit.

/// Writes dimension-wise paired variance and mean with integer correction into retained outputs.

pub var_mean_correction_out_dimensions_int(output: pytorch.Tensor, mean_output: pytorch.Tensor, input: pytorch.Tensor, dimensions: List[Int], correction: Int, keep_dimension: Bool): Unit.

/// Writes paired variance and mean with floating correction into retained outputs.

pub var_mean_correction_out_float(output: pytorch.Tensor, mean_output: pytorch.Tensor, input: pytorch.Tensor, correction: Float, keep_dimension: Bool): Unit.

/// Writes paired variance and mean with integer correction into retained outputs.

pub var_mean_correction_out_int(output: pytorch.Tensor, mean_output: pytorch.Tensor, input: pytorch.Tensor, correction: Int, keep_dimension: Bool): Unit.
