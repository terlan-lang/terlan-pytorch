//! Generated direct CXX range, identity, and endpoint-spacing primitives.

module pytorch.RangeNative.

/// Creates an exact arange overload with integer-preserving scalar inference and explicit option presence.

pub arange_exact_native(form: Int, start_is_integer: Bool, start_integer: Int, start_floating: Float, end_is_integer: Bool, end_integer: Int, end_floating: Float, step_is_integer: Bool, step_integer: Int, step_floating: Float, dtype: Int, has_dtype: Bool, layout: Int, has_layout: Bool, device_type: Int, device_index: Int, has_device: Bool, pin_memory: Bool, has_pin_memory: Bool): pytorch.Tensor.

/// Writes an exact arange overload into retained tensor storage.

pub arange_out_exact_native(output: pytorch.Tensor, form: Int, start_is_integer: Bool, start_integer: Int, start_floating: Float, end_is_integer: Bool, end_integer: Int, end_floating: Float, step_is_integer: Bool, step_integer: Int, step_floating: Float): Unit.

/// Creates an exact square or rectangular identity overload with explicit option presence.

pub eye_exact_native(rows: Int, columns: Int, rectangular: Bool, dtype: Int, has_dtype: Bool, layout: Int, has_layout: Bool, device_type: Int, device_index: Int, has_device: Bool, pin_memory: Bool, has_pin_memory: Bool): pytorch.Tensor.

/// Writes a square or rectangular identity into retained tensor storage.

pub eye_out_exact_native(output: pytorch.Tensor, rows: Int, columns: Int, rectangular: Bool): Unit.

/// Creates an inclusive legacy range with exact scalar kinds and option presence.

pub range_exact_native(explicit_step: Bool, start_is_integer: Bool, start_integer: Int, start_floating: Float, end_is_integer: Bool, end_integer: Int, end_floating: Float, step_is_integer: Bool, step_integer: Int, step_floating: Float, dtype: Int, has_dtype: Bool, layout: Int, has_layout: Bool, device_type: Int, device_index: Int, has_device: Bool, pin_memory: Bool, has_pin_memory: Bool): pytorch.Tensor.

/// Writes an inclusive legacy range into retained tensor storage.

pub range_out_exact_native(output: pytorch.Tensor, explicit_step: Bool, start_is_integer: Bool, start_integer: Int, start_floating: Float, end_is_integer: Bool, end_integer: Int, end_floating: Float, step_is_integer: Bool, step_integer: Int, step_floating: Float): Unit.

/// Creates exact scalar-endpoint linspace or logspace output.

pub spacing_scalar_exact_native(operation: Int, start_is_integer: Bool, start_integer: Int, start_floating: Float, end_is_integer: Bool, end_integer: Int, end_floating: Float, steps: Int, base: Float, dtype: Int, has_dtype: Bool, layout: Int, has_layout: Bool, device_type: Int, device_index: Int, has_device: Bool, pin_memory: Bool, has_pin_memory: Bool): pytorch.Tensor.

/// Writes scalar-endpoint linspace or logspace output into retained storage.

pub spacing_scalar_out_exact_native(output: pytorch.Tensor, operation: Int, start_is_integer: Bool, start_integer: Int, start_floating: Float, end_is_integer: Bool, end_integer: Int, end_floating: Float, steps: Int, base: Float): Unit.

/// Creates exact scalar-to-tensor linspace or logspace output.

pub spacing_scalar_tensor_exact_native(operation: Int, start_is_integer: Bool, start_integer: Int, start_floating: Float, end: pytorch.Tensor, steps: Int, base: Float, dtype: Int, has_dtype: Bool, layout: Int, has_layout: Bool, device_type: Int, device_index: Int, has_device: Bool, pin_memory: Bool, has_pin_memory: Bool): pytorch.Tensor.

/// Writes scalar-to-tensor linspace or logspace output into retained storage.

pub spacing_scalar_tensor_out_exact_native(output: pytorch.Tensor, operation: Int, start_is_integer: Bool, start_integer: Int, start_floating: Float, end: pytorch.Tensor, steps: Int, base: Float): Unit.

/// Creates exact tensor-to-scalar linspace or logspace output.

pub spacing_tensor_scalar_exact_native(operation: Int, start: pytorch.Tensor, end_is_integer: Bool, end_integer: Int, end_floating: Float, steps: Int, base: Float, dtype: Int, has_dtype: Bool, layout: Int, has_layout: Bool, device_type: Int, device_index: Int, has_device: Bool, pin_memory: Bool, has_pin_memory: Bool): pytorch.Tensor.

/// Writes tensor-to-scalar linspace or logspace output into retained storage.

pub spacing_tensor_scalar_out_exact_native(output: pytorch.Tensor, operation: Int, start: pytorch.Tensor, end_is_integer: Bool, end_integer: Int, end_floating: Float, steps: Int, base: Float): Unit.

/// Creates exact tensor-endpoint linspace or logspace output.

pub spacing_tensor_tensor_exact_native(operation: Int, start: pytorch.Tensor, end: pytorch.Tensor, steps: Int, base: Float, dtype: Int, has_dtype: Bool, layout: Int, has_layout: Bool, device_type: Int, device_index: Int, has_device: Bool, pin_memory: Bool, has_pin_memory: Bool): pytorch.Tensor.

