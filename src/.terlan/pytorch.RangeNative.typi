pub triu_indices_exact(row: Int, col: Int, offset: Int, has_dtype: Bool, dtype: Int, has_layout: Bool, layout: Int, has_device: Bool, device: pytorch.Tensor.Device, has_pin_memory: Bool, pin_memory: Bool): pytorch.Tensor.

