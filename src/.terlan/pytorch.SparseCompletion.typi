//! Compatibility aliases for legacy dense-to-COO tensor methods.

module pytorch.SparseCompletion.

/// Exact sparse reduction adapter for torch.sparse.sum.

pub sparse_sum(input: Tensor, dimensions: List[Int], has_dimensions: Bool, dtype: Int, has_dtype: Bool): Tensor.

/// Converts a dense tensor to the default sparse COO layout.

pub to_sparse_coo(input: Tensor): Tensor.
