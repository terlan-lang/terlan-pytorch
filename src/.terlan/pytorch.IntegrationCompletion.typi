//! Exact cumulative trapezoid, trapezoid, trapz, and KL-divergence dispatcher primitives.

module pytorch.IntegrationCompletion.

/// Computes exact aten::cumulative_trapezoid.dx with a floating Scalar spacing.

pub cumulative_trapezoid_dx_float(y: pytorch.Tensor, dx: Float, dimension: Int): pytorch.Tensor.

/// Computes exact aten::cumulative_trapezoid.dx with an integer Scalar spacing.

pub cumulative_trapezoid_dx_int(y: pytorch.Tensor, dx: Int, dimension: Int): pytorch.Tensor.

/// Computes exact aten::cumulative_trapezoid.x with tensor coordinates.

pub cumulative_trapezoid_x(y: pytorch.Tensor, x: pytorch.Tensor, dimension: Int): pytorch.Tensor.

/// Computes exact aten::kl_div with explicit reduction and target representation.

pub kl_div(input: pytorch.Tensor, target: pytorch.Tensor, reduction: Int, log_target: Bool): pytorch.Tensor.

/// Computes exact aten::trapezoid.dx with a floating Scalar spacing.

pub trapezoid_dx_float(y: pytorch.Tensor, dx: Float, dimension: Int): pytorch.Tensor.

/// Computes exact aten::trapezoid.dx with an integer Scalar spacing.

pub trapezoid_dx_int(y: pytorch.Tensor, dx: Int, dimension: Int): pytorch.Tensor.

/// Computes exact aten::trapezoid.x with tensor coordinates.

pub trapezoid_x(y: pytorch.Tensor, x: pytorch.Tensor, dimension: Int): pytorch.Tensor.

/// Computes exact aten::trapz.dx with floating spacing.

pub trapz_dx(y: pytorch.Tensor, dx: Float, dimension: Int): pytorch.Tensor.

/// Computes exact aten::trapz.x with tensor coordinates.

pub trapz_x(y: pytorch.Tensor, x: pytorch.Tensor, dimension: Int): pytorch.Tensor.
