//! Exact retained-output forms for established dense, shape, linalg, statistical, dropout, padding, and softmax kernels.

module pytorch.OutputCompletion.

/// Writes exact aten::complex.out into retained complex storage.

pub complex_out(output: pytorch.Tensor, real: pytorch.Tensor, imaginary: pytorch.Tensor): Unit.

/// Writes exact aten::dist.out into retained storage through the typed direct-ATen Scalar path.

pub dist_out(output: pytorch.Tensor, left: pytorch.Tensor, right: pytorch.Tensor, order: Float): Unit.

/// Writes exact aten::expand_copy.out into retained storage.

pub expand_copy_out(output: pytorch.Tensor, input: pytorch.Tensor, size: List[Int], implicit: Bool): Unit.

/// Writes exact aten::lu_solve.out into retained storage.

pub lu_solve_out(output: pytorch.Tensor, right: pytorch.Tensor, factor: pytorch.Tensor, pivots: pytorch.Tensor): Unit.

/// Writes exact aten::native_dropout_backward.out into retained storage.

pub native_dropout_backward_out(output: pytorch.Tensor, gradient: pytorch.Tensor, mask: pytorch.Tensor, scale: Float): Unit.

/// Writes exact aten::ormqr.out into retained storage.

pub ormqr_out(output: pytorch.Tensor, factor: pytorch.Tensor, tau: pytorch.Tensor, other: pytorch.Tensor, left: Bool, transpose: Bool): Unit.

/// Writes exact aten::polar.out into retained complex storage.

pub polar_out(output: pytorch.Tensor, absolute: pytorch.Tensor, angle: pytorch.Tensor): Unit.

/// Writes exact aten::reflection_pad1d.out.

pub reflection_pad1d_out(output: pytorch.Tensor, input: pytorch.Tensor, padding: List[Int]): Unit.

/// Writes exact aten::reflection_pad2d.out.

pub reflection_pad2d_out(output: pytorch.Tensor, input: pytorch.Tensor, padding: List[Int]): Unit.

/// Writes exact aten::reflection_pad3d.out.

pub reflection_pad3d_out(output: pytorch.Tensor, input: pytorch.Tensor, padding: List[Int]): Unit.

/// Writes exact aten::renorm.out into retained storage through the typed direct-ATen Scalar path.

pub renorm_out(output: pytorch.Tensor, input: pytorch.Tensor, order: Float, dimension: Int, maximum_norm: Float): Unit.

/// Writes exact aten::replication_pad1d.out.

pub replication_pad1d_out(output: pytorch.Tensor, input: pytorch.Tensor, padding: List[Int]): Unit.

/// Writes exact aten::replication_pad2d.out.

pub replication_pad2d_out(output: pytorch.Tensor, input: pytorch.Tensor, padding: List[Int]): Unit.

/// Writes exact aten::replication_pad3d.out.

pub replication_pad3d_out(output: pytorch.Tensor, input: pytorch.Tensor, padding: List[Int]): Unit.

/// Writes exact aten::slogdet.out tuple into retained storage.

pub slogdet_out(sign: pytorch.Tensor, log_absolute_determinant: pytorch.Tensor, input: pytorch.Tensor): Unit.

/// Writes exact aten::softmax.int_out with inferred dtype.

pub softmax_out(output: pytorch.Tensor, input: pytorch.Tensor, dimension: Int): Unit.
