//! Retained-output and in-place unary tensor operations.

module pytorch.UnaryStorage.

/// Mutates retained tensor storage with elementwise abs.

pub abs_in_place(tensor: Tensor): Unit.

/// Writes the elementwise abs result into retained output storage.

pub abs_out(output: Tensor, tensor: Tensor): Unit.

/// Mutates retained tensor storage through the exact absolute alias.

pub absolute_in_place(tensor: Tensor): Unit.

/// Writes the exact absolute alias result into retained output storage.

pub absolute_out(output: Tensor, tensor: Tensor): Unit.

