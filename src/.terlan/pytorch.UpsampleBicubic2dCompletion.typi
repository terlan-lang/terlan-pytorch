//! Generated CXX bicubic upsampling completion surface.

module pytorch.UpsampleBicubic2dCompletion.

/// Upsamples a 4-D tensor to an explicit output size using bicubic interpolation.

pub upsample_bicubic2d(input: pytorch.Tensor, output_size: List[Int], align_corners: Bool): pytorch.Tensor.

/// Writes a bicubic-upsampled tensor into retained output storage.

pub upsample_bicubic2d_out(output: pytorch.Tensor, input: pytorch.Tensor, output_size: List[Int], align_corners: Bool): Unit.
