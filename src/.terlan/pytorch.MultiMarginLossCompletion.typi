//! Generated CXX multi-margin-loss completion surface.

module pytorch.MultiMarginLossCompletion.

/// Exact generated CXX multi-margin-loss backward leaf.

pub multi_margin_loss_backward(gradient_output: pytorch.Tensor, input: pytorch.Tensor, target: pytorch.Tensor, p: Float, margin: Float, has_weight: Bool, weight: pytorch.Tensor, reduction: Int): pytorch.Tensor.

/// Exact generated CXX multi-margin-loss backward retained-output leaf.

pub multi_margin_loss_backward_out(grad_input: pytorch.Tensor, gradient_output: pytorch.Tensor, input: pytorch.Tensor, target: pytorch.Tensor, p: Float, margin: Float, has_weight: Bool, weight: pytorch.Tensor, reduction: Int): Unit.

/// Computes multi-margin loss without class weights.

pub multi_margin_loss_default(input: pytorch.Tensor, target: pytorch.Tensor, p: Float, margin: Float, reduction: Int): pytorch.Tensor.

/// Writes multi-margin loss into retained output without class weights.

pub multi_margin_loss_out_default(output: pytorch.Tensor, input: pytorch.Tensor, target: pytorch.Tensor, p: Float, margin: Float, reduction: Int): Unit.

/// Writes multi-margin loss into retained output with class weights.

pub multi_margin_loss_out_weight(output: pytorch.Tensor, input: pytorch.Tensor, target: pytorch.Tensor, p: Float, margin: Float, weight: pytorch.Tensor, reduction: Int): Unit.

/// Computes multi-margin loss with class weights.

pub multi_margin_loss_weight(input: pytorch.Tensor, target: pytorch.Tensor, p: Float, margin: Float, weight: pytorch.Tensor, reduction: Int): pytorch.Tensor.
