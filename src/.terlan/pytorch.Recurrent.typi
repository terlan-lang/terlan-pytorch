//! Generated exact CXX recurrent-operation completion surface.

module pytorch.Recurrent.

/// Exact generated CXX gated RNN sequence leaf.

pub gru(input: pytorch.Tensor, hx: pytorch.Tensor, params: List[pytorch.Tensor], has_biases: Bool, num_layers: Int, dropout: Float, train: Bool, bidirectional: Bool, batch_first: Bool): {pytorch.Tensor, pytorch.Tensor}.

/// Exact generated CXX gated RNN cell leaf.

pub gru_cell(input: pytorch.Tensor, hx: pytorch.Tensor, w_ih: pytorch.Tensor, w_hh: pytorch.Tensor, has_b_ih: Bool, b_ih: pytorch.Tensor, has_b_hh: Bool, b_hh: pytorch.Tensor): pytorch.Tensor.

/// Exact generated CXX LSTM sequence leaf.

pub lstm(input: pytorch.Tensor, hx: List[pytorch.Tensor], params: List[pytorch.Tensor], has_biases: Bool, num_layers: Int, dropout: Float, train: Bool, bidirectional: Bool, batch_first: Bool): {pytorch.Tensor, pytorch.Tensor, pytorch.Tensor}.

/// Exact generated CXX LSTM cell leaf.

pub lstm_cell(input: pytorch.Tensor, hx: List[pytorch.Tensor], w_ih: pytorch.Tensor, w_hh: pytorch.Tensor, has_b_ih: Bool, b_ih: pytorch.Tensor, has_b_hh: Bool, b_hh: pytorch.Tensor): {pytorch.Tensor, pytorch.Tensor}.

/// Exact generated CXX ReLU RNN sequence leaf.

pub rnn_relu(input: pytorch.Tensor, hx: pytorch.Tensor, params: List[pytorch.Tensor], has_biases: Bool, num_layers: Int, dropout: Float, train: Bool, bidirectional: Bool, batch_first: Bool): {pytorch.Tensor, pytorch.Tensor}.

/// Exact generated CXX ReLU RNN cell leaf.

pub rnn_relu_cell(input: pytorch.Tensor, hx: pytorch.Tensor, w_ih: pytorch.Tensor, w_hh: pytorch.Tensor, has_b_ih: Bool, b_ih: pytorch.Tensor, has_b_hh: Bool, b_hh: pytorch.Tensor): pytorch.Tensor.

/// Exact generated CXX tanh RNN sequence leaf.

pub rnn_tanh(input: pytorch.Tensor, hx: pytorch.Tensor, params: List[pytorch.Tensor], has_biases: Bool, num_layers: Int, dropout: Float, train: Bool, bidirectional: Bool, batch_first: Bool): {pytorch.Tensor, pytorch.Tensor}.

/// Exact generated CXX tanh RNN cell leaf.

pub rnn_tanh_cell(input: pytorch.Tensor, hx: pytorch.Tensor, w_ih: pytorch.Tensor, w_hh: pytorch.Tensor, has_b_ih: Bool, b_ih: pytorch.Tensor, has_b_hh: Bool, b_hh: pytorch.Tensor): pytorch.Tensor.
