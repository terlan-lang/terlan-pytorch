/// Returns values from a tensor with signs copied from a floating-point scalar.

pub copysign_right_float(tensor: pytorch.Tensor, scalar: Float): pytorch.Tensor.

/// Copies signs from a floating-point scalar into a tensor in place.

pub copysign_right_float_in_place(tensor: pytorch.Tensor, scalar: Float): Unit.

/// Writes values with signs copied from a floating-point scalar into retained storage.

pub copysign_right_float_out(output: pytorch.Tensor, tensor: pytorch.Tensor, scalar: Float): Unit.

/// Returns values from a tensor with signs copied from an integer scalar.

pub copysign_right_int(tensor: pytorch.Tensor, scalar: Int): pytorch.Tensor.

/// Copies signs from an integer scalar into a tensor in place.

pub copysign_right_int_in_place(tensor: pytorch.Tensor, scalar: Int): Unit.

/// Writes values with signs copied from an integer scalar into retained storage.

pub copysign_right_int_out(output: pytorch.Tensor, tensor: pytorch.Tensor, scalar: Int): Unit.

