/// Writes elementwise bitwise left shift with an integer scalar right operand.

pub bitwise_left_shift_right_int_out(output: pytorch.Tensor, tensor: pytorch.Tensor, scalar: Int): Unit.

/// Applies elementwise bitwise left shift with a tensor right operand in place.

pub bitwise_left_shift_tensor_in_place(left: pytorch.Tensor, right: pytorch.Tensor): Unit.

/// Writes elementwise bitwise left shift for two tensors into retained output storage.

pub bitwise_left_shift_tensor_out(output: pytorch.Tensor, left: pytorch.Tensor, right: pytorch.Tensor): Unit.

