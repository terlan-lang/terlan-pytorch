//! Typed scalar, retained-output, and in-place binary operations.

module pytorch.BinaryScalar.

/// Returns elementwise bitwise AND with an integer scalar left operand.

pub bitwise_and_left_int(scalar: Int, tensor: pytorch.Tensor): pytorch.Tensor.

/// Writes elementwise bitwise AND with an integer scalar left operand.

pub bitwise_and_left_int_out(output: pytorch.Tensor, scalar: Int, tensor: pytorch.Tensor): Unit.

/// Returns elementwise bitwise AND with an integer scalar right operand.

pub bitwise_and_right_int(tensor: pytorch.Tensor, scalar: Int): pytorch.Tensor.

/// Applies elementwise bitwise AND with an integer scalar right operand in place.

pub bitwise_and_right_int_in_place(tensor: pytorch.Tensor, scalar: Int): Unit.

/// Writes elementwise bitwise AND with an integer scalar right operand.

pub bitwise_and_right_int_out(output: pytorch.Tensor, tensor: pytorch.Tensor, scalar: Int): Unit.

/// Applies elementwise bitwise AND with a tensor right operand in place.

pub bitwise_and_tensor_in_place(left: pytorch.Tensor, right: pytorch.Tensor): Unit.

/// Writes elementwise bitwise AND for two tensors into retained output storage.

pub bitwise_and_tensor_out(output: pytorch.Tensor, left: pytorch.Tensor, right: pytorch.Tensor): Unit.

