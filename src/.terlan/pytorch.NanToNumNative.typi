//! Exact nan-to-number operations with independent optional replacement presence.

module pytorch.NanToNumNative.

/// Replaces non-finite values with independently present replacement values.

pub nan_to_num_configured(input: pytorch.Tensor, has_nan: Bool, nan: Float, has_posinf: Bool, posinf: Float, has_neginf: Bool, neginf: Float): pytorch.Tensor.

/// Replaces non-finite tensor values in place.

pub nan_to_num_configured_in_place(input: pytorch.Tensor, has_nan: Bool, nan: Float, has_posinf: Bool, posinf: Float, has_neginf: Bool, neginf: Float): Unit.

/// Writes non-finite replacement results into retained output storage.

pub nan_to_num_configured_out(output: pytorch.Tensor, input: pytorch.Tensor, has_nan: Bool, nan: Float, has_posinf: Bool, posinf: Float, has_neginf: Bool, neginf: Float): Unit.
