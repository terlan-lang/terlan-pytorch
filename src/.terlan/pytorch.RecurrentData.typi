/// Exact generated CXX packed gated RNN sequence leaf.

pub gru_data(data: Tensor, batch_sizes: Tensor, hx: Tensor, params: List[Tensor], has_biases: Bool, num_layers: Int, dropout: Float, train: Bool, bidirectional: Bool): {Tensor, Tensor}.

/// Exact generated CXX packed LSTM sequence leaf.

pub lstm_data(data: Tensor, batch_sizes: Tensor, hx: List[Tensor], params: List[Tensor], has_biases: Bool, num_layers: Int, dropout: Float, train: Bool, bidirectional: Bool): {Tensor, Tensor, Tensor}.

/// Exact generated CXX packed ReLU RNN sequence leaf.

pub rnn_relu_data(data: Tensor, batch_sizes: Tensor, hx: Tensor, params: List[Tensor], has_biases: Bool, num_layers: Int, dropout: Float, train: Bool, bidirectional: Bool): {Tensor, Tensor}.

/// Exact generated CXX packed tanh RNN sequence leaf.

pub rnn_tanh_data(data: Tensor, batch_sizes: Tensor, hx: Tensor, params: List[Tensor], has_biases: Bool, num_layers: Int, dropout: Float, train: Bool, bidirectional: Bool): {Tensor, Tensor}.
