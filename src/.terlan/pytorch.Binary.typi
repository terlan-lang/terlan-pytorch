//! Exact direct CXX binary arithmetic, comparison, logical, bitwise, selection, contraction, and special-function operations.

module pytorch.Binary.

/// Executes the exact aten::arctan2 two-tensor schema with independently owned dispatcher inputs.

pub arctan2(left: pytorch.Tensor, right: pytorch.Tensor): pytorch.Tensor.

/// Mutates retained tensor storage through exact aten::arctan2_.

pub arctan2_in_place(left: pytorch.Tensor, right: pytorch.Tensor): Unit.

/// Writes the exact aten::arctan2.out result into retained output storage.

pub arctan2_out(output: pytorch.Tensor, left: pytorch.Tensor, right: pytorch.Tensor): Unit.

