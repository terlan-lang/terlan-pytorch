//! Exact stable sorting output, distance, matrix-chain, clone, contiguity, and cross-product primitives.

module pytorch.NumericalCompletionNative.

/// Writes exact aten::argsort.stable_out indices into retained storage.

pub argsort_stable_out(output: pytorch.Tensor, tensor: pytorch.Tensor, stable: Bool, dimension: Int, descending: Bool): Unit.

/// Computes exact aten::cdist with an explicit compute mode.

pub cdist_compute(left: pytorch.Tensor, right: pytorch.Tensor, p: Float, compute_mode: Int): pytorch.Tensor.

/// Computes exact aten::cdist with inferred compute mode.

pub cdist_default_compute(left: pytorch.Tensor, right: pytorch.Tensor, p: Float): pytorch.Tensor.

/// Computes exact aten::chain_matmul over an owned tensor-handle list.

pub chain_matmul_native(matrices: List[pytorch.Tensor]): pytorch.Tensor.

/// Writes exact aten::chain_matmul.out into retained storage.

pub chain_matmul_out_native(output: pytorch.Tensor, matrices: List[pytorch.Tensor]): Unit.

/// Writes exact aten::clone.out with inferred memory format.

pub clone_out_default_memory(output: pytorch.Tensor, tensor: pytorch.Tensor): Unit.

/// Writes exact aten::clone.out with an explicit memory format.

pub clone_out_memory(output: pytorch.Tensor, tensor: pytorch.Tensor, memory_format: Int): Unit.

/// Executes exact aten::contiguous with explicit memory format and alias-preserving semantics.

pub contiguous_native(tensor: pytorch.Tensor, memory_format: Int): pytorch.Tensor.

/// Computes exact aten::cross with inferred dimension.

pub cross_default_dimension(tensor: pytorch.Tensor, other: pytorch.Tensor): pytorch.Tensor.

/// Computes exact aten::cross with explicit dimension.

pub cross_dimension(tensor: pytorch.Tensor, other: pytorch.Tensor, dimension: Int): pytorch.Tensor.

/// Writes exact aten::cross.out with inferred dimension.

pub cross_out_default_dimension(output: pytorch.Tensor, tensor: pytorch.Tensor, other: pytorch.Tensor): Unit.

/// Writes exact aten::cross.out with explicit dimension.

pub cross_out_dimension(output: pytorch.Tensor, tensor: pytorch.Tensor, other: pytorch.Tensor, dimension: Int): Unit.
